---
import InteractiveDemoFrame from './InteractiveDemoFrame.astro';
import DemoControls from './DemoControls.astro';
import '../../styles/scene.css';
---

<InteractiveDemoFrame demoId="shared-boot" ariaLabel="공유 DB와 서비스별 스키마에서 다섯 서비스가 기동하는 순서" title="누가 먼저 떠야 했을까요?" description="다섯 서비스를 동시에 배포해 보세요. 공유 DB에서는 스키마를 만드는 서비스가 하나뿐이라, 나머지는 그 서비스를 기다립니다.">
  <DemoControls ariaLabel="데이터베이스 구성">
    <button type="button" data-boot-mode="shared" aria-pressed="true">공유 DB</button>
    <button type="button" data-boot-mode="split" aria-pressed="false">서비스별 스키마 (PR2 후)</button>
  </DemoControls>
  <div class="scene-chips" role="group" aria-label="기동">
    <button type="button" class="scene-chip is-plain" data-boot-run>▶ 다섯 서비스 동시에 배포</button>
  </div>
  <div class="scene-stage">
    <svg data-boot-svg role="img" aria-label="다섯 서비스 파드와 MySQL 스키마. 공유 DB에서는 Order만 마이그레이션을 실행하고 나머지는 기다립니다."></svg>
  </div>
  <p class="scene-note" data-boot-note role="status"></p>
  <p class="db-demo-disclaimer">순서와 기다림만 보여주는 모형입니다. 막대나 패킷의 시간 길이는 실제 기동 시간을 측정한 값이 아닙니다. 네 임시 구조 중 CI의 Flyway 선적용과 outbox allowlist는 그리지 않았습니다.</p>
</InteractiveDemoFrame>

<script>
  import { bumpText, createScene, duration, ease, setAttrs, svg, watchNarrow, type Point } from '../../scripts/blog/scene/core';
  import { createBoundary, createNode } from '../../scripts/blog/scene/parts';
  import { createPacketLayer } from '../../scripts/blog/scene/packets';
  import { watchDemoPlayback } from '../../scripts/blog/watch-demo-playback';

  type Id = 'user' | 'product' | 'order' | 'payment' | 'notification';
  type Mode = 'shared' | 'split';
  const IDS: Id[] = ['user', 'product', 'order', 'payment', 'notification'];
  const LABELS: Record<Id, string> = { user: 'User', product: 'Product', order: 'Order', payment: 'Payment', notification: 'Notification' };
  const HUES: Record<Id, string> = {
    user: 'var(--scene-hue-blue)', product: 'var(--scene-hue-amber)', order: 'var(--scene-hue-violet)',
    payment: 'var(--scene-hue-cyan)', notification: 'var(--scene-hue-gray)',
  };
  type Rect = { x: number; y: number; w: number; h: number };
  type Layout = { view: [number, number]; node: { w: number; h: number }; pods: Record<Id, Point>; instance: Rect; shared: Rect; split: Record<Id, Rect>; ready: Point; vertical: boolean };
  const LAYOUT: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 336], node: { w: 104, h: 44 }, vertical: true, ready: { x: 280, y: 326 },
      pods: { user: { x: 64, y: 40 }, product: { x: 172, y: 40 }, order: { x: 280, y: 40 }, payment: { x: 388, y: 40 }, notification: { x: 496, y: 40 } },
      instance: { x: 8, y: 102, w: 544, h: 200 },
      shared: { x: 40, y: 140, w: 480, h: 144 },
      split: {
        user: { x: 16, y: 140, w: 96, h: 144 }, product: { x: 124, y: 140, w: 96, h: 144 }, order: { x: 232, y: 140, w: 96, h: 144 },
        payment: { x: 340, y: 140, w: 96, h: 144 }, notification: { x: 448, y: 140, w: 96, h: 144 },
      },
    },
    narrow: {
      view: [360, 352], node: { w: 104, h: 40 }, vertical: false, ready: { x: 180, y: 342 },
      pods: { user: { x: 58, y: 62 }, product: { x: 58, y: 118 }, order: { x: 58, y: 174 }, payment: { x: 58, y: 230 }, notification: { x: 58, y: 286 } },
      instance: { x: 124, y: 8, w: 230, h: 308 },
      shared: { x: 140, y: 44, w: 200, h: 262 },
      split: {
        user: { x: 140, y: 42, w: 200, h: 40 }, product: { x: 140, y: 98, w: 200, h: 40 }, order: { x: 140, y: 154, w: 200, h: 40 },
        payment: { x: 140, y: 210, w: 200, h: 40 }, notification: { x: 140, y: 266, w: 200, h: 40 },
      },
    },
  };
  const NOTES: Record<Mode, { idle: string; done: string }> = {
    shared: {
      idle: '공유 DB에서는 Order만 Flyway를 돌립니다. 나머지 네 서비스는 Flyway를 끄고 스키마를 검증만 하므로, initContainer로 Order를 기다립니다.',
      done: 'Order가 V1부터 V13까지 적용하는 동안 네 서비스는 대기했습니다. 스키마가 준비된 뒤에야 검증을 통과했습니다. 기동 순서에 서비스 간 의존이 남아 있었습니다.',
    },
    split: {
      idle: '스키마를 나눈 뒤에는 서비스마다 자기 스키마에 자기 V1 베이스라인을 적용합니다.',
      done: '다섯 서비스가 서로를 기다리지 않고 각자 스키마를 만들었습니다. 대기 initContainer는 제거됐습니다.',
    },
  };

  document.querySelectorAll<HTMLElement>('[data-blog-demo="shared-boot"]').forEach((demo) => {
    const root = demo.querySelector<SVGSVGElement>('[data-boot-svg]')!;
    const note = demo.querySelector<HTMLElement>('[data-boot-note]')!;
    const modeButtons = [...demo.querySelectorAll<HTMLButtonElement>('[data-boot-mode]')];
    const runButton = demo.querySelector<HTMLButtonElement>('[data-boot-run]')!;
    let narrow = false;
    let mode: Mode = 'shared';
    const L = () => (narrow ? LAYOUT.narrow : LAYOUT.wide);

    const instance = createBoundary(root, 'MySQL 인스턴스 1개');
    // 스키마 상자 다섯 개. 공유 DB에서는 다섯 개가 한 자리에 겹쳐 하나로 보이고, 분리하면 갈라집니다.
    const schemas = Object.fromEntries(IDS.map((id) => [id, createBoundary(root, '', 'zone')])) as Record<Id, ReturnType<typeof createBoundary>>;
    const historyLabel = svg('text', { class: 'scene-label scene-label-dep', 'text-anchor': 'middle' }, root);
    historyLabel.textContent = 'flyway_schema_history';
    const counters = Object.fromEntries(IDS.map((id) => {
      const t = svg('text', { class: 'scene-gauge-value', 'text-anchor': 'middle' }, root);
      t.textContent = '—';
      return [id, t];
    })) as Record<Id, SVGTextElement>;
    const names = Object.fromEntries(IDS.map((id) => {
      const t = svg('text', { class: 'scene-label scene-label-dep' }, root);
      const prefix = svg('tspan', {}, t);
      prefix.textContent = 'peekcart_';
      const suffix = svg('tspan', {}, t);
      suffix.textContent = id;
      suffix.style.fill = 'var(--ink)';
      return [id, { t, prefix, suffix }];
    })) as Record<Id, { t: SVGTextElement; prefix: SVGTSpanElement; suffix: SVGTSpanElement }>;
    const pods = Object.fromEntries(IDS.map((id) => [id, createNode(root, { label: LABELS[id], hue: HUES[id] })])) as Record<Id, ReturnType<typeof createNode>>;
    const ready = svg('text', { class: 'scene-label is-sans', 'text-anchor': 'middle' }, root);
    ready.style.fontSize = '12.5px';
    const packets = createPacketLayer(root);

    const scene = createScene<{ split: number }>({ split: 0 }, ({ split }) => {
      const l = L();
      instance.place({ ...l.instance }, { x: l.instance.x + 12, y: l.instance.y + 20 });
      IDS.forEach((id) => {
        const a = l.shared;
        const b = l.split[id];
        const r = { x: a.x + (b.x - a.x) * split, y: a.y + (b.y - a.y) * split, w: a.w + (b.w - a.w) * split, h: a.h + (b.h - a.h) * split };
        // 겹쳐 있을 때는 Order 상자 하나만 보이게
        schemas[id].place({ ...r, o: id === 'order' ? 1 : split }, { x: r.x + 12, y: r.y + 22 });
        schemas[id].caption.textContent = split < 0.5 ? (id === 'order' ? 'peekcart (공유 스키마)' : '') : '';
        const c = { x: r.x + r.w / 2, y: r.y + r.h / 2 };
        const name = names[id];
        name.t.style.opacity = String(split);
        if (l.vertical) {
          setAttrs(counters[id], { x: c.x, y: c.y + 14 });
          setAttrs(name.t, { x: c.x, y: r.y + 24, 'text-anchor': 'middle' });
          setAttrs(name.prefix, { x: c.x, dy: 0 });
          setAttrs(name.suffix, { x: c.x, dy: 14 });
        } else {
          setAttrs(counters[id], { x: split < 0.5 ? c.x : r.x + r.w - 24, y: c.y + 5 });
          setAttrs(name.t, { x: r.x + 12, y: c.y + 4, 'text-anchor': 'start' });
          name.prefix.removeAttribute('x');
          name.suffix.removeAttribute('x');
          setAttrs(name.prefix, { dy: 0 });
          setAttrs(name.suffix, { dy: 0 });
        }
        counters[id].style.opacity = String(id === 'order' ? 1 : split);
        counters[id].style.fontSize = split < 0.5 ? '26px' : '15px';
        pods[id].setBox({ ...l.pods[id], ...l.node });
      });
      const s = l.shared;
      setAttrs(historyLabel, { x: s.x + s.w / 2, y: s.y + s.h / 2 - (l.vertical ? 18 : 30), opacity: 1 - split });
      setAttrs(ready, l.ready);
    });

    const podEdge = (id: Id): Point => {
      const l = L();
      const p = l.pods[id];
      return l.vertical ? { x: p.x, y: p.y + l.node.h / 2 + 4 } : { x: p.x + l.node.w / 2 + 6, y: p.y };
    };
    const schemaDoor = (id: Id): Point => {
      const l = L();
      const r = mode === 'shared' ? l.shared : l.split[id];
      if (l.vertical) return { x: mode === 'shared' ? r.x + r.w / 2 + (IDS.indexOf(id) - 2) * 26 : r.x + r.w / 2, y: r.y + 34 };
      return { x: r.x + 44, y: mode === 'shared' ? r.y + r.h / 2 + (IDS.indexOf(id) - 2) * 24 : r.y + r.h / 2 };
    };

    let readyCount = 0;
    const setReady = (n: number) => {
      readyCount = n;
      bumpText(ready, `Ready ${n} / 5`);
      ready.style.fill = n === 5 ? 'var(--scene-flow-ink)' : 'var(--slate)';
    };
    const resetPods = () => {
      IDS.forEach((id) => {
        pods[id].flash('is-waiting', false);
        pods[id].flash('is-done', false);
        pods[id].flash('is-temp', false);
        pods[id].setSub('Pending');
        counters[id].textContent = 'V0';
      });
      setReady(0);
    };

    const markReady = (id: Id) => {
      pods[id].flash('is-waiting', false);
      pods[id].flash('is-temp', false);
      pods[id].setSub('Ready ✓');
      pods[id].flash('is-done');
      pods[id].flash('is-ok');
      setReady(readyCount + 1);
    };

    let run = 0;
    const boot = async () => {
      const id = ++run;
      const alive = () => id === run;
      packets.clear();
      resetPods();
      note.textContent = NOTES[mode].idle;
      await scene.pause(duration.beat);
      if (!alive()) return;

      if (mode === 'split') {
        IDS.forEach((pid) => pods[pid].setSub('Flyway V1'));
        await Promise.all(IDS.map(async (pid, i) => {
          await scene.pause(i * 60);
          if (!alive()) return;
          const p = packets.spawn({ label: 'V1', tone: 'flow', at: podEdge(pid) });
          if (!(await p.travel([schemaDoor(pid)], 640, ease.standard)) || !alive()) return;
          bumpText(counters[pid], 'V1');
          void p.fade(260);
          markReady(pid);
        }));
        if (alive()) note.textContent = NOTES.split.done;
        return;
      }

      // 공유 DB: Order만 마이그레이션, 나머지는 initContainer에서 대기
      pods.order.setSub('Flyway V1…');
      IDS.filter((pid) => pid !== 'order').forEach((pid) => {
        pods[pid].setSub('init: 대기');
        pods[pid].flash('is-waiting');
        pods[pid].flash('is-temp');
      });
      const flights: Promise<unknown>[] = [];
      for (let v = 1; v <= 13; v += 1) {
        if (!alive()) return;
        const p = packets.spawn({ label: `V${v}`, tone: 'flow', at: podEdge('order') });
        flights.push(p.travel([schemaDoor('order')], 520, ease.standard).then((ok) => {
          if (!ok || !alive()) return;
          bumpText(counters.order, `V${v}`);
          pods.order.setSub(v < 13 ? `Flyway V${v + 1}…` : 'Flyway 완료');
          return p.fade(200);
        }));
        await scene.pause(230);
      }
      await Promise.all(flights);
      if (!alive()) return;
      markReady('order');
      await scene.pause(duration.beat);
      if (!alive()) return;
      // 스키마가 생긴 뒤에야 나머지가 검증
      await Promise.all(IDS.filter((pid) => pid !== 'order').map(async (pid, i) => {
        await scene.pause(i * 120);
        if (!alive()) return;
        pods[pid].flash('is-waiting', false);
        pods[pid].setSub('검증 중');
        const p = packets.spawn({ label: '검증', tone: 'dep', at: podEdge(pid) });
        if (!(await p.travel([schemaDoor(pid)], 560, ease.standard)) || !alive()) return;
        void p.fade(200);
        markReady(pid);
      }));
      if (alive()) note.textContent = NOTES.shared.done;
    };

    const setMode = async (next: Mode) => {
      if (next === mode) return;
      mode = next;
      run += 1;
      packets.clear();
      modeButtons.forEach((b) => { b.setAttribute('aria-pressed', String(b.dataset.bootMode === mode)); b.removeAttribute('data-state'); });
      resetPods();
      note.textContent = NOTES[mode].idle;
      // 경계가 바뀌었다: 한 상자가 다섯으로 갈라지거나 다시 합쳐짐
      await scene.go({ split: mode === 'split' ? 1 : 0 }, duration.draw);
      runButton.setAttribute('data-state', 'next');
    };

    modeButtons.forEach((b) => b.addEventListener('click', () => { void setMode(b.dataset.bootMode as Mode); }));
    runButton.addEventListener('click', () => {
      runButton.removeAttribute('data-state');
      void boot().then(() => {
        if (mode === 'shared') modeButtons[1].setAttribute('data-state', 'next');
      });
    });

    watchNarrow(demo, (isNarrow) => {
      narrow = isNarrow;
      run += 1;
      packets.clear();
      const [w, h] = L().view;
      setAttrs(root, { viewBox: `0 0 ${w} ${h}` });
      scene.redraw();
    });
    resetPods();
    note.textContent = NOTES.shared.idle;

    let played = false;
    watchDemoPlayback(demo, ({ shouldPlay }) => {
      if (played || !shouldPlay) return;
      played = true;
      window.setTimeout(() => { if (readyCount === 0 && mode === 'shared') runButton.click(); }, 400);
    }, { threshold: 0.5 });
  });
</script>

<style>
  [data-blog-demo="shared-boot"] .scene-chips { margin-top: 12px; }
</style>
