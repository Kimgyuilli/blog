---
import AutoMotionFigure from './AutoMotionFigure.astro';
---

<AutoMotionFigure className="db-transaction-motion" ariaLabel="트랜잭션 커밋과 롤백의 결과 비교" title="같은 시작, 다른 결과: 커밋과 롤백" caption="커밋하면 두 변경이 함께 반영됩니다. 롤백하면 앞서 성공한 고객 추가까지 취소됩니다.">
  <p class="db-tx-start">시작 상태 · 고객 3명 / 주문 3건</p>
  <div class="db-tx-lanes">
    <div class="db-tx-lane db-tx-commit">
      <span class="db-tx-label">두 문장 모두 성공</span>
      <div class="db-tx-steps">
        <span>BEGIN</span><span>고객 4 추가</span><span>주문 104 추가</span><span>COMMIT ✓</span>
      </div>
      <div class="db-tx-changes" aria-hidden="true">
        <span class="db-tx-change db-tx-customer">고객 4</span>
        <span class="db-tx-change db-tx-order">주문 104</span>
      </div>
      <span class="db-tx-effect">두 변경 모두 반영</span>
      <strong class="db-tx-outcome">고객 4명 / 주문 4건</strong>
    </div>
    <div class="db-tx-lane db-tx-rollback">
      <span class="db-tx-label">두 번째 문장 실패</span>
      <div class="db-tx-steps">
        <span>BEGIN</span><span>고객 4 추가</span><span class="db-tx-failure">주문 104 추가 <b>✕ 실패</b></span><span>ROLLBACK ↶</span>
      </div>
      <div class="db-tx-changes" aria-hidden="true">
        <span class="db-tx-change db-tx-customer db-tx-reverted">고객 4</span>
      </div>
      <span class="db-tx-effect">앞선 고객 추가도 취소</span>
      <strong class="db-tx-outcome">고객 3명 / 주문 3건</strong>
    </div>
  </div>
</AutoMotionFigure>
