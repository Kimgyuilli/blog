    transition: transform 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }
  .rollout-card:hover { transform: translateY(-2px); border-color: var(--scene-flow); }
  .rollout-card:focus-visible { outline: 3px solid var(--scene-flow); outline-offset: 2px; }
  .rollout-card-order { font-size: 0.8rem; font-weight: 750; white-space: nowrap; }
  .rollout-card-result { color: var(--muted); font-size: 0.7rem; font-weight: 700; }
  .rollout-card[data-result] { border-style: solid; }
  .rollout-card[data-result="safe"] { border-color: var(--scene-flow); background: var(--scene-flow-soft); }
  .rollout-card[data-result="safe"] .rollout-card-result { color: var(--scene-flow-ink); }
