---
import InteractiveDemoFrame from './InteractiveDemoFrame.astro';
import '../../styles/scene.css';

const steps = [
  { id: 'close', label: '입구 닫기', short: '닫기' },
  { id: 'trust', label: '헤더 믿기', short: '믿기' },
  { id: 'strip', label: '토큰 빼기', short: '빼기' },
];
const permute = (items: string[]): string[][] => items.length <= 1 ? [items] : items.flatMap((item, i) => permute([...items.slice(0, i), ...items.slice(i + 1)]).map((rest) => [item, ...rest]));
const orders = permute(steps.map((step) => step.id));
const shortOf = Object.fromEntries(steps.map((step) => [step.id, step.short]));
---

<InteractiveDemoFrame demoId="gateway-rollout" ariaLabel="입구 차단, 헤더 신뢰, 토큰 전달 중단의 배포 순서를 직접 정해 보는 실험" title="세 가지 변경, 어떤 순서로 배포할까요?" description="세 변경을 원하는 순서대로 눌러 보세요. 하나를 배포할 때마다 정상 요청과 위조 요청이 한 번씩 지나갑니다. 여섯 가지 순서 중 중간에 아무것도 깨지지 않는 순서는 하나뿐입니다.">
  <div class="scene-chips" role="group" aria-label="배포할 변경">
    <span class="scene-chips-label">배포하기</span>
    {steps.map((step) => (
      <button type="button" class="scene-chip is-plain" data-rollout-step={step.id}><span class="rollout-seq" aria-hidden="true"></span>{step.label}</button>
    ))}
    <span class="scene-chips-sep" aria-hidden="true">·</span>
    <button type="button" class="scene-chip is-plain" data-rollout-back disabled>↩ 역순으로 되돌리기</button>
    <button type="button" class="scene-chip is-plain" data-rollout-reset>처음 상태로</button>
  </div>
  <div class="scene-stage">
    <svg data-rollout-svg role="img" aria-label="사용자의 정상 요청은 게이트웨이를 거쳐 Order 서비스로, 공격자의 위조 헤더 요청은 NodePort로 Order에 직접 들어가는 그림"></svg>
  </div>
  <p class="scene-note" data-rollout-note role="status"></p>
  <div class="rollout-orders" role="group" aria-label="여섯 가지 순서를 한 번에 재생">
    <span class="scene-chips-label">여섯 가지 순서</span>
    <div class="rollout-grid">
      {orders.map((order) => (
        <button type="button" class="rollout-card" data-rollout-order={order.join(',')}>
          <span class="rollout-card-order">{order.map((id) => shortOf[id]).join(' → ')}</span>
          <small class="rollout-card-result">아직 안 해 봄</small>
        </button>
      ))}
    </div>
  </div>
  <p class="db-demo-disclaimer">서비스 하나(Order)와 요청 두 개로 줄인 모형입니다. 출발 상태는 글의 ‘검증 병행’으로, 게이트웨이가 검증한 뒤 Authorization도 함께 넘깁니다. ‘토큰 빼기’는 글에서 아직 실행하지 않은 계획 단계이고, 옛 검증기 제거와 함께 묶여 있습니다. 입구를 닫으면 NetworkPolicy가 실제로 강제된다고 가정했고, Prometheus 허용 경로와 옛·새 Pod가 섞이는 과정은 그리지 않았습니다. 200·401 같은 결과는 설명용 판정입니다.</p>
</InteractiveDemoFrame>

<script>
  import { createScene, duration, ease, setAttrs, svg, watchNarrow, type Point } from '../../scripts/blog/scene/core';
  import { createArrow, createBoundary, createNode, createPill, createWall } from '../../scripts/blog/scene/parts';
  import { createPacketLayer } from '../../scripts/blog/scene/packets';
  import { watchDemoPlayback } from '../../scripts/blog/watch-demo-playback';

  // 독자가 볼 변화: 입구를 닫기 전에 헤더를 믿으면 위조가 통과하고, 헤더를 믿기 전에 토큰을 빼면 정상 요청이 401이 된다.
  // 그래서 닫기 → 믿기 → 빼기만 끝까지 안전하고, 되돌릴 때는 그 역순이어야 한다.
  type Step = 'close' | 'trust' | 'strip';
  type State = { close: number; closeCut: number; trust: number; strip: number; stripCut: number };
  type Outcome = { normalOk: boolean; attackBlocked: boolean };
  type Layout = {
    view: [number, number];
    user: Point; attacker: Point; gateway: Point; service: Point;
    source: { w: number; h: number }; gatewaySize: { w: number; h: number };
    boundary: { x: number; y: number; w: number; h: number }; boundaryCaption: string;
    normalRoute: Point[]; attackLane: number; door: { x: number; y1: number; y2: number }; wallCaption: Point;
    authPill: Point; portPill: Point; portLabel: string;
    normalVerdict: Point; attackVerdict: Point;
  };

  const LAYOUT: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 300],
      user: { x: 64, y: 64 }, attacker: { x: 64, y: 236 }, gateway: { x: 222, y: 64 }, service: { x: 452, y: 150 },
      source: { w: 104, h: 48 }, gatewaySize: { w: 124, h: 52 },
      boundary: { x: 334, y: 18, w: 214, h: 264 }, boundaryCaption: 'order-service',
      normalRoute: [{ x: 284, y: 64 }, { x: 452, y: 64 }, { x: 452, y: 122 }],
      attackLane: 236, door: { x: 334, y1: 212, y2: 260 }, wallCaption: { x: 392, y: 274 },
      authPill: { x: 222, y: 110 }, portPill: { x: 226, y: 236 }, portLabel: 'NodePort 30081',
      normalVerdict: { x: 64, y: 108 }, attackVerdict: { x: 64, y: 280 },
    },
    narrow: {
      view: [360, 410],
      user: { x: 56, y: 46 }, attacker: { x: 56, y: 340 }, gateway: { x: 264, y: 46 }, service: { x: 264, y: 236 },
      source: { w: 92, h: 46 }, gatewaySize: { w: 128, h: 50 },
      boundary: { x: 176, y: 106, w: 176, h: 292 }, boundaryCaption: '',
      normalRoute: [{ x: 264, y: 71 }, { x: 264, y: 208 }],
      attackLane: 340, door: { x: 176, y1: 318, y2: 362 }, wallCaption: { x: 264, y: 386 },
      authPill: { x: 264, y: 89 }, portPill: { x: 139, y: 340 }, portLabel: 'NodePort',
      normalVerdict: { x: 56, y: 88 }, attackVerdict: { x: 56, y: 382 },
    },
  };

  const BASE: State = { close: 0, closeCut: 0, trust: 0, strip: 0, stripCut: 0 };
  const STEP_NOTE: Record<Step, [string, string]> = {
    close: ['<strong>입구 닫기</strong> — Service를 ClusterIP로 바꾸고 NetworkPolicy로 게이트웨이만 들여보냅니다.', '<strong>입구 다시 열기</strong> — 우회 경로 설정을 복구합니다.'],
    trust: ['<strong>헤더 믿기</strong> — Order를 X-User-*를 읽는 새 이미지로 바꿉니다.', '<strong>옛 이미지로</strong> — Order가 다시 Bearer 토큰을 검증합니다.'],
    strip: ['<strong>토큰 빼기</strong> — 게이트웨이가 Authorization을 더는 넘기지 않습니다.', '<strong>토큰 전달 복구</strong> — 게이트웨이가 Authorization을 다시 넘깁니다.'],
  };
  const SHORT: Record<Step, string> = { close: '닫기', trust: '믿기', strip: '빼기' };

  const verdictOf = ({ close, trust, strip }: Record<Step, boolean>): Outcome => ({
    normalOk: trust || !strip,
    attackBlocked: close || !trust,
  });

  document.querySelectorAll<HTMLElement>('[data-blog-demo="gateway-rollout"]').forEach((demo) => {
    if (demo.dataset.ready) return;
    demo.dataset.ready = 'true';
    const root = demo.querySelector<SVGSVGElement>('[data-rollout-svg]')!;
    const stage = demo.querySelector<HTMLElement>('.scene-stage')!;
    const note = demo.querySelector<HTMLElement>('[data-rollout-note]')!;
    const stepButtons = [...demo.querySelectorAll<HTMLButtonElement>('[data-rollout-step]')];
    const backButton = demo.querySelector<HTMLButtonElement>('[data-rollout-back]')!;
    const resetButton = demo.querySelector<HTMLButtonElement>('[data-rollout-reset]')!;
    const cards = [...demo.querySelectorAll<HTMLButtonElement>('[data-rollout-order]')];
    let narrow = false;
    const L = () => (narrow ? LAYOUT.narrow : LAYOUT.wide);

    // ── 바탕: 경계, 길, 노드 ──────────────────────────────
    const boundary = createBoundary(root, 'order-service');
    const line = (colour = 'var(--scene-dep)') => {
      const path = svg('path', { class: 'scene-line' }, root);
      path.style.stroke = colour;
      path.style.strokeWidth = '2';
      return path;
    };
    const userLine = line();
    const userArrow = createArrow(root, 'var(--scene-dep)');
    const normalLine = line();
    const normalArrow = createArrow(root, 'var(--scene-dep)');
    const attackOuter = line('var(--scene-danger)');
    const attackInner = line('var(--scene-danger)');
    const attackArrow = createArrow(root, 'var(--scene-danger)');
    const wall = createWall(root, 'NetworkPolicy');
    const portPill = createPill(root, 'NodePort 30081');
    const portPillNarrow = createPill(root, 'NodePort');
    const authPill = createPill(root, 'Authorization 전달');

    const user = createNode(root, { label: '사용자', hue: 'var(--scene-hue-gray)', sub: '정상 요청' });
    const attacker = createNode(root, { label: '공격자', hue: 'var(--scene-hue-gray)', sub: '위조 헤더' });
    const gateway = createNode(root, { label: '게이트웨이', hue: 'var(--scene-hue-pink)', sub: 'JWT 검증' });
    const service = createNode(root, { label: 'Order', hue: 'var(--scene-hue-violet)', sub: 'Bearer 검증' });
    const verdict = () => svg('text', { class: 'scene-label is-sans', 'text-anchor': 'middle' }, root);
    const normalVerdict = verdict();
    const attackVerdict = verdict();
    const packets = createPacketLayer(root);

    let readsHeader = false;
    const scene = createScene<State>({ ...BASE }, (state) => {
      const l = L();
      setAttrs(root, { viewBox: `0 0 ${l.view[0]} ${l.view[1]}` });
      boundary.place(l.boundary);
      boundary.caption.textContent = l.boundaryCaption;

      user.setBox({ ...l.user, ...l.source });
      attacker.setBox({ ...l.attacker, ...l.source });
      gateway.setBox({ ...l.gateway, ...l.gatewaySize });
      service.setBox({ ...l.service, w: 136, h: 56 });
      const nextReads = state.trust > 0.5;
      if (nextReads !== readsHeader) {
        readsHeader = nextReads;
        service.setSub(readsHeader ? 'X-User 신뢰' : 'Bearer 검증');
        service.flash('is-ok');
      }

      const userEnd = { x: l.gateway.x - l.gatewaySize.w / 2 - 4, y: l.user.y };
      setAttrs(userLine, { d: `M ${l.user.x + l.source.w / 2 + 4} ${l.user.y} L ${userEnd.x} ${userEnd.y}` });
      userArrow(userEnd, 0);
      const normalEnd = l.normalRoute[l.normalRoute.length - 1];
      setAttrs(normalLine, { d: `M ${l.normalRoute.map((p) => `${p.x} ${p.y}`).join(' L ')}` });
      normalArrow(normalEnd, 90);

      const lane = l.attackLane;
      const startX = l.attacker.x + l.source.w / 2 + 4;
      const attackEnd = { x: l.service.x, y: l.service.y + 34 };
      setAttrs(attackOuter, { d: `M ${startX} ${lane} L ${l.door.x} ${lane}` });
      setAttrs(attackInner, { d: `M ${l.door.x} ${lane} L ${l.service.x} ${lane} L ${attackEnd.x} ${attackEnd.y}` });
      attackInner.style.opacity = String(1 - 0.78 * state.close);
      attackArrow(attackEnd, -90);
      attackArrow.element.style.opacity = String(1 - 0.78 * state.close);
      wall.place(l.door, { show: state.close, ghost: 0 }, l.wallCaption);

      const wide = !narrow;
      portPill.place(l.portPill, state.closeCut);
      portPillNarrow.place(l.portPill, state.closeCut);
      portPill.group.style.opacity = wide ? String(1 - 0.5 * state.close) : '0';
      portPillNarrow.group.style.opacity = wide ? '0' : String(1 - 0.5 * state.close);
      authPill.place(l.authPill, state.stripCut);
      authPill.group.style.opacity = String(1 - 0.55 * state.strip);

      setAttrs(normalVerdict, l.normalVerdict);
      setAttrs(attackVerdict, l.attackVerdict);
    });

    // ── 결과 표시 ─────────────────────────────────────────
    const setVerdict = (text: SVGTextElement, value: string, tone: 'flow' | 'danger' | 'clear') => {
      text.textContent = value;
      text.style.fill = tone === 'flow' ? 'var(--scene-flow-ink)' : tone === 'danger' ? 'var(--scene-danger)' : 'transparent';
    };
    const clearResults = () => {
      packets.clear();
      setVerdict(normalVerdict, '', 'clear');
      setVerdict(attackVerdict, '', 'clear');
      service.flash('is-error', false);
      service.flash('is-done', false);
    };
    const setNote = (html: string, alert = false) => {
      note.innerHTML = html;
      note.classList.toggle('is-alert', alert);
    };

    // ── 두 요청 보내기 ────────────────────────────────────
    const applied: Record<Step, boolean> = { close: false, trust: false, strip: false };

    async function sendNormal(alive: () => boolean, outcome: Outcome) {
      const l = L();
      const p = packets.spawn({ label: 'Bearer', at: { x: l.user.x + l.source.w / 2, y: l.user.y } });
      if (!(await p.travel([l.gateway], 640)) || !alive()) return;
      p.relabel(applied.strip ? 'X-User' : 'Bearer + X-User', 'flow');
      await scene.pause(duration.beat / 2);
      if (!alive()) return;
      const last = l.normalRoute[l.normalRoute.length - 1];
      if (!(await p.travel(l.normalRoute, 900, ease.linear)) || !alive()) return;
      if (outcome.normalOk) {
        if (!(await p.travel([{ x: last.x, y: last.y + 6 }], 340, ease.out)) || !alive()) return;
        await p.land(false);
        service.flash('is-done');
        setVerdict(normalVerdict, '✓ 200', 'flow');
      } else {
        if (!(await p.bounce({ x: last.x, y: last.y + 4 }, 26)) || !alive()) return;
        service.flash('is-error');
        service.flash('is-shaking');
        setVerdict(normalVerdict, '✕ 401 · 토큰 없음', 'danger');
        await p.fade(600);
      }
    }

    async function sendAttack(alive: () => boolean, outcome: Outcome) {
      const l = L();
      await scene.pause(260);
      if (!alive()) return;
      const lane = l.attackLane;
      const p = packets.spawn({ label: 'X-User-Id: 1', tone: 'danger', at: { x: l.attacker.x + l.source.w / 2, y: lane } });
      if (applied.close) {
        if (!(await p.bounce({ x: l.door.x - 8, y: lane }, 30)) || !alive()) return;
        setVerdict(attackVerdict, '✓ 입구에서 차단', 'flow');
        await p.fade(600);
        return;
      }
      if (!(await p.travel([{ x: l.service.x, y: lane }], 900, ease.linear)) || !alive()) return;
      if (outcome.attackBlocked) {
        if (!(await p.bounce({ x: l.service.x, y: l.service.y + 34 }, 26)) || !alive()) return;
        setVerdict(attackVerdict, '✓ 401 · 토큰 없음', 'flow');
        await p.fade(600);
      } else {
        if (!(await p.travel([{ x: l.service.x, y: l.service.y + 44 }], 360, ease.out)) || !alive()) return;
        await p.land(true);
        service.flash('is-error');
        service.flash('is-shaking');
        setVerdict(attackVerdict, '✕ user 1로 인증됨', 'danger');
      }
    }

    async function sendBoth(alive: () => boolean) {
      clearResults();
      const outcome = verdictOf(applied);
      await Promise.all([sendNormal(alive, outcome), sendAttack(alive, outcome)]);
      return outcome;
    }

    // ── 한 변경 적용·되돌리기 ─────────────────────────────
    const targetState = (): State => ({
      close: Number(applied.close), closeCut: Number(applied.close),
      trust: Number(applied.trust),
      strip: Number(applied.strip), stripCut: Number(applied.strip),
    });

    async function change(step: Step, on: boolean, alive: () => boolean) {
      applied[step] = on;
      clearResults();
      const cutKey = step === 'close' ? 'closeCut' : step === 'strip' ? 'stripCut' : undefined;
      const s = scene.state;
      if (on && cutKey) {
        // 끊어 냈다: 이름에 취소선을 먼저 긋고, 그다음 상태가 바뀝니다.
        await scene.go({ ...s, [cutKey]: 1 }, duration.cut);
        if (!alive()) return undefined;
        await scene.go(targetState(), duration.draw);
      } else if (!on && cutKey) {
        await scene.go({ ...targetState(), [cutKey]: 1 }, duration.draw);
        if (!alive()) return undefined;
        await scene.go(targetState(), duration.cut);
      } else {
        await scene.go(targetState(), duration.draw);
      }
      if (!alive()) return undefined;
      return sendBoth(alive);
    }

    const describe = (outcome: Outcome) => {
      const problems: string[] = [];
      if (!outcome.normalOk) problems.push('Order는 아직 Bearer만 읽는데 게이트웨이가 토큰을 뺐습니다. <strong>정상 사용자가 401</strong>을 받습니다.');
      if (!outcome.attackBlocked) problems.push('입구가 열린 채 Order가 헤더를 믿습니다. 공격자가 붙인 <strong>X-User-Id: 1이 그대로 인증</strong>됩니다.');
      return problems.length ? problems.join(' ') : '두 요청 모두 의도대로 처리됩니다.';
    };

    // ── 순서 기록 ────────────────────────────────────────
    type Entry = { step: Step; ok: boolean; why: string; shown: boolean };
    let sequence: Entry[] = [];
    let rolledBack = false;
    const whyOf = (outcome: Outcome) => [!outcome.normalOk && '401', !outcome.attackBlocked && '위조 통과'].filter(Boolean).join('·');
    const resultOf = (seq: Entry[]) => {
      const broken = seq.map((entry, i) => (entry.ok ? '' : `${i + 1}단계 ${entry.why}`)).filter(Boolean);
      return broken.length ? broken.join(', ') : '끝까지 안전';
    };

    const markChips = () => {
      stepButtons.forEach((button) => {
        const step = button.dataset.rolloutStep as Step;
        const index = sequence.findIndex((entry) => entry.step === step);
        const seq = button.querySelector<HTMLElement>('.rollout-seq')!;
        seq.textContent = index >= 0 ? `${index + 1}` : '';
        button.disabled = index >= 0 || rolledBack;
        if (index < 0 || !sequence[index].shown) button.removeAttribute('data-state');
        else button.dataset.state = sequence[index].ok ? 'ok' : 'fail';
      });
      backButton.disabled = sequence.length < 3 || rolledBack;
      if (sequence.length === 3 && !rolledBack) backButton.dataset.state = 'next';
      else backButton.removeAttribute('data-state');
    };
    const markCard = (order: Step[], text: string, safe: boolean) => {
      const card = cards.find((c) => c.dataset.rolloutOrder === order.join(','));
      if (!card) return;
      card.dataset.result = safe ? 'safe' : 'broken';
      card.querySelector('small')!.textContent = `${safe ? '✓' : '✕'} ${text}`;
    };
    const markPlaying = (order: Step[] | null) => {
      cards.forEach((card) => card.setAttribute('aria-current', String(order !== null && card.dataset.rolloutOrder === order.join(','))));
    };

    const revealCard = () => {
      if (sequence.length !== 3) return;
      markCard(sequence.map((entry) => entry.step), resultOf(sequence), sequence.every((entry) => entry.ok));
    };
    /** 앞 단계가 연출 도중에 끊겼어도 순서와 결과는 남깁니다. 결과는 계산으로 정해지므로 연출만 건너뜁니다. */
    const finishPending = () => {
      sequence.forEach((entry) => { entry.shown = true; });
      revealCard();
      markChips();
    };

    async function deploy(step: Step, alive: () => boolean) {
      finishPending();
      applied[step] = true;
      const outcome = verdictOf(applied);
      const ok = outcome.normalOk && outcome.attackBlocked;
      const entry: Entry = { step, ok, why: whyOf(outcome), shown: false };
      sequence.push(entry);
      markChips();
      const n = sequence.length;
      setNote(`<strong>${n}단계</strong> · ${STEP_NOTE[step][0]}`);
      if (!(await change(step, true, alive)) || !alive()) return false;
      entry.shown = true;
      markChips();
      let html = `<strong>${n}단계</strong> · ${STEP_NOTE[step][0]} ${describe(outcome)}`;
      if (n === 3) {
        const safe = sequence.every((e) => e.ok);
        revealCard();
        html += safe
          ? ' <br>이 순서는 <strong>끝까지 한 번도 깨지지 않았습니다.</strong> 역순으로 되돌려도 그런지 확인해 보세요.'
          : ` <br>마지막 상태는 안전하지만, 가는 길에 사고가 났습니다: <strong>${resultOf(sequence)}</strong>.`;
      }
      setNote(html, !ok);
      return true;
    }

    async function rollback(alive: () => boolean) {
      finishPending();
      rolledBack = true;
      markChips();
      const order = [...sequence].reverse();
      let broken = 0;
      for (const [i, entry] of order.entries()) {
        const outcome = await change(entry.step, false, alive);
        if (!outcome || !alive()) return;
        const ok = outcome.normalOk && outcome.attackBlocked;
        if (!ok) broken += 1;
        const seq = stepButtons.find((b) => b.dataset.rolloutStep === entry.step)!;
        seq.dataset.state = ok ? 'ok' : 'fail';
        seq.querySelector<HTMLElement>('.rollout-seq')!.textContent = '↩';
        setNote(`<strong>되돌리기 ${i + 1}</strong> · ${STEP_NOTE[entry.step][1]} ${describe(outcome)}`, !ok);
        await scene.pause(duration.read);
        if (!alive()) return;
      }
      setNote(broken
        ? `되돌리는 길에서도 <strong>${broken}번</strong> 깨졌습니다. 앞으로 갈 때 안전하지 않던 순서는 거꾸로 가도 같은 틈을 지납니다.`
        : '역순으로 되돌리는 동안에도 <strong>한 번도 깨지지 않았습니다.</strong> 앞으로 안전한 순서는 거꾸로도 안전합니다. 다른 순서도 시험해 보세요.', broken > 0);
      sequence = [];
      rolledBack = false;
      markChips();
    }

    function resetAll() {
      scene.begin();
      (Object.keys(applied) as Step[]).forEach((step) => { applied[step] = false; });
      sequence = [];
      rolledBack = false;
      clearResults();
      scene.set({ ...BASE });
      markChips();
      markPlaying(null);
      setNote('출발점은 <strong>검증 병행</strong> 상태입니다. 게이트웨이가 검증하고 Authorization도 그대로 넘기며, Order는 아직 Bearer를 검증합니다. 공격자는 NodePort로 Order에 직접 <code>X-User-Id: 1</code>을 보냅니다. 먼저 배포할 변경을 고르세요.');
    }

    async function playOrder(order: Step[]) {
      resetAll();
      const alive = scene.begin();
      markPlaying(order);
      stepButtons.forEach((button) => { button.disabled = true; });
      for (const step of order) {
        await scene.pause(duration.beat);
        if (!alive()) return;
        if (!(await deploy(step, alive))) return;
        await scene.pause(duration.read);
        if (!alive()) return;
      }
      markPlaying(null);
    }

    // ── 조작 ─────────────────────────────────────────────
    let touched = false;
    stepButtons.forEach((button) => button.addEventListener('click', () => {
      touched = true;
      if (rolledBack) resetAll();
      markPlaying(null);
      const alive = scene.begin();
      void deploy(button.dataset.rolloutStep as Step, alive);
    }));
    backButton.addEventListener('click', () => {
      touched = true;
      void rollback(scene.begin());
    });
    resetButton.addEventListener('click', () => {
      touched = true;
      resetAll();
      void sendBoth(scene.begin());
    });
    cards.forEach((card) => card.addEventListener('click', () => {
      touched = true;
      void playOrder(card.dataset.rolloutOrder!.split(',') as Step[]);
    }));

    watchNarrow(stage, (value) => {
      narrow = value;
      clearResults();
      scene.redraw();
    });
    resetAll();

    // 처음 화면에 들어오면 출발 상태로 두 요청을 한 번 보내 봅니다.
    let played = false;
    watchDemoPlayback(demo, ({ shouldPlay }) => {
      if (!shouldPlay || played || touched) return;
      played = true;
      window.setTimeout(() => { if (!touched) void sendBoth(scene.begin()); }, 400);
    }, { threshold: 0.45 });
  });
</script>

