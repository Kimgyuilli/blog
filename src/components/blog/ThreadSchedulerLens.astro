---
import InteractiveDemoFrame from './InteractiveDemoFrame.astro';
import DemoControls from './DemoControls.astro';
import '../../styles/scene.css';
---

<InteractiveDemoFrame demoId="thread-scheduler-lens" ariaLabel="런타임의 작업 전환과 커널의 스레드 전환 비교" title="둘 다 번갈아 실행하는데, 무엇이 움직일까요?" description="CPU0 하나를 OS 스레드 T1·T2가 나눠 쓰고, T1 위에는 VT A·B가 번갈아 올라갑니다. 두 전환을 눌러 보고 무엇이 움직이는지 비교해 보세요.">
  <DemoControls ariaLabel="전환 종류">
    <button type="button" data-switch="task">A가 I/O 대기 → 런타임 전환</button>
    <button type="button" data-switch="thread">커널 시분할 → 스레드 전환</button>
    <button type="button" data-lens aria-pressed="false">커널의 시선</button>
    <button type="button" data-reset>↺ 처음으로</button>
  </DemoControls>

  <div class="scene-stage" data-stage>
    <svg data-graphic role="img" aria-label="위층의 Java 런타임은 VT A와 B 중 하나를 OS 스레드 T1에 올립니다. 아래층의 Linux 커널은 T1과 T2 중 하나를 CPU0에 올립니다. 커널이 T1을 내리면 T1에 실린 VT도 함께 멈춥니다."></svg>
  </div>
  <div class="switch-history">
    <span class="switch-history-label" data-history-label>CPU0 실행 기록</span>
    <ol data-history aria-label="CPU0에서 실행된 순서"></ol>
  </div>
  <p class="scene-note" data-note role="status"></p>
  <p class="db-demo-disclaimer">지원되는 I/O 대기에서 VT가 carrier에서 내려오는 경우를 그린 모형입니다. 번갈아 보여주려고, 대기 중인 VT의 I/O는 그사이 끝났다고 가정했습니다. I/O 요청에 쓰이는 syscall과 carrier가 고정되는 경로는 생략했습니다.</p>
</InteractiveDemoFrame>

<script>
  import { bowAt, createScene, duration, hopLift, lerp, nextHop, setAttrs, svg, watchNarrow, type Point } from '../../scripts/blog/scene/core';
  import { createBoundary, createNode, createTray, landRing } from '../../scripts/blog/scene/parts';

  type Vt = 'A' | 'B';
  type Thread = 'T1' | 'T2';
  type By = 'runtime' | 'kernel';
  type State = { t1On: number; swap: number; mountA: number; hopA: number; mountB: number; hopB: number; lens: number; jvmGlow: number; osGlow: number };
  type Rect = { x: number; y: number; w: number; h: number };
  type Layout = {
    view: [number, number];
    jvm: Rect; os: Rect; rq: Rect; cpu: Rect; park: Rect;
    rqAt: Point; cpuAt: Point; parkAt: Record<Vt, Point>;
    jvmBadge: Point & { anchor: 'start' | 'end' }; osBadge: Point & { anchor: 'start' | 'end' };
    captions: [string, string];
  };

  const TRAY = { w: 184, h: 112 };
  const VT = { w: 152, h: 44 };
  const PARKED = { w: 112, h: 40 };
  const layouts: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 364],
      jvm: { x: 8, y: 8, w: 544, h: 96 }, park: { x: 284, y: 16, w: 256, h: 82 },
      os: { x: 8, y: 116, w: 544, h: 240 }, rq: { x: 22, y: 156, w: 240, h: 188 }, cpu: { x: 298, y: 156, w: 240, h: 188 },
      rqAt: { x: 142, y: 262 }, cpuAt: { x: 418, y: 262 }, parkAt: { A: { x: 352, y: 68 }, B: { x: 474, y: 68 } },
      jvmBadge: { x: 24, y: 58, anchor: 'start' }, osBadge: { x: 536, y: 142, anchor: 'end' },
      captions: ['Java 런타임 · 어떤 VT를 T1에 올릴까', 'Linux 커널 · 어떤 OS 스레드를 CPU0에 올릴까'],
    },
    narrow: {
      view: [360, 546],
      jvm: { x: 8, y: 8, w: 344, h: 138 }, park: { x: 20, y: 46, w: 320, h: 90 },
      os: { x: 8, y: 158, w: 344, h: 380 }, rq: { x: 20, y: 196, w: 320, h: 160 }, cpu: { x: 20, y: 366, w: 320, h: 162 },
      rqAt: { x: 180, y: 290 }, cpuAt: { x: 180, y: 462 }, parkAt: { A: { x: 104, y: 98 }, B: { x: 256, y: 98 } },
      jvmBadge: { x: 340, y: 34, anchor: 'end' }, osBadge: { x: 340, y: 184, anchor: 'end' },
      captions: ['Java 런타임', 'Linux 커널'],
    },
  };
  const HUE: Record<Thread, string> = { T1: 'var(--scene-hue-cyan)', T2: 'var(--scene-hue-amber)' };
  const START_NOTE = 'CPU0에서 OS 스레드 T1이 실행 중이고, Java 런타임은 T1 위에 VT A를 올려 두었습니다. 두 전환 중 하나를 눌러 보세요.';

  document.querySelectorAll<HTMLElement>('[data-blog-demo="thread-scheduler-lens"]').forEach((demo) => {
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const note = demo.querySelector<HTMLElement>('[data-note]')!;
    const historyList = demo.querySelector<HTMLOListElement>('[data-history]')!;
    const historyLabel = demo.querySelector<HTMLElement>('[data-history-label]')!;
    const taskButton = demo.querySelector<HTMLButtonElement>('[data-switch="task"]')!;
    const threadButton = demo.querySelector<HTMLButtonElement>('[data-switch="thread"]')!;
    const lensButton = demo.querySelector<HTMLButtonElement>('[data-lens]')!;
    const resetButton = demo.querySelector<HTMLButtonElement>('[data-reset]')!;
    let layout = layouts.wide;

    // 논리 상태: 애니메이션 도중에도 "지금 무엇이 어디로 가는 중인가"를 기준으로 판단합니다.
    let onCpu: Thread = 'T1';
    let mounted: Vt = 'A';
    let lens = false;
    let history: { thread: Thread; vt: string; by?: By }[] = [];

    const jvmBand = createBoundary(root, '');
    const osBand = createBoundary(root, '');
    const parkZone = createBoundary(root, 'I/O 대기', 'zone');
    const rqZone = createBoundary(root, 'rq0 · CPU 대기');
    const cpuZone = createBoundary(root, 'CPU0 · 실행 중', 'zone');
    const jvmBadge = svg('text', { class: 'scene-label scene-label-flow' }, root);
    const osBadge = svg('text', { class: 'scene-label scene-label-flow' }, root);
    const t1 = createTray(root, { label: 'OS 스레드 T1', hue: HUE.T1, seatSize: VT });
    const t2 = createTray(root, { label: 'OS 스레드 T2', hue: HUE.T2, seatSize: VT });
    const vtA = createNode(root, { label: 'VT A', hue: 'var(--scene-hue-blue)' });
    const vtB = createNode(root, { label: 'VT B', hue: 'var(--scene-hue-violet)' });
    const vtC = createNode(root, { label: 'VT C', hue: 'var(--scene-hue-pink)' });
    const rings = svg('g', {}, root);

    const initial = (): State => ({ t1On: 1, swap: 0, mountA: 1, hopA: 0, mountB: 0, hopB: 0, lens: lens ? 1 : 0, jvmGlow: 0, osGlow: 0 });
    const t1At = (s: State) => bowAt(layout.rqAt, layout.cpuAt, s.t1On, hopLift(s.swap, 34));
    const t2At = (s: State) => bowAt(layout.cpuAt, layout.rqAt, s.t1On, -hopLift(s.swap, 34));

    const glow = (rect: SVGRectElement, amount: number) => {
      rect.style.stroke = `color-mix(in srgb, var(--scene-flow) ${Math.round(amount * 100)}%, var(--hairline))`;
      rect.style.strokeWidth = String(1.5 + amount);
    };

    const scene = createScene<State>(initial(), (s) => {
      const p1 = t1At(s);
      const p2 = t2At(s);
      t1.setBox({ ...p1, ...TRAY });
      t2.setBox({ ...p2, ...TRAY });
      const seat1 = t1.seat(p1);
      const size = (mount: number) => ({ w: Math.round(lerp(PARKED.w, VT.w, mount)), h: Math.round(lerp(PARKED.h, VT.h, mount)) });
      vtA.setBox({ ...bowAt(layout.parkAt.A, seat1, s.mountA, hopLift(s.hopA, 28)), ...size(s.mountA) });
      vtB.setBox({ ...bowAt(layout.parkAt.B, seat1, s.mountB, hopLift(s.hopB, 28)), ...size(s.mountB) });
      vtC.setBox({ ...t2.seat(p2), ...VT });
      const vtOpacity = String(1 - 0.84 * s.lens);
      [vtA, vtB, vtC].forEach((vt) => { vt.group.style.opacity = vtOpacity; });
      const jvmOpacity = 1 - 0.65 * s.lens;
      jvmBand.place({ ...layout.jvm, o: jvmOpacity });
      parkZone.place({ ...layout.park, o: jvmOpacity }, { x: layout.park.x + 12, y: layout.park.y + 18 });
      glow(jvmBand.rect, s.jvmGlow);
      glow(osBand.rect, s.osGlow);
      jvmBadge.style.opacity = String(s.jvmGlow * jvmOpacity);
      osBadge.style.opacity = String(s.osGlow);
    });

    const applyLayout = () => {
      setAttrs(root, { viewBox: `0 0 ${layout.view[0]} ${layout.view[1]}` });
      jvmBand.caption.textContent = layout.captions[0];
      osBand.caption.textContent = layout.captions[1];
      osBand.place(layout.os, { x: layout.os.x + 16, y: layout.os.y + 26 });
      jvmBand.place(layout.jvm, { x: layout.jvm.x + 16, y: layout.jvm.y + 26 });
      rqZone.place(layout.rq);
      cpuZone.place(layout.cpu);
      setAttrs(jvmBadge, { x: layout.jvmBadge.x, y: layout.jvmBadge.y, 'text-anchor': layout.jvmBadge.anchor });
      setAttrs(osBadge, { x: layout.osBadge.x, y: layout.osBadge.y, 'text-anchor': layout.osBadge.anchor });
      scene.redraw();
    };

    /** 논리 상태가 가리키는 최종 장면. 자리가 바뀌는 대상만 hop을 올려 호를 그리게 합니다. */
    const settle = (s: State, extra: Partial<State> = {}): State => {
      const changed = (from: number, to: number) => Math.abs(from - to) > 0.01;
      const t1On = onCpu === 'T1' ? 1 : 0;
      const mountA = mounted === 'A' ? 1 : 0;
      const mountB = mounted === 'B' ? 1 : 0;
      return {
        ...s,
        t1On, swap: changed(s.t1On, t1On) ? nextHop(s.swap) : s.swap,
        mountA, hopA: changed(s.mountA, mountA) ? nextHop(s.hopA) : s.hopA,
        mountB, hopB: changed(s.mountB, mountB) ? nextHop(s.hopB) : s.hopB,
        lens: lens ? 1 : 0,
        ...extra,
      };
    };

    /** `arriving`을 주면 그 VT는 아직 자리로 가는 중이라 "I/O 완료"로 둡니다. */
    const refreshLabels = (arriving?: Vt) => {
      const waiting: Vt = mounted === 'A' ? 'B' : 'A';
      t1.setSub(onCpu === 'T1' ? '실행 중' : 'CPU 대기');
      t2.setSub(onCpu === 'T2' ? '실행 중' : 'CPU 대기');
      const vtSub = (thread: Thread) => (onCpu === thread ? '실행 중' : `${thread}${thread === 'T1' ? '과' : '와'} 함께 멈춤`);
      (mounted === 'A' ? vtA : vtB).setSub(arriving ? 'I/O 완료' : vtSub('T1'));
      (mounted === 'A' ? vtA : vtB).flash('is-temp', false);
      (waiting === 'A' ? vtA : vtB).setSub('I/O 대기');
      (waiting === 'A' ? vtA : vtB).flash('is-temp', true);
      vtC.setSub(vtSub('T2'));
      taskButton.textContent = `${mounted}가 I/O 대기 → 런타임 전환`;
      lensButton.setAttribute('aria-pressed', String(lens));
    };

    const renderHistory = () => {
      historyList.classList.toggle('is-kernel', lens);
      historyLabel.textContent = lens ? '커널이 본 CPU0 기록' : 'CPU0 실행 기록';
      const items = history.slice(-5).flatMap((entry, index, list) => {
        const nodes: HTMLLIElement[] = [];
        if (entry.by && index > 0) {
          const arrow = document.createElement('li');
          arrow.className = 'switch-arrow';
          arrow.dataset.by = entry.by;
          arrow.innerHTML = entry.by === 'runtime'
            ? '<span class="by-all">런타임 →</span><span class="by-kernel">= 변화 없음</span>'
            : '<span class="by-all">커널 →</span><span class="by-kernel">커널 →</span>';
          nodes.push(arrow);
        }
        const chip = document.createElement('li');
        chip.className = 'switch-chip';
        if (index === list.length - 1 && history.length > 1) chip.classList.add('is-new');
        chip.style.setProperty('--node-hue', HUE[entry.thread]);
        chip.innerHTML = `<b>${entry.thread}</b><span>VT ${entry.vt}</span>`;
        nodes.push(chip);
        return nodes;
      });
      historyList.replaceChildren(...items);
    };

    const say = (html: string, alert = false) => {
      note.innerHTML = html;
      note.classList.toggle('is-alert', alert);
    };

    const switchTask = async () => {
      if (onCpu !== 'T1') {
        scene.begin();
        t1.flash('is-shaking');
        say(`지금 CPU0에서 실행 중인 OS 스레드는 <strong>T2</strong>입니다. 커널이 T1에 CPU를 주기 전에는 Java 런타임도 T1 위에서 VT를 바꿀 수 없습니다. 먼저 <strong>커널 시분할</strong>을 눌러 보세요.`, true);
        return;
      }
      const alive = scene.begin();
      const leaving = mounted;
      const arriving: Vt = leaving === 'A' ? 'B' : 'A';
      mounted = arriving;
      history.push({ thread: 'T1', vt: arriving, by: 'runtime' });
      jvmBadge.textContent = `✓ 방금 ${leaving} → ${arriving} 결정`;
      refreshLabels(arriving);
      renderHistory();
      say(`<strong>Java 런타임</strong>이 I/O를 기다리는 ${leaving}를 T1에서 내리고 ${arriving}를 올렸습니다. <strong>T1은 CPU0에서 내려오지 않았습니다.</strong> 커널의 스케줄링 대상인 T1은 계속 실행 중입니다.`);
      // 빼는 것 먼저: 떠나는 VT만 내리고, 들어올 VT는 지금 자리에 둡니다.
      const s = scene.state;
      const stay = arriving === 'A' ? { mountA: s.mountA, hopA: s.hopA } : { mountB: s.mountB, hopB: s.hopB };
      await scene.go(settle(s, { ...stay, jvmGlow: 1, osGlow: 0 }), duration.move);
      if (!alive()) return;
      refreshLabels();
      if (!(await scene.go(settle(scene.state), duration.move)) || !alive()) return;
      landRing(rings, { ...t1.seat(t1At(scene.state)), ...VT });
    };

    const switchThread = async () => {
      const alive = scene.begin();
      const leaving = onCpu;
      onCpu = leaving === 'T1' ? 'T2' : 'T1';
      history.push({ thread: onCpu, vt: onCpu === 'T1' ? mounted : 'C', by: 'kernel' });
      osBadge.textContent = `✓ 방금 ${leaving} → ${onCpu} 결정`;
      refreshLabels();
      renderHistory();
      say(onCpu === 'T2'
        ? `<strong>커널 스케줄러</strong>가 T1을 CPU0에서 내리고 T2를 올렸습니다. T1 위의 VT ${mounted}는 <strong>실린 채 함께 멈췄습니다.</strong> 커널은 VT ${mounted}를 따로 고르거나 내린 적이 없습니다.`
        : `<strong>커널 스케줄러</strong>가 T1을 다시 CPU0에 올렸습니다. T1에 실려 있던 VT ${mounted}도 함께 이어서 실행됩니다.`);
      if (!(await scene.go(settle(scene.state, { jvmGlow: 0, osGlow: 1 }), duration.fly)) || !alive()) return;
      landRing(rings, { ...layout.cpuAt, ...TRAY });
    };

    const toggleLens = () => {
      lens = !lens;
      refreshLabels();
      renderHistory();
      say(lens
        ? '<strong>커널의 시선</strong>: 커널이 CPU에 올리고 내리는 대상은 T1·T2뿐입니다. VT는 흐리게 표시했습니다. 아래 기록에서 런타임 전환은 커널에게 <strong>변화 없음</strong>입니다.'
        : 'Java 런타임의 시선으로 돌아왔습니다. T1 위에 어떤 VT가 실려 있는지가 다시 보입니다.');
      scene.begin();
      void scene.go(settle(scene.state), duration.draw);
    };

    const reset = () => {
      scene.begin();
      onCpu = 'T1';
      mounted = 'A';
      history = [{ thread: 'T1', vt: 'A' }];
      refreshLabels();
      renderHistory();
      say(START_NOTE);
      void scene.go(settle(scene.state, { jvmGlow: 0, osGlow: 0 }), duration.move);
    };

    taskButton.addEventListener('click', () => { void switchTask(); });
    threadButton.addEventListener('click', () => { void switchThread(); });
    lensButton.addEventListener('click', toggleLens);
    resetButton.addEventListener('click', reset);
    watchNarrow(stage, (narrow) => { layout = layouts[narrow ? 'narrow' : 'wide']; applyLayout(); });
    reset();
  });
</script>

<style>
  .switch-history {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    min-height: 40px;
    margin: 12px 2px 0;
  }

  .switch-history-label {
    color: var(--slate);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .switch-history ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .switch-history li { margin: 0; }

  .switch-history :global(.switch-chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px 4px 7px;
    border: 1px solid var(--hairline);
    border-left: 4px solid var(--node-hue);
    border-radius: 7px;
    background: var(--canvas);
    font-size: 0.78rem;
  }

  .switch-history :global(.switch-chip b) { color: var(--ink); }
  .switch-history :global(.switch-chip span) { color: var(--slate); font-family: var(--font-mono); font-size: 0.72rem; transition: opacity 240ms ease; }
  .switch-history :global(.switch-chip.is-new) { animation: scene-rise 320ms ease-out both; }
  .switch-history :global(.switch-arrow) { color: var(--slate); font-size: 0.72rem; font-weight: 700; }
  .switch-history :global(.switch-arrow .by-kernel) { display: none; }

  .switch-history :global(ol.is-kernel .switch-chip span) { opacity: 0.25; }
  .switch-history :global(ol.is-kernel .switch-arrow .by-all) { display: none; }
  .switch-history :global(ol.is-kernel .switch-arrow .by-kernel) { display: inline; }
  .switch-history :global(ol.is-kernel .switch-arrow[data-by="runtime"]) { color: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    .switch-history :global(.switch-chip.is-new) { animation: none; }
  }
</style>
