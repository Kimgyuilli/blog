---
import InteractiveDemoFrame from '@/components/blog/shared/InteractiveDemoFrame.astro';
import DemoControls from '@/components/blog/shared/DemoControls.astro';
import '@/styles/scene.css';
---

<InteractiveDemoFrame demoId="cache-evict-timeline" ariaLabel="쓰기 트랜잭션 안의 캐시 삭제 시점에 따라 낡은 재고 값이 캐시에 얼마나 남는지 비교하는 시간축" title="캐시를 지웠는데 왜 낡은 값이 남을까요?" description="재고 100 을 99 로 바꾸는 쓰기 트랜잭션과, 그 사이에 들어오는 조회 요청이 있습니다. 캐시를 지우는 시점을 바꿔 보고, 캐시 줄에 낡은 값이 언제부터 언제까지 남는지 보세요.">
  <DemoControls ariaLabel="캐시를 지우는 시점">
    <button type="button" data-ev-mode="0" aria-pressed="true">@CacheEvict (메서드 종료 시)</button>
    <button type="button" data-ev-mode="1" aria-pressed="false">커밋 뒤 삭제 (afterCommit)</button>
    <button type="button" data-ev-mode="2" aria-pressed="false">커밋 뒤 삭제 + 느린 조회</button>
  </DemoControls>
  <div class="scene-chips" role="group" aria-label="실행">
    <button type="button" class="scene-chip is-plain" data-cet-run>처음부터 재생</button>
  </div>
  <div class="scene-stage" data-stage>
    <svg data-graphic role="img" aria-label="네 줄의 시간축입니다. 맨 위는 재고를 100 에서 99 로 바꾸는 쓰기 트랜잭션, 그 아래는 조회 요청, 캐시, DB 에 커밋된 재고입니다. 메서드가 끝날 때 캐시를 지우면 커밋 전에 들어온 조회가 DB 의 100 을 다시 캐시에 넣고, 커밋 뒤에도 그 낡은 값이 다음 쓰기까지 남습니다. 커밋 뒤에 지우면 다음 조회가 99 를 가져옵니다. 다만 커밋 전에 DB 를 읽은 느린 조회가 삭제 뒤에 저장하면 낡은 값이 다시 들어가고, TTL 이 끝나야 사라집니다."></svg>
  </div>
  <p class="scene-note" data-note role="status"></p>
  <p class="db-demo-disclaimer">글에서 검토하고 고르지 않은 선택지를 코드 경로대로 그린 도식이며, 측정한 결과가 아닙니다. 재고 값(100 에서 99)과 조회 시점은 예시이고, 막대의 길이는 실제 시간이 아닙니다. 실제로 고른 방식은 쓰기 경로에서 캐시를 지우지 않고 재고 캐시에 5초 TTL 만 두는 것입니다.</p>
</InteractiveDemoFrame>

<script>
  import { bowAt, clamp01, createScene, duration, ease, hopLift, lerp, setAttrs, svg, watchNarrow } from '@/scripts/blog/scene/core';
  import { watchDemoPlayback } from '@/scripts/blog/watch-demo-playback';

  // 독자가 볼 변화: evict 칩이 "메서드 종료" 자리(커밋 전)에 있으면, 그 사이 조회가 DB 의 100 을 캐시에 다시 넣어
  // 커밋 뒤 캐시 줄이 빨간 "낡음" 막대로 끝까지 이어진다. evict 칩을 COMMIT 뒤로 옮기면 그 막대가 사라지고 다음 조회가 99 를 가져온다.
  // 느린 조회를 켜면 커밋 전에 읽은 100 이 삭제 뒤에 저장되어 낡은 막대가 다시 생기고, TTL 표시에서 끝난다.
  type Tone = 'neutral' | 'stale' | 'ok';
  type Read = { label: string; at: number; kind: 'hit' | 'miss'; dbAt?: number; storeAt?: number; value: string; tone: Tone };
  type Seg = { from: number; to: number; text: string; tone: Tone };
  type Mode = { evict: number; reads: Read[]; cache: Seg[]; tail?: { at: number; text: string } };
  const COMMIT = 5.0;
  const METHOD_END = 2.6;
  const END = 10;
  const MODES: Mode[] = [
    {
      evict: 2.6,
      reads: [
        { label: '조회 1', at: 3.0, kind: 'miss', dbAt: 3.3, storeAt: 3.8, value: '100', tone: 'neutral' },
        { label: '조회 2', at: 7.4, kind: 'hit', value: '100', tone: 'stale' },
      ],
      cache: [
        { from: 0, to: 2.6, text: '100', tone: 'neutral' },
        { from: 3.8, to: COMMIT, text: '100', tone: 'neutral' },
        { from: COMMIT, to: END, text: '낡은 100', tone: 'stale' },
      ],
      tail: { at: END, text: 'TTL 이 없으면 다음 쓰기까지 남음' },
    },
    {
      evict: 5.4,
      reads: [
        { label: '조회 1', at: 3.0, kind: 'hit', value: '100', tone: 'neutral' },
        { label: '조회 2', at: 7.4, kind: 'miss', dbAt: 7.7, storeAt: 8.2, value: '99', tone: 'ok' },
      ],
      cache: [
        { from: 0, to: 5.4, text: '100', tone: 'neutral' },
        { from: 8.2, to: END, text: '99', tone: 'ok' },
      ],
    },
    {
      evict: 5.4,
      reads: [
        { label: '느린 조회', at: 4.2, kind: 'miss', dbAt: 4.5, storeAt: 6.0, value: '100', tone: 'neutral' },
        { label: '조회 2', at: 7.4, kind: 'hit', value: '100', tone: 'stale' },
      ],
      cache: [
        { from: 6.0, to: 9.0, text: '낡은 100', tone: 'stale' },
      ],
      tail: { at: 9.0, text: 'TTL 만료' },
    },
  ];
  const NOTES = [
    '<code>@CacheEvict</code> 는 메서드가 끝날 때, 즉 <strong>커밋 전</strong>에 캐시를 지웁니다. 그사이 들어온 조회 1 이 DB 의 커밋된 값 100 을 다시 캐시에 넣었고, 커밋 뒤 DB 는 99 인데 캐시는 <strong>100 을 계속</strong> 돌려줍니다. TTL 이 없으면 다음 쓰기까지 남습니다.',
    '삭제를 <strong>커밋 뒤</strong>로 옮기면 조회 1 이 캐시에 다시 넣을 일이 없고, 삭제 뒤의 조회 2 가 DB 에서 99 를 가져옵니다. 여기까지 보면 무효화만으로 충분해 보입니다.',
    '하지만 커밋 <strong>전에</strong> DB 를 읽은 느린 조회가 삭제 <strong>뒤에</strong> 저장하면 낡은 100 이 다시 들어갑니다. 삭제와 재조회 사이의 경합은 커밋 뒤에 지워도 남고, 이 값을 끝내는 것은 결국 <strong>TTL</strong> 입니다.',
  ];
  const EVENTS: { at: number; text: string }[][] = [
    [
      { at: 0, text: '쓰기 트랜잭션이 열리고 재고 필드를 99 로 바꿉니다. UPDATE 는 커밋 때 나갑니다.' },
      { at: 2.6, text: '재고 메서드가 끝나며 <code>@CacheEvict</code> 가 캐시를 지웁니다. 트랜잭션은 아직 커밋 전입니다.' },
      { at: 3.0, text: '조회 1 이 캐시에서 값을 못 찾고 DB 를 읽습니다. 커밋된 값은 아직 <strong>100</strong> 입니다.' },
      { at: 3.8, text: '조회 1 이 읽은 100 을 캐시에 저장합니다.' },
      { at: 5.0, text: '이제야 커밋되어 DB 는 <strong>99</strong> 가 됩니다. 캐시의 100 은 이 순간부터 낡은 값입니다.' },
      { at: 7.4, text: '조회 2 는 캐시에서 <strong>100</strong> 을 받습니다.' },
    ],
    [
      { at: 0, text: '쓰기 트랜잭션이 열리고 재고 필드를 99 로 바꿉니다.' },
      { at: 3.0, text: '조회 1 은 캐시의 100 을 받습니다. 아직 커밋 전이라 이 값이 맞습니다.' },
      { at: 5.0, text: '커밋되어 DB 는 99 가 됩니다.' },
      { at: 5.4, text: '커밋 뒤에 캐시를 지웁니다.' },
      { at: 7.4, text: '조회 2 가 DB 에서 <strong>99</strong> 를 읽어 캐시에 넣습니다.' },
    ],
    [
      { at: 0, text: '이 상품은 캐시가 비어 있었습니다. 쓰기 트랜잭션이 재고 필드를 99 로 바꿉니다.' },
      { at: 4.2, text: '느린 조회가 캐시에서 값을 못 찾고 DB 를 읽습니다. 커밋 전이라 <strong>100</strong> 입니다.' },
      { at: 5.0, text: '커밋되어 DB 는 99 가 됩니다.' },
      { at: 5.4, text: '커밋 뒤에 캐시를 지웁니다. 지울 값은 아직 없습니다.' },
      { at: 6.0, text: '느린 조회가 이제야 <strong>100</strong> 을 캐시에 저장합니다. 삭제는 이미 지나갔습니다.' },
      { at: 7.4, text: '조회 2 는 캐시에서 <strong>100</strong> 을 받습니다. 이 값은 TTL 이 끝날 때 사라집니다.' },
    ],
  ];

  type State = { t: number; m: number };
  type Layout = { view: [number, number]; x0: number; x1: number; labelX: number; lanes: [number, number, number, number]; short: boolean };
  const LAYOUTS: Record<'wide' | 'narrow', Layout> = {
    wide: { view: [560, 300], x0: 112, x1: 548, labelX: 14, lanes: [70, 140, 208, 268], short: false },
    narrow: { view: [360, 316], x0: 54, x1: 352, labelX: 8, lanes: [76, 148, 218, 280], short: true },
  };

  document.querySelectorAll<HTMLElement>('[data-blog-demo="cache-evict-timeline"]').forEach((demo) => {
    if (demo.dataset.ready) return;
    demo.dataset.ready = 'true';
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const note = demo.querySelector<HTMLElement>('[data-note]')!;
    const modeButtons = [...demo.querySelectorAll<HTMLButtonElement>('[data-ev-mode]')];
    const runButton = demo.querySelector<HTMLButtonElement>('[data-cet-run]')!;
    let layout = LAYOUTS.wide;

    const blue = 'var(--scene-hue-blue)';
    const cyan = 'var(--scene-hue-cyan)';
    const pink = 'var(--scene-hue-pink)';
    const amber = 'var(--scene-hue-amber)';
    const text = (parent: Element, cls: string, content = '', anchor: 'start' | 'middle' | 'end' = 'middle') => {
      const t = svg('text', { class: cls, 'text-anchor': anchor }, parent);
      t.textContent = content;
      return t;
    };
    const rect = (parent: Element, cls: string, hue?: string) => {
      const r = svg('rect', { class: cls, rx: 7 }, parent);
      if (hue) r.style.setProperty('--node-hue', hue);
      return r;
    };
    const pill = (parent: Element, label: string, hue: string, w: number) => {
      const g = svg('g', { class: 'cet-pill' }, parent);
      g.style.setProperty('--node-hue', hue);
      svg('rect', { class: 'cet-pill-card', rx: 5, height: 20, y: -10, x: -w / 2, width: w }, g);
      const t = svg('text', { class: 'cet-pill-text', y: 4, 'text-anchor': 'middle' }, g);
      t.textContent = label;
      return { g, t };
    };

    const tracks = [0, 1, 2, 3].map(() => rect(root, 'scene-lane-track'));
    const laneNames = [0, 1, 2, 3].map(() => text(root, 'cet-lane-name', '', 'start'));
    [blue, cyan, pink, 'var(--slate)'].forEach((c, i) => { laneNames[i].style.fill = c; });

    // 쓰기 트랜잭션
    const tx = svg('rect', { class: 'cet-tx', rx: 9 }, root);
    const txLabel = text(root, 'scene-label is-sans cet-tx-label', '쓰기 트랜잭션', 'start');
    const changeTick = svg('line', { class: 'cet-tick' }, root);
    changeTick.style.stroke = blue;
    const changeLabel = text(root, 'scene-label is-sans cet-blue', '');
    const endTick = svg('line', { class: 'cet-tick' }, root);
    endTick.style.stroke = blue;
    const endLabel = text(root, 'scene-label is-sans cet-blue', '');
    const commitPill = pill(root, 'COMMIT', blue, 56);
    const commitLine = svg('line', { class: 'cet-commit-line' }, root);
    const evictLine = svg('line', { class: 'cet-evict-line' }, root);
    const evict = pill(root, 'evict', pink, 46);

    // DB 커밋값
    const dbOld = rect(root, 'scene-lane-bar', amber);
    const dbNew = rect(root, 'scene-lane-bar', amber);
    const dbOldText = text(root, 'cet-mono', '100');
    const dbNewText = text(root, 'cet-mono', '99');

    // 모드별 조회와 캐시 그림: 겹쳐 두고 모드 값에 따라 서로 흐려졌다 나타납니다.
    const groups = MODES.map((mode) => {
      const g = svg('g', {}, root);
      const segs = mode.cache.map((seg) => ({ seg, bar: rect(g, `cet-seg is-${seg.tone}`), label: text(g, 'cet-mono', seg.text) }));
      const reads = mode.reads.map((read) => ({
        read,
        p: pill(g, read.label, cyan, 0),
        down: svg('line', { class: 'cet-read-line' }, g),
        downLabel: text(g, 'scene-label is-sans cet-read-label', '', 'end'),
        store: svg('line', { class: 'cet-store-line' }, g),
        storeLabel: text(g, 'scene-label is-sans cet-store-label', '저장'),
        result: text(g, 'scene-label is-sans cet-result', ''),
      }));
      const tailTick = svg('line', { class: 'cet-tail-tick' }, g);
      const tailLabel = text(g, 'scene-label is-sans cet-tail', mode.tail?.text ?? '', 'end');
      return { g, mode, segs, reads, tailTick, tailLabel };
    });
    const cursor = svg('line', { class: 'cet-cursor' }, root);

    let sweeping = false;
    let eventIndex = -1;
    let mode = 0;

    const scene = createScene<State>({ t: END, m: 0 }, (s) => {
      const l = layout;
      const x = (time: number) => l.x0 + ((l.x1 - l.x0) * time) / END;
      const shown = (time: number) => (s.t >= time ? 1 : 0);
      const upTo = (time: number) => Math.min(time, s.t);
      const [yW, yR, yC, yD] = l.lanes;
      const names = l.short ? ['쓰기', '조회', '캐시', 'DB'] : ['쓰기', '조회 요청', '캐시', 'DB 커밋값'];
      tracks.forEach((track, i) => setAttrs(track, { x: l.x0, y: l.lanes[i] - 17, width: l.x1 - l.x0, height: 34 }));
      laneNames.forEach((name, i) => { name.textContent = names[i]; setAttrs(name, { x: l.labelX, y: l.lanes[i] + 4 }); });

      // 쓰기 트랜잭션 상자와 표시
      setAttrs(tx, { x: x(0.3), y: yW - 22, width: Math.max(0, x(upTo(COMMIT + 0.3)) - x(0.3)), height: 44, opacity: s.t > 0.3 ? 1 : 0 });
      setAttrs(txLabel, { x: x(0.3) + 4, y: yW - 28, opacity: s.t > 0.3 ? 1 : 0 });
      setAttrs(changeTick, { x1: x(1.0), x2: x(1.0), y1: yW - 12, y2: yW + 12, opacity: shown(1.0) });
      changeLabel.textContent = l.short ? '99로' : '재고 99로 변경';
      setAttrs(changeLabel, { x: x(1.0), y: yW + 32, opacity: shown(1.0) });
      setAttrs(endTick, { x1: x(METHOD_END), x2: x(METHOD_END), y1: yW - 12, y2: yW + 12, opacity: shown(METHOD_END) });
      endLabel.textContent = l.short ? '메서드 끝' : '재고 메서드 종료';
      setAttrs(endLabel, { x: x(METHOD_END) + (l.short ? 10 : 20), y: yW + 32, opacity: shown(METHOD_END) });
      setAttrs(commitPill.g, { transform: `translate(${x(COMMIT)} ${yW})` });
      commitPill.g.style.opacity = String(shown(COMMIT));
      setAttrs(commitLine, { x1: x(COMMIT), x2: x(COMMIT), y1: yW + 10, y2: yD + 14, opacity: shown(COMMIT) });

      // evict 칩: 메서드 종료 자리(커밋 전)와 커밋 뒤 사이. 모드가 바뀌면 호를 그리며 옮겨 갑니다.
      const evAt = lerp(MODES[0].evict, MODES[1].evict, clamp01(s.m));
      const a = { x: x(MODES[0].evict), y: yW };
      const b = { x: x(MODES[1].evict) + (l.short ? 42 : 34), y: yW };
      const k = clamp01(s.m);
      const pt = k > 0 && k < 1 ? bowAt(a, b, k, -hopLift(k, 34)) : k >= 1 ? b : a;
      setAttrs(evict.g, { transform: `translate(${pt.x.toFixed(2)} ${(pt.y + (k >= 1 ? 0 : 0)).toFixed(2)})` });
      evict.g.style.opacity = String(shown(evAt));
      evict.g.classList.toggle('is-early', s.m < 0.5);
      setAttrs(evictLine, { x1: x(evAt), x2: x(evAt), y1: yW + 10, y2: yC - 12, opacity: k > 0.02 && k < 0.98 ? 0 : shown(evAt) });

      // DB 커밋값
      const bar = (r: SVGRectElement, y: number, from: number, to: number) => {
        const w = Math.max(0, x(upTo(to)) - x(from));
        setAttrs(r, { x: x(from), y: y - 11, width: w, height: 22, opacity: s.t > from ? 1 : 0 });
        return w;
      };
      bar(dbOld, yD, 0, COMMIT);
      bar(dbNew, yD, COMMIT, END);
      setAttrs(dbOldText, { x: (x(0) + x(upTo(COMMIT))) / 2, y: yD + 4, opacity: s.t > 0.6 ? 1 : 0 });
      setAttrs(dbNewText, { x: (x(COMMIT) + x(END)) / 2, y: yD + 4, opacity: shown(COMMIT + 0.4) });

      // 모드별 조회와 캐시
      groups.forEach((group, gi) => {
        const w = clamp01(1 - Math.abs(s.m - gi) * 2);
        group.g.style.opacity = String(w);
        group.g.style.display = w < 0.01 ? 'none' : '';
        group.segs.forEach(({ seg, bar: r, label }) => {
          const width = bar(r, yC, seg.from, seg.to);
          setAttrs(label, { x: x(seg.from) + width / 2, y: yC + 4, opacity: width > (l.short ? 24 : 34) ? 1 : 0 });
          label.textContent = seg.text;
        });
        group.reads.forEach(({ read, p, down, downLabel, store, storeLabel, result }) => {
          const pw = l.short ? (read.label.length > 4 ? 46 : 40) : read.label.length > 4 ? 62 : 52;
          setAttrs(p.g.querySelector('rect')!, { x: -pw / 2, width: pw });
          p.t.textContent = l.short ? read.label.replace('조회 ', '').replace(' 조회', '') : read.label;
          setAttrs(p.g, { transform: `translate(${x(read.at)} ${yR})` });
          p.g.style.opacity = String(shown(read.at));
          if (read.kind === 'hit') {
            setAttrs(down, { x1: x(read.at), x2: x(read.at), y1: yR + 10, y2: yC - 12, opacity: shown(read.at + 0.15) });
            downLabel.textContent = '';
            setAttrs(store, { opacity: 0 });
            setAttrs(storeLabel, { opacity: 0 });
          } else {
            const dbAt = read.dbAt!;
            setAttrs(down, { x1: x(dbAt), x2: x(dbAt), y1: yR + 10, y2: yD - 12, opacity: shown(dbAt) });
            downLabel.textContent = l.short ? `DB ${read.value}` : `DB 에서 ${read.value}`;
            setAttrs(downLabel, { x: x(dbAt) - 5, y: (yC + yD) / 2 + 4, opacity: shown(dbAt) });
            const st = read.storeAt!;
            setAttrs(store, { x1: x(st), x2: x(st), y1: yR + 10, y2: yC - 12, opacity: shown(st) });
            setAttrs(storeLabel, { x: x(st), y: yR - 16, opacity: shown(st) && !l.short ? 1 : 0 });
          }
          const resultText = read.tone === 'stale' ? `낡은 ${read.value}` : read.tone === 'ok' ? `새 값 ${read.value}` : read.value;
          result.textContent = l.short ? resultText : `받음 ${resultText}`;
          const resultAt = read.kind === 'hit' ? read.at : read.storeAt!;
          setAttrs(result, { x: x(read.at), y: yR + 30, opacity: shown(resultAt) });
          result.classList.toggle('is-stale', read.tone === 'stale');
          result.classList.toggle('is-ok', read.tone === 'ok');
        });
        if (group.mode.tail) {
          const tAt = group.mode.tail.at;
          setAttrs(group.tailTick, { x1: x(tAt), x2: x(tAt), y1: yC - 18, y2: yC + 18, opacity: tAt < END ? shown(tAt) : 0 });
          setAttrs(group.tailLabel, { x: tAt < END ? x(tAt) + (l.short ? 22 : 30) : x(END), y: yC + 32, opacity: shown(tAt - 0.01) });
          if (l.short) group.tailLabel.textContent = tAt < END ? 'TTL' : '다음 쓰기까지';
          else group.tailLabel.textContent = group.mode.tail.text;
        } else {
          setAttrs(group.tailTick, { opacity: 0 });
          setAttrs(group.tailLabel, { opacity: 0 });
        }
      });

      setAttrs(cursor, { x1: x(s.t), x2: x(s.t), y1: yW - 34, y2: yD + 18, opacity: s.t < END - 0.05 ? 1 : 0 });

      if (sweeping) {
        const events = EVENTS[mode];
        let index = 0;
        events.forEach((event, i) => { if (s.t >= event.at) index = i; });
        if (index !== eventIndex) { eventIndex = index; say(events[index].text); }
      }
    });

    function say(html: string) {
      note.innerHTML = html;
      note.classList.toggle('is-alert', !sweeping && mode !== 1);
      note.classList.remove('is-entering');
      void note.offsetWidth;
      note.classList.add('is-entering');
    }

    const sweep = async () => {
      const alive = scene.begin();
      sweeping = true;
      eventIndex = -1;
      scene.set({ t: 0, m: mode });
      await scene.pause(300);
      if (!alive()) return;
      const ok = await scene.go({ t: END, m: mode }, 9000, ease.linear);
      if (!alive()) return;
      sweeping = false;
      if (!ok) return;
      await scene.pause(duration.read);
      if (!alive()) return;
      say(NOTES[mode]);
      const next = modeButtons[mode + 1];
      if (next) next.setAttribute('data-state', 'next');
    };

    modeButtons.forEach((button) => button.addEventListener('click', () => {
      const next = Number(button.dataset.evMode);
      modeButtons.forEach((b) => { b.setAttribute('aria-pressed', String(b === button)); b.removeAttribute('data-state'); });
      if (next === mode) return;
      mode = next;
      scene.begin();
      sweeping = false;
      if (scene.state.t < END) scene.set({ ...scene.state, t: END });
      say(NOTES[mode]);
      void scene.go({ t: END, m: mode }, duration.fly * 2);
    }));
    runButton.addEventListener('click', () => { void sweep(); });

    watchNarrow(stage, (narrow) => {
      layout = LAYOUTS[narrow ? 'narrow' : 'wide'];
      setAttrs(root, { viewBox: `0 0 ${layout.view[0]} ${layout.view[1]}` });
      scene.begin();
      sweeping = false;
      scene.set({ t: END, m: mode });
      say(NOTES[mode]);
    });

    let played = false;
    watchDemoPlayback(demo, ({ shouldPlay }) => {
      if (!shouldPlay || played) return;
      played = true;
      window.setTimeout(() => { void sweep(); }, 300);
    }, { threshold: 0.5 });
  });
</script>

