---
/**
 * 재발행 한 건이 거치는 관문을 한 장면에 모은 타임라인.
 * 세 스위치(저장 실패, Product 재실패, outbox 행 삭제)로 원장의 두 상태, 미결 건수, 롤백 확인 결과가 어떻게 달라지는지 비교합니다.
 */
import InteractiveDemoFrame from '@/components/blog/shared/InteractiveDemoFrame.astro';
import DemoControls from '@/components/blog/shared/DemoControls.astro';
import SceneTimeline from '@/components/blog/shared/SceneTimeline.astro';
import '@/styles/scene.css';

const steps = [
  { name: '사전 확인', detail: '허용' },
  { name: 'claim', detail: 'REQUESTED' },
  { name: '발행', detail: '1회' },
  { name: '소비', detail: '처리 1회' },
  { name: '종결', detail: '미결 0' },
  { name: '늦은 재실패', detail: '없음' },
  { name: '롤백 확인', detail: '통과' },
];
---

<InteractiveDemoFrame
  demoId="dlq-replay-summary"
  ariaLabel="재발행 한 건이 사전 확인, claim, 발행, 소비, 종결, 늦은 재실패, 롤백 확인을 거치는 타임라인과, 세 가지 조건을 바꿀 때 원장의 두 상태과 미결 건수, 롤백 확인 결과가 달라지는 모형"
  title="재발행 한 건이 지나가는 길"
  description="스위치를 바꾸면 같은 일곱 단계를 다른 조건으로 다시 봅니다. 원장의 발행 상태와 사건 상태, 아래의 숫자와 로그를 함께 보세요."
>
  <DemoControls ariaLabel="조건">
    <button type="button" data-drs-opt="saveFail" aria-pressed="false">발행 직후 저장 실패</button>
    <button type="button" data-drs-opt="refail" aria-pressed="false">Product 가 다시 실패</button>
    <button type="button" data-drs-opt="deleted" aria-pressed="false">outbox 행 삭제</button>
  </DemoControls>
  <div class="scene-stage" data-stage>
    <svg data-graphic viewBox="0 0 560 268" role="img" aria-label="왼쪽 카드는 원장의 원래 사건 행으로 발행 상태와 사건 상태를 가집니다. 가운데에 outbox 행과 원래 토픽, 오른쪽에 Order, Notification, Product 소비자와 DLQ가 있습니다. 재발행 메시지는 outbox에서 토픽으로 나가 세 소비자에게 가고, Order와 Notification은 같은 eventId라 건너뛰며 Product만 처리합니다. Product가 다시 실패하면 DLQ를 거쳐 원래 사건 아래 자식 행으로 붙고, 종결된 사건이라면 다시 열립니다."></svg>
  </div>
  <div class="drs-metrics" aria-hidden="true">
    <div class="scene-metric"><b data-m-sends>0</b><span>발행 횟수</span></div>
    <div class="scene-metric"><b data-m-processed>0</b><span>Product 처리</span></div>
    <div class="scene-metric"><b data-m-unresolved>1</b><span>미결</span></div>
    <div class="scene-metric"><b data-m-rollback>대기</b><span>롤백 확인</span></div>
  </div>
  <SceneTimeline ariaLabel="일곱 단계" steps={steps} />
  <ol class="scene-console" data-console aria-live="polite"></ol>
  <p class="db-demo-disclaimer">실제 운영에서 실행된 적 없는 흐름을 옮긴 모형이고, 숫자는 예시입니다. 여덟 가지 재발행 조건 확인과 아홉 가지 재실패 대조는 "허용", "대조 통과" 한 줄로 줄였습니다. 재시도 간격, lag 확인 간격, 재시도 상한 시간은 표시만 하고 실제 시간 흐름은 압축했습니다. 저장 실패는 한 번 일어난 뒤 다음 주기에 다시 발행되는 경우만, outbox 행 삭제는 발행 뒤 결과가 정해지기 전에 사라지는 경우만 그렸습니다.</p>
</InteractiveDemoFrame>

<script>
  import { bumpText, createScene, duration, lerp, replayClass, setAttrs, svg, watchNarrow, type Box, type Point } from '@/scripts/blog/scene/core';
  import { createBadge, createChip, createNode, landRing, type NodeView } from '@/scripts/blog/scene/parts';
  import { createPacketLayer, type Packet } from '@/scripts/blog/scene/packets';
  import { createConsole, type Tone } from '@/scripts/blog/scene/console';
  import { createStepPlayer } from '@/scripts/blog/scene/step-player';

  // 독자가 볼 변화: 재발행 한 건이 outbox에서 토픽을 거쳐 세 소비자로 퍼지고, Order와 Notification은 건너뛰며 Product만 처리한다.
  // 저장 실패를 켜면 같은 메시지가 두 번 나가도 처리는 한 번, Product 재실패를 켜면 종결된 사건이 다시 열려 미결이 1로 돌아오고,
  // outbox 행 삭제를 켜면 발행 축이 REQUESTED에 머물러 종결과 롤백이 막혔다가 PUBLISH_UNKNOWN 전이 뒤에야 통과한다.
  type Opts = { saveFail: boolean; refail: boolean; deleted: boolean };
  type State = { ob: number; gone: number; child: number; alert: number };
  type Layout = {
    view: [number, number];
    card: { x: number; y: number; w: number; h: number }; caption: Point; alert: Point;
    pubBadge: Point; incBadge: Point; badgeW: number; judge: Point; msg: Point;
    child: Point; childW: number; tree: string;
    obFrom: Point; ob: Point; obStatus: Point;
    topic: Box; order: Box; noti: Box; product: Box; dlq: Box;
    toChild: Point[];
  };
  const LAYOUTS: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 268],
      card: { x: 12, y: 12, w: 222, h: 210 }, caption: { x: 26, y: 34 }, alert: { x: 192, y: 29 },
      pubBadge: { x: 24, y: 62 }, incBadge: { x: 24, y: 96 }, badgeW: 198, judge: { x: 26, y: 132 }, msg: { x: 26, y: 152 },
      child: { x: 132, y: 196 }, childW: 176, tree: 'M 34 162 L 34 196 L 44 196',
      obFrom: { x: 118, y: 62 }, ob: { x: 316, y: 40 }, obStatus: { x: 316, y: 66 },
      topic: { x: 316, y: 150, w: 128, h: 40 },
      order: { x: 488, y: 46, w: 120, h: 42 }, noti: { x: 488, y: 108, w: 120, h: 42 }, product: { x: 488, y: 170, w: 120, h: 42 },
      dlq: { x: 488, y: 238, w: 120, h: 34 },
      toChild: [{ x: 426, y: 238 }, { x: 132, y: 238 }, { x: 132, y: 210 }],
    },
    narrow: {
      view: [360, 386],
      card: { x: 8, y: 8, w: 344, h: 176 }, caption: { x: 20, y: 28 }, alert: { x: 306, y: 23 },
      pubBadge: { x: 18, y: 52 }, incBadge: { x: 18, y: 84 }, badgeW: 324, judge: { x: 20, y: 118 }, msg: { x: 20, y: 138 },
      child: { x: 254, y: 162 }, childW: 160, tree: '',
      obFrom: { x: 96, y: 52 }, ob: { x: 90, y: 212 }, obStatus: { x: 90, y: 238 },
      topic: { x: 272, y: 212, w: 120, h: 38 },
      order: { x: 62, y: 296, w: 104, h: 42 }, noti: { x: 180, y: 296, w: 104, h: 42 }, product: { x: 298, y: 296, w: 104, h: 42 },
      dlq: { x: 298, y: 360, w: 104, h: 32 },
      toChild: [{ x: 352, y: 360 }, { x: 356, y: 360 }, { x: 356, y: 162 }, { x: 340, y: 162 }],
    },
  };

  const HUE = { none: 'var(--slate)', temp: 'var(--scene-temp)', flow: 'var(--scene-flow)', danger: 'var(--scene-danger)' };
  type Snap = {
    state: State;
    pub: [string, string]; inc: [string, string];
    judge: string; msg: string; msgTone: '' | 'temp' | 'danger' | 'flow';
    outbox: string; outboxTone: '' | 'flow' | 'danger';
    topicSub: string; order: string; noti: string; prod: string; prodTone: '' | 'ok' | 'temp' | 'error';
    sends: number; processed: number; unresolved: number; rollback: string;
    lines: [string, Tone][]; detail: string; note?: string;
  };

  const snapshot = (i: number, o: Opts): Snap => {
    const sends = i >= 2 ? (o.saveFail ? 2 : 1) : 0;
    const publishedTo = o.deleted ? 'REQUESTED' : 'PUBLISHED';
    const pubText = i === 0 ? '요청 없음' : i === 1 ? 'REQUESTED' : i === 6 && o.deleted ? 'PUBLISH_UNKNOWN' : publishedTo;
    const pubHue = pubText === 'PUBLISHED' ? HUE.flow : pubText === '요청 없음' ? HUE.none : HUE.temp;
    const closed = i >= 4 && !o.deleted;
    const reopened = i >= 5 && o.refail && closed;
    const incText = closed && !reopened ? 'RESOLVED' : 'OPEN';
    const unresolved = incText === 'OPEN' ? 1 : 0;
    const consumed = i >= 3;
    const prodFail = consumed && o.refail;
    const lines: [string, Tone][] = [];
    let msg = '';
    let msgTone: Snap['msgTone'] = '';
    let detail = '';
    if (i === 0) {
      lines.push(['재발행 조건 8가지 확인: 허용', 'ok'], ['허용 또는 거절 결과를 원장에 기록', 'ok']);
      detail = '허용';
    } else if (i === 1) {
      lines.push(['조건부 UPDATE 로 요청 없음에서 REQUESTED 로 변경 (1행)', 'ok'], ['시도 번호, 대상 group, 본문 해시 기록', 'ok'], ['outbox 에 재발행 행 생성 (PENDING)', 'ok']);
      msg = 'claim 1행';
      detail = 'REQUESTED';
    } else if (i === 2) {
      if (o.saveFail) lines.push(['poller 가 발행하고 ack 수신', 'ok'], ['outbox PUBLISHED 저장 실패, 행은 PENDING', 'fail'], ['다음 주기에 같은 메시지를 다시 발행하고 ack 수신', 'warn']);
      else lines.push(['poller 가 발행하고 ack 수신, outbox PUBLISHED', 'ok']);
      if (o.deleted) lines.push(['결과가 정해지기 전에 outbox 행이 사라짐', 'fail'], ['원장은 REQUESTED 그대로 (실패로 바꾸지 않음)', 'warn']);
      else lines.push(['원장을 PUBLISHED 로 바꾸고 결과가 정해진 시각 기록', 'ok']);
      msg = o.deleted ? '결과 모름' : '결과 시각 기록';
      msgTone = o.deleted ? 'temp' : '';
      detail = `${sends}회 발행`;
    } else if (i === 3) {
      lines.push([`Order, Notification: 같은 eventId 라 건너뜀${sends > 1 ? ' (2번)' : ''}`, 'ok']);
      if (o.refail) lines.push(['Product: 처리 실패, 재시도 중 (1초, 5초, 30초)', 'warn']);
      else lines.push([`Product: 처리 1회${sends > 1 ? ', 두 번째는 건너뜀' : ''}`, 'ok']);
      if (!o.deleted) lines.push(['발행 상태가 PUBLISHED 여도 사건은 미결', 'step']);
      msg = o.deleted ? '결과 모름' : 'PUBLISHED여도 미결';
      msgTone = 'temp';
      detail = o.refail ? '재시도 중' : '처리 1회';
    } else if (i === 4) {
      if (o.deleted) lines.push(['운영자 종결 요청: 발행 상태가 REQUESTED 라 거절', 'fail']);
      else lines.push(['운영자 종결: OPEN 에서 RESOLVED 로 (근거 기록)', 'ok']);
      msg = o.deleted ? '발행 중이라 종결 불가' : '운영자 종결';
      msgTone = o.deleted ? 'danger' : 'flow';
      detail = `미결 ${unresolved}`;
    } else if (i >= 5) {
      if (o.refail) {
        lines.push(['재실패 도착: 대조 통과, 원래 사건 아래 자식 행으로 적재', 'ok']);
        if (reopened) lines.push(['종결된 사건이 다시 열림, 재개방 알림', 'warn']);
      } else lines.push(['재실패 없음', 'step']);
      msg = o.refail ? (reopened ? '늦은 재실패로 재개방' : '재실패가 #1 아래로') : '재실패 없음';
      msgTone = reopened ? 'temp' : '';
      detail = o.refail ? (reopened ? '재개방' : '자식 행') : '없음';
    }
    if (i === 6) {
      lines.length = 0;
      lines.push(['롤백 확인: 네 서비스의 DB 와 브로커 조회', 'step'], ['안 나간 재발행 0', 'ok']);
      lines.push(o.deleted ? ['결과를 모르는 요청 1 (REQUESTED)', 'fail'] : ['결과를 모르는 요청 0', 'ok']);
      lines.push(['재발행분 lag 0 (두 번 연속 확인)', 'ok'], ['마지막 결과 시각에서 재시도 상한 경과', 'ok']);
      if (o.deleted) lines.push(['배포 중단', 'fail'], ['운영자: REQUESTED 에서 PUBLISH_UNKNOWN 으로 (근거 기록)', 'step'], ['다시 확인: 네 조건 통과, 배포 진행', 'ok']);
      else lines.push(['네 조건 통과, 배포 진행', 'ok']);
      if (o.deleted) { msg = '재발행 불가 상태'; msgTone = 'temp'; }
      detail = o.deleted ? '차단 후 통과' : '통과';
    }
    return {
      state: { ob: i >= 1 ? 1 : 0, gone: i >= 2 && o.deleted ? 1 : 0, child: i >= 5 && o.refail ? 1 : 0, alert: reopened ? 1 : 0 },
      pub: [pubText, pubHue], inc: [incText, incText === 'RESOLVED' ? HUE.flow : HUE.temp],
      judge: '사전 확인: 허용, 기록', msg, msgTone,
      outbox: i < 1 ? '' : i === 1 ? 'PENDING' : o.deleted ? '삭제됨' : 'PUBLISHED', outboxTone: i < 2 ? '' : o.deleted ? 'danger' : 'flow',
      topicSub: sends ? `${sends}회 발행` : '',
      order: consumed ? (sends > 1 ? '2번 건너뜀' : '건너뜀') : '', noti: consumed ? (sends > 1 ? '2번 건너뜀' : '건너뜀') : '',
      prod: !consumed ? '' : prodFail ? (i >= 5 ? '재시도 소진' : '실패, 재시도 중') : `처리 1${sends > 1 ? ', 건너뜀 1' : '회'}`,
      prodTone: !consumed ? '' : prodFail ? (i >= 5 ? 'error' : 'temp') : 'ok',
      sends, processed: consumed && !o.refail ? 1 : 0, unresolved,
      rollback: i < 6 ? '대기' : '통과',
      lines, detail,
    };
  };

  document.querySelectorAll<HTMLElement>('[data-blog-demo="dlq-replay-summary"]').forEach((demo) => {
    if (demo.dataset.ready) return;
    demo.dataset.ready = 'true';
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const optButtons = [...demo.querySelectorAll<HTMLButtonElement>('[data-drs-opt]')];
    const details = [...demo.querySelectorAll<HTMLElement>('[data-step] small')];
    const logger = createConsole(demo.querySelector<HTMLOListElement>('[data-console]')!, '단계를 고르면 로그가 여기에 찍힙니다.');
    const metric = (name: string) => demo.querySelector<HTMLElement>(`[data-m-${name}]`)!;
    const m = { sends: metric('sends'), processed: metric('processed'), unresolved: metric('unresolved'), rollback: metric('rollback') };
    const opts: Opts = { saveFail: false, refail: false, deleted: false };
    let layout = LAYOUTS.wide;
    let current = -1;

    // 원장 카드
    const card = svg('rect', { class: 'drs-card', rx: 14 }, root);
    const caption = svg('text', { class: 'scene-caption' }, root);
    caption.textContent = '원장의 원래 사건 #1';
    const pubBadge = createBadge(root, '발행', LAYOUTS.wide.badgeW);
    const incBadge = createBadge(root, '사건', LAYOUTS.wide.badgeW);
    const judge = svg('text', { class: 'scene-label is-sans drs-judge' }, root);
    const msg = svg('text', { class: 'scene-label is-sans drs-msg' }, root);
    const tree = svg('path', { class: 'drs-tree' }, root);
    const childWide = createChip(root, { label: '#2 재실패, 대조 통과', hue: 'var(--scene-hue-amber)', width: LAYOUTS.wide.childW });
    const childNarrow = createChip(root, { label: '#2 재실패, #1 아래', hue: 'var(--scene-hue-amber)', width: LAYOUTS.narrow.childW });
    [childWide, childNarrow].forEach((c) => c.group.classList.add('is-sans'));
    const alertGroup = svg('g', { class: 'drs-alert' }, root);
    const alertPill = svg('rect', { class: 'drs-alert-pill', rx: 9, height: 18, width: 74 }, alertGroup);
    const alertText = svg('text', { class: 'scene-label is-sans drs-alert-text', 'text-anchor': 'middle' }, alertGroup);
    alertText.textContent = '재개방 알림';

    // 흐름
    const tracks = Array.from({ length: 6 }, () => svg('path', { class: 'drs-track' }, root));
    const outbox = createChip(root, { label: 'outbox 재발행 행', hue: 'var(--scene-hue-cyan)', width: 150 });
    const obStatus = svg('text', { class: 'scene-label drs-ob-status', 'text-anchor': 'middle' }, root);
    const topic = createNode(root, { label: '원래 토픽', hue: 'var(--scene-hue-gray)' });
    const order = createNode(root, { label: 'Order', hue: 'var(--scene-hue-blue)' });
    const noti = createNode(root, { label: 'Notification', hue: 'var(--scene-hue-violet)' });
    const product = createNode(root, { label: 'Product', hue: 'var(--scene-hue-amber)' });
    const dlq = createNode(root, { label: 'DLQ', hue: 'var(--scene-hue-gray)' });
    [topic, order, noti, product].forEach((n) => n.group.classList.add('is-sans-sub'));
    const layer = createPacketLayer(root);

    const scene = createScene<State>({ ob: 0, gone: 0, child: 0, alert: 0 }, (s) => {
      const l = layout;
      const narrow = l === LAYOUTS.narrow;
      setAttrs(card, { x: l.card.x, y: l.card.y, width: l.card.w, height: l.card.h });
      setAttrs(caption, { x: l.caption.x, y: l.caption.y });
      pubBadge.place(l.pubBadge);
      incBadge.place(l.incBadge);
      [pubBadge, incBadge].forEach((b) => b.group.querySelector('rect')!.setAttribute('width', String(l.badgeW)));
      [pubBadge, incBadge].forEach((b) => b.value.setAttribute('x', String((b === pubBadge ? l.pubBadge.x : l.incBadge.x) + l.badgeW - 11)));
      setAttrs(judge, { x: l.judge.x, y: l.judge.y });
      setAttrs(msg, { x: l.msg.x, y: l.msg.y });
      setAttrs(alertPill, { x: l.alert.x - 37, y: l.alert.y - 9 });
      setAttrs(alertText, { x: l.alert.x, y: l.alert.y + 4 });
      alertGroup.style.opacity = String(s.alert);

      // 자식 행: 대조를 통과한 재실패가 원래 사건 아래로 붙습니다.
      const [child, hidden] = narrow ? [childNarrow, childWide] : [childWide, childNarrow];
      hidden.place({ x: -300, y: -300 }, 0);
      child.place({ x: l.child.x, y: l.child.y + (1 - s.child) * 10 }, s.child);
      setAttrs(tree, { d: l.tree, opacity: s.child });

      // outbox 칩: 원장 카드에서 떠올라 호를 그리며 제자리로 날아갑니다. 삭제되면 흐려지고 점선이 됩니다.
      const t = s.ob;
      const lift = -34 * Math.sin(Math.PI * t);
      const at = { x: lerp(l.obFrom.x, l.ob.x, t), y: lerp(l.obFrom.y, l.ob.y, t) + lift };
      outbox.place(at, Math.min(1, t * 3) * (1 - 0.7 * s.gone));
      outbox.group.classList.toggle('is-empty', s.gone > 0.5);
      setAttrs(obStatus, { x: l.obStatus.x, y: l.obStatus.y, opacity: t > 0.98 ? 1 : 0 });

      topic.setBox(l.topic);
      order.setBox(l.order);
      noti.setBox(l.noti);
      product.setBox(l.product);
      dlq.setBox(l.dlq);
      const tb = l.topic;
      const left = (b: Box) => ({ x: b.x - b.w / 2 - 6, y: b.y });
      const line = (a: Point, b: Point) => `M ${a.x} ${a.y} L ${b.x} ${b.y}`;
      if (narrow) {
        setAttrs(tracks[0], { d: line({ x: l.ob.x + 79, y: l.ob.y }, left(tb)) });
        [order, noti, product].forEach((_, k) => {
          const b = [l.order, l.noti, l.product][k];
          setAttrs(tracks[1 + k], { d: line({ x: tb.x, y: tb.y + tb.h / 2 + 4 }, { x: b.x, y: b.y - b.h / 2 - 6 }) });
        });
        setAttrs(tracks[5], { d: `M ${l.toChild.map((p) => `${p.x} ${p.y}`).join(' L ')}` });
      } else {
        setAttrs(tracks[0], { d: line({ x: l.ob.x, y: l.ob.y + 14 }, { x: tb.x, y: tb.y - tb.h / 2 - 6 }) });
        [l.order, l.noti, l.product].forEach((b, k) => setAttrs(tracks[1 + k], { d: line({ x: tb.x + tb.w / 2 + 4, y: tb.y }, left(b)) }));
        setAttrs(tracks[5], { d: `M ${l.toChild.map((p) => `${p.x} ${p.y}`).join(' L ')}` });
      }
      setAttrs(tracks[4], { d: line({ x: l.product.x, y: l.product.y + l.product.h / 2 + 4 }, { x: l.dlq.x, y: l.dlq.y - l.dlq.h / 2 - 6 }) });
    });

    const setNode = (node: NodeView, text: string, tone: Snap['prodTone'] = '') => {
      node.setSub(text);
      node.group.classList.toggle('is-error', tone === 'error');
      node.group.classList.toggle('is-waiting', tone === 'temp');
      node.group.classList.toggle('is-done', tone === 'ok');
    };
    const setMetric = (el: HTMLElement, text: string, cls = '') => {
      el.className = cls;
      bumpText(el, text);
    };
    const applyTexts = (sp: Snap, parts: { pub?: boolean; inc?: boolean; nodes?: boolean; ob?: boolean; metrics?: boolean } = {}) => {
      const all = Object.keys(parts).length === 0;
      if (all || parts.pub) pubBadge.set(sp.pub[0], sp.pub[1]);
      if (all || parts.inc) incBadge.set(sp.inc[0], sp.inc[1]);
      bumpText(judge, sp.judge);
      bumpText(msg, sp.msg);
      msg.dataset.tone = sp.msgTone;
      if (all || parts.ob) {
        bumpText(obStatus, sp.outbox);
        obStatus.dataset.tone = sp.outboxTone;
      }
      if (all || parts.nodes) {
        setNode(topic, sp.topicSub);
        setNode(order, sp.order);
        setNode(noti, sp.noti);
        setNode(product, sp.prod, sp.prodTone);
      }
      if (all || parts.metrics) {
        setMetric(m.sends, String(sp.sends), sp.sends > 1 ? 'is-temp' : '');
        setMetric(m.processed, String(sp.processed));
        setMetric(m.unresolved, String(sp.unresolved), sp.unresolved === 0 ? 'is-zero' : '');
        setMetric(m.rollback, sp.rollback, sp.rollback === '통과' ? 'is-zero' : sp.rollback === '차단' ? 'is-danger' : '');
      }
    };
    const logAll = (sp: Snap) => {
      logger.clear();
      sp.lines.forEach(([text, tone]) => logger.log(text, tone));
    };
    const syncDetails = () => details.forEach((d, i) => { d.textContent = snapshot(i, opts).detail; });

    const pt = {
      obOut: () => (layout === LAYOUTS.narrow ? { x: layout.ob.x + 79, y: layout.ob.y } : { x: layout.ob.x, y: layout.ob.y + 14 }),
      topicIn: () => (layout === LAYOUTS.narrow ? { x: layout.topic.x - layout.topic.w / 2 - 6, y: layout.topic.y } : { x: layout.topic.x, y: layout.topic.y - layout.topic.h / 2 - 6 }),
      topicOut: () => (layout === LAYOUTS.narrow ? { x: layout.topic.x, y: layout.topic.y + layout.topic.h / 2 + 4 } : { x: layout.topic.x + layout.topic.w / 2 + 4, y: layout.topic.y }),
      consumerIn: (b: Box) => (layout === LAYOUTS.narrow ? { x: b.x, y: b.y - b.h / 2 - 6 } : { x: b.x - b.w / 2 - 6, y: b.y }),
    };
    /** 로그 한 줄을 대기 상태로 찍고 잠시 뒤 결과로 바꿉니다. */
    const logStep = async (alive: () => boolean, text: string, tone: Tone) => {
      const done = logger.log(text, 'pending');
      await scene.pause(duration.beat);
      if (!alive()) return false;
      done(text, tone);
      return true;
    };
    const publish = async (alive: () => boolean) => {
      const p = layer.spawn({ label: '메시지', at: pt.obOut() });
      if (!(await p.travel([pt.topicIn()], 640)) || !alive()) return false;
      void p.land(false);
      return true;
    };

    const enter = async (index: number, instant: boolean) => {
      const prev = current;
      current = index;
      const alive = scene.begin();
      layer.clear();
      const sp = snapshot(index, opts);
      const before = snapshot(Math.max(0, index - 1), opts);
      const sequential = !instant && !scene.reduced && (index === prev + 1 || (index === 0 && prev === 6));
      if (!sequential) {
        applyTexts(sp);
        logAll(sp);
        if (instant) scene.set({ ...sp.state });
        else void scene.go({ ...sp.state }, duration.draw);
        return;
      }
      logger.clear();
      if (index === 0) {
        scene.set({ ...sp.state });
        applyTexts(sp);
        bumpText(judge, '사전 확인 중');
        for (const [text, tone] of sp.lines) if (!(await logStep(alive, text, tone))) return;
        bumpText(judge, sp.judge);
        replayClass(card, 'is-ok');
        return;
      }
      if (index === 1) {
        applyTexts(sp, { pub: true, metrics: true });
        bumpText(msg, sp.msg);
        if (!(await logStep(alive, sp.lines[0][0], sp.lines[0][1]))) return;
        await scene.go({ ...sp.state }, duration.fly);
        if (!alive()) return;
        landRing(root, { ...layout.ob, w: 150, h: 20 });
        applyTexts(sp, { ob: true });
        for (const [text, tone] of sp.lines.slice(1)) if (!(await logStep(alive, text, tone))) return;
        return;
      }
      if (index === 2) {
        if (!(await publish(alive))) return;
        setNode(topic, '1회 발행');
        bumpText(m.sends, '1');
        let rest = sp.lines;
        if (opts.saveFail) {
          if (!(await logStep(alive, rest[0][0], rest[0][1]))) return;
          bumpText(obStatus, '저장 실패, PENDING');
          obStatus.dataset.tone = 'danger';
          outbox.flash('is-shaking');
          if (!(await logStep(alive, rest[1][0], rest[1][1]))) return;
          await scene.pause(duration.beat);
          if (!alive() || !(await publish(alive))) return;
          setNode(topic, '2회 발행');
          setMetric(m.sends, '2', 'is-temp');
          if (!(await logStep(alive, rest[2][0], rest[2][1]))) return;
          rest = rest.slice(3);
        } else {
          if (!(await logStep(alive, rest[0][0], rest[0][1]))) return;
          rest = rest.slice(1);
        }
        if (opts.deleted) {
          await scene.go({ ...sp.state }, duration.draw);
          if (!alive()) return;
        }
        applyTexts(sp, { pub: true, ob: true });
        if (!opts.deleted) replayClass(card, 'is-ok');
        for (const [text, tone] of rest) if (!(await logStep(alive, text, tone))) return;
        return;
      }
      if (index === 3) {
        const copies = sp.sends;
        const targets: [NodeView, Box, 'order' | 'noti' | 'product'][] = [[order, layout.order, 'order'], [noti, layout.noti, 'noti'], [product, layout.product, 'product']];
        const runs: Promise<void>[] = [];
        for (let c = 0; c < copies; c += 1) {
          targets.forEach(([node, box, key], k) => {
            runs.push((async () => {
              await scene.pause(c * 520 + k * 120);
              if (!alive()) return;
              const p: Packet = layer.spawn({ label: '메시지', at: pt.topicOut() });
              if (!(await p.travel([pt.consumerIn(box)], 680)) || !alive()) return;
              if (key !== 'product' || c > 0) {
                p.relabel('건너뜀', 'dep');
                node.flash('is-ok');
              } else if (opts.refail) {
                p.relabel('실패', 'danger');
                node.flash('is-shaking');
              } else {
                p.relabel('처리', 'flow');
                node.flash('is-ok');
              }
              void p.fade(700);
            })());
          });
        }
        await Promise.all(runs);
        if (!alive()) return;
        applyTexts(sp, { nodes: true, metrics: true });
        bumpText(msg, sp.msg);
        msg.dataset.tone = sp.msgTone;
        for (const [text, tone] of sp.lines) if (!(await logStep(alive, text, tone))) return;
        return;
      }
      if (index === 4) {
        if (!(await logStep(alive, sp.lines[0][0], sp.lines[0][1]))) return;
        applyTexts(sp, { inc: true, metrics: true });
        replayClass(card, opts.deleted ? 'is-shaking' : 'is-ok');
        return;
      }
      if (index === 5) {
        if (!opts.refail) {
          applyTexts(sp);
          for (const [text, tone] of sp.lines) if (!(await logStep(alive, text, tone))) return;
          return;
        }
        const p = layer.spawn({ label: '재실패', tone: 'danger', at: { x: layout.product.x, y: layout.product.y + layout.product.h / 2 + 4 } });
        setNode(product, sp.prod, sp.prodTone);
        replayClass(product.group, 'is-shaking');
        if (!(await p.travel([{ x: layout.dlq.x, y: layout.dlq.y - layout.dlq.h / 2 - 4 }], 420)) || !alive()) return;
        if (!(await p.travel(layout.toChild, 1100)) || !alive()) return;
        p.relabel('대조 통과', 'flow');
        await scene.pause(duration.beat);
        if (!alive()) return;
        void p.fade(420);
        await scene.go({ ...before.state, child: 1 }, duration.draw);
        if (!alive()) return;
        if (!(await logStep(alive, sp.lines[0][0], sp.lines[0][1]))) return;
        applyTexts(sp);
        if (sp.state.alert) {
          replayClass(card, 'is-shaking');
          await scene.go({ ...sp.state }, duration.move);
          if (!alive()) return;
          if (!(await logStep(alive, sp.lines[1][0], sp.lines[1][1]))) return;
        }
        return;
      }
      // index 6: 롤백 확인. 조건을 한 줄씩 확인하고, 결과를 모르는 요청이 있으면 막혔다가 운영자 전이 뒤 다시 확인합니다.
      applyTexts(before);
      setMetric(m.rollback, '확인 중', '');
      const checks = opts.deleted ? sp.lines.slice(0, 6) : sp.lines;
      for (const [text, tone] of checks) if (!(await logStep(alive, text, tone))) return;
      if (opts.deleted) {
        setMetric(m.rollback, '차단', 'is-danger');
        await scene.pause(duration.read / 2);
        if (!alive()) return;
        if (!(await logStep(alive, sp.lines[6][0], sp.lines[6][1]))) return;
        pubBadge.set(sp.pub[0], sp.pub[1]);
        bumpText(msg, sp.msg);
        msg.dataset.tone = sp.msgTone;
        replayClass(card, 'is-ok');
        if (!(await logStep(alive, sp.lines[7][0], sp.lines[7][1]))) return;
      }
      setMetric(m.rollback, '통과', 'is-zero');
    };

    syncDetails();
    createStepPlayer(demo, {
      dwell: (i) => (i === 6 ? duration.dwellLast + 2400 : i === 3 ? duration.dwell + 2200 : duration.dwell + 1400),
      onStep: (i, instant) => { void enter(i, instant); },
    });

    optButtons.forEach((button) => button.addEventListener('click', () => {
      const key = button.dataset.drsOpt as keyof Opts;
      opts[key] = !opts[key];
      button.setAttribute('aria-pressed', String(opts[key]));
      syncDetails();
      const index = current;
      current = -1;
      void enter(index, false);
    }));

    watchNarrow(stage, (narrow) => {
      layout = LAYOUTS[narrow ? 'narrow' : 'wide'];
      setAttrs(root, { viewBox: `0 0 ${layout.view[0]} ${layout.view[1]}` });
      layer.clear();
      scene.redraw();
    });
  });
</script>

<style is:global>
  [data-blog-demo="dlq-replay-summary"] .db-demo-controls { flex-wrap: wrap; }
  [data-blog-demo="dlq-replay-summary"] .scene-console { min-height: 0; height: 16em; overflow: hidden; }
  /* 이 글은 기호 대신 낱말로 결과를 표시합니다. */
  [data-blog-demo="dlq-replay-summary"] .scene-console li::before { width: 2.4em; content: ""; }
  [data-blog-demo="dlq-replay-summary"] .scene-console li[data-tone="pending"]::before { content: "대기"; }
  [data-blog-demo="dlq-replay-summary"] .scene-console li[data-tone="ok"]::before { content: "통과"; }
  [data-blog-demo="dlq-replay-summary"] .scene-console li[data-tone="fail"]::before { content: "실패"; }
  [data-blog-demo="dlq-replay-summary"] .scene-console li[data-tone="warn"]::before { content: "주의"; }
  [data-blog-demo="dlq-replay-summary"] .drs-metrics { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px 22px; margin: 4px 4px 2px; }
  [data-blog-demo="dlq-replay-summary"] .drs-metrics b.is-temp { color: var(--scene-temp); }
  [data-blog-demo="dlq-replay-summary"] .drs-metrics b.is-danger { color: var(--scene-danger); font-size: 1.4rem; }
  [data-blog-demo="dlq-replay-summary"] .drs-metrics b.is-zero { color: var(--scene-flow-ink); }
  [data-blog-demo="dlq-replay-summary"] [data-m-rollback] { font-size: 1.4rem; }
  [data-blog-demo="dlq-replay-summary"] .drs-card { fill: var(--surface); stroke: color-mix(in srgb, var(--scene-hue-amber) 45%, var(--hairline)); stroke-width: 1.5; transform-box: fill-box; transform-origin: center; }
  [data-blog-demo="dlq-replay-summary"] .drs-card.is-ok { animation: scene-pop 520ms ease-out; }
  [data-blog-demo="dlq-replay-summary"] .drs-card.is-shaking { animation: scene-shake 420ms ease-in-out; }
  [data-blog-demo="dlq-replay-summary"] .drs-judge { fill: var(--slate); font-weight: 700; }
  [data-blog-demo="dlq-replay-summary"] .drs-msg { fill: var(--charcoal); font-weight: 800; transform-box: fill-box; transform-origin: left center; }
  [data-blog-demo="dlq-replay-summary"] .drs-msg[data-tone="temp"] { fill: var(--scene-temp); }
  [data-blog-demo="dlq-replay-summary"] .drs-msg[data-tone="danger"] { fill: var(--scene-danger); }
  [data-blog-demo="dlq-replay-summary"] .drs-msg[data-tone="flow"] { fill: var(--scene-flow-ink); }
  [data-blog-demo="dlq-replay-summary"] .drs-msg.is-bump,
  [data-blog-demo="dlq-replay-summary"] .drs-ob-status.is-bump { animation: scene-pop 420ms ease-out; }
  [data-blog-demo="dlq-replay-summary"] .drs-tree { fill: none; stroke: var(--scene-flow); stroke-width: 2; stroke-linejoin: round; }
  [data-blog-demo="dlq-replay-summary"] .drs-track { fill: none; stroke: color-mix(in srgb, var(--scene-dep) 40%, transparent); stroke-width: 1.5; stroke-dasharray: 2 6; }
  [data-blog-demo="dlq-replay-summary"] .drs-ob-status { fill: var(--slate); font-weight: 800; transform-box: fill-box; transform-origin: center; }
  [data-blog-demo="dlq-replay-summary"] .drs-ob-status[data-tone="flow"] { fill: var(--scene-flow-ink); }
  [data-blog-demo="dlq-replay-summary"] .drs-ob-status[data-tone="danger"] { fill: var(--scene-danger); }
  [data-blog-demo="dlq-replay-summary"] .drs-alert-pill { fill: color-mix(in srgb, var(--scene-temp) 16%, var(--canvas)); stroke: var(--scene-temp); stroke-width: 1.4; }
  [data-blog-demo="dlq-replay-summary"] .drs-alert-text { fill: var(--scene-temp); font-weight: 800; }
</style>
