  [data-blog-demo="dlq-jpa-stale"] .djs-card-body { transform-box: fill-box; transform-origin: center; }
  [data-blog-demo="dlq-jpa-stale"] .djs-card-body.is-shaking { animation: scene-shake 420ms ease-in-out; }
  [data-blog-demo="dlq-jpa-stale"] .djs-card-rect { fill: var(--surface); stroke: var(--hairline); stroke-width: 1.5; }
  [data-blog-demo="dlq-jpa-stale"] .djs-card-name { fill: var(--ink); font-weight: 750; font-size: 12.5px; }
  [data-blog-demo="dlq-jpa-stale"] .djs-card-sub { fill: var(--slate); font-weight: 700; font-size: 10.5px; }
  [data-blog-demo="dlq-jpa-stale"] .djs-card-status { font-family: var(--font-mono); font-size: 13px; font-weight: 800; fill: var(--ink); transform-box: fill-box; transform-origin: center; }
  [data-blog-demo="dlq-jpa-stale"] .djs-card-status.is-bump { animation: scene-pop 420ms ease-out; }
  [data-blog-demo="dlq-jpa-stale"] .djs-card[data-status="OPEN"] .djs-card-status { fill: var(--scene-temp); }
  [data-blog-demo="dlq-jpa-stale"] .djs-card[data-status="RESOLVED"] .djs-card-status { fill: var(--scene-flow-ink); }
  [data-blog-demo="dlq-jpa-stale"] .djs-card[data-status="DISCARDED"] .djs-card-status { fill: var(--scene-danger); }
  [data-blog-demo="dlq-jpa-stale"] .djs-card.is-stale .djs-card-rect { stroke: var(--scene-temp); stroke-dasharray: 5 3; }
  [data-blog-demo="dlq-jpa-stale"] .djs-card.is-stale .djs-card-sub { fill: var(--scene-temp); }
  [data-blog-demo="dlq-jpa-stale"] .djs-card.is-detached .djs-card-rect { fill: none; stroke: var(--scene-danger); stroke-dasharray: 4 4; }
  [data-blog-demo="dlq-jpa-stale"] .djs-card.is-detached .djs-card-sub { fill: var(--scene-danger); }
  [data-blog-demo="dlq-jpa-stale"] .djs-lock { fill: var(--scene-temp); font-weight: 800; }
  [data-blog-demo="dlq-jpa-stale"] .djs-id-rect { fill: var(--surface); stroke: var(--scene-hue-gray); stroke-dasharray: 3 3; }
  [data-blog-demo="dlq-jpa-stale"] .djs-id-text { fill: var(--ink); font-weight: 700; }
</style>
