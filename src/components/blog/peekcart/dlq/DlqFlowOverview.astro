---
/**
 * 공유 토픽 하나를 세 consumer group 이 읽다가 한 group 만 실패했을 때, 재시도와 DLQ 이동, 원장 적재가 이어지는 전체 흐름.
 * 실패한 group 도 다음 메시지로 넘어가 막히지 않는다는 점과, 원장에 기록만 남는다는 점을 보여 줍니다.
 */
import InteractiveDemoFrame from '@/components/blog/shared/InteractiveDemoFrame.astro';
import SceneTimeline from '@/components/blog/shared/SceneTimeline.astro';
import '@/styles/scene.css';

const steps = [
  { name: '메시지 도착', detail: 'Product 실패' },
  { name: '재시도', detail: '1초, 5초, 30초' },
  { name: 'DLQ 로 이동', detail: '.dlq 1건' },
  { name: '다음 메시지', detail: '막히지 않음' },
  { name: '원장 적재', detail: '#1 OPEN' },
];
---

<InteractiveDemoFrame
  demoId="dlq-flow-overview"
  ariaLabel="payment.completed 를 Order, Product, Notification 세 consumer group 이 읽다가 Product 만 실패했을 때, 세 번 재시도한 뒤 payment.completed.dlq 로 옮기고 다음 메시지로 넘어가며, DLQ 의 메시지가 원장에 #1 로 남는 흐름"
  title="DLQ 로 옮겨지기까지"
  description="결제 완료 메시지 하나를 세 서비스가 각자 읽습니다. Product 만 실패할 때 메시지가 어디로 가고, 각 group 의 읽은 위치(offset)가 어떻게 바뀌는지 따라가 보세요."
>
  <div class="scene-stage" data-stage>
    <svg data-graphic viewBox="0 0 560 300" role="img" aria-label="왼쪽에 payment.completed 토픽, 가운데에 Order, Product, Notification 세 소비자, 오른쪽에 payment.completed.dlq 와 Product 원장이 있습니다. 메시지는 세 소비자에게 모두 가고, Order 와 Notification 은 처리해 offset 이 앞으로 갑니다. Product 는 실패한 뒤 1초, 5초, 30초 간격으로 세 번 더 시도하고, 그래도 실패하면 메시지를 .dlq 로 보내고 다음 메시지로 넘어갑니다. .dlq 의 메시지는 원장에 #1 행으로 기록됩니다."></svg>
  </div>
  <SceneTimeline ariaLabel="다섯 단계" steps={steps} />
  <p class="scene-note" data-note role="status"></p>
  <p class="db-demo-disclaimer">흐름을 설명하려고 만든 모형입니다. offset 값과 메시지 두 건은 예시이고, 재시도 간격은 시간을 압축해 보여 줍니다. DLQ 를 읽어 원장에 적재하는 소비자의 세부(어느 서비스가 어떤 행을 가져가는지)와 Payment 의 발행 과정은 그리지 않았습니다.</p>
</InteractiveDemoFrame>

<script>
  import { bumpText, createScene, duration, replayClass, setAttrs, svg, watchNarrow, type Box, type Point } from '@/scripts/blog/scene/core';
  import { createNode, type NodeView } from '@/scripts/blog/scene/parts';
  import { createPacketLayer } from '@/scripts/blog/scene/packets';
  import { createStepPlayer } from '@/scripts/blog/scene/step-player';

  // 독자가 볼 변화: 같은 메시지가 세 group 에 모두 가고, Product 만 실패해 재시도 점 세 개가 차례로 실패로 바뀐다.
  // 그 뒤 메시지는 .dlq 로 옮겨지고 Product 의 offset 도 앞으로 가 다음 메시지를 처리한다. .dlq 의 메시지는 원장에 #1 행으로 남는다.
  type Key = 'order' | 'product' | 'noti';
  type State = { r: number; dlq: number; row: number };
  type Layout = {
    view: [number, number];
    topic: Box; order: Box; product: Box; noti: Box; dlq: Box; ledger: Box;
    dots: Point[]; topicOut: (to: Box) => [Point, Point]; productToDlq: [Point, Point]; dlqToLedger: [Point, Point];
  };
  const LAYOUTS: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 300],
      topic: { x: 76, y: 140, w: 136, h: 46 },
      order: { x: 250, y: 54, w: 124, h: 46 }, product: { x: 250, y: 140, w: 124, h: 46 }, noti: { x: 250, y: 248, w: 124, h: 46 },
      dlq: { x: 462, y: 140, w: 168, h: 46 }, ledger: { x: 462, y: 236, w: 184, h: 72 },
      dots: [{ x: 216, y: 186 }, { x: 250, y: 186 }, { x: 284, y: 186 }],
      topicOut: (to) => [{ x: 150, y: 140 }, { x: to.x - to.w / 2 - 6, y: to.y }],
      productToDlq: [{ x: 318, y: 140 }, { x: 372, y: 140 }],
      dlqToLedger: [{ x: 462, y: 168 }, { x: 462, y: 194 }],
    },
    narrow: {
      view: [360, 430],
      topic: { x: 180, y: 34, w: 190, h: 44 },
      order: { x: 62, y: 128, w: 108, h: 46 }, product: { x: 180, y: 128, w: 108, h: 46 }, noti: { x: 298, y: 128, w: 108, h: 46 },
      dlq: { x: 180, y: 266, w: 220, h: 44 }, ledger: { x: 180, y: 360, w: 240, h: 72 },
      dots: [{ x: 148, y: 176 }, { x: 180, y: 176 }, { x: 212, y: 176 }],
      topicOut: (to) => [{ x: 180, y: 60 }, { x: to.x, y: to.y - to.h / 2 - 6 }],
      productToDlq: [{ x: 226, y: 156 }, { x: 226, y: 238 }],
      dlqToLedger: [{ x: 180, y: 292 }, { x: 180, y: 318 }],
    },
  };
  type Spec = { state: State; subs: Record<Key, string>; tones: Record<Key, '' | 'ok' | 'error' | 'temp'>; note: string };
  const SPECS: Spec[] = [
    { state: { r: 0, dlq: 0, row: 0 },
      subs: { order: 'offset 43', product: '처리 실패', noti: 'offset 43' }, tones: { order: 'ok', product: 'error', noti: 'ok' },
      note: '결제 완료 메시지(offset 42)가 세 group 에 모두 갑니다. Order 와 Notification 은 처리하고 읽은 위치를 43 으로 옮겼지만, <strong>Product 는 실패</strong>했습니다.' },
    { state: { r: 3, dlq: 0, row: 0 },
      subs: { order: 'offset 43', product: '재시도 3번 실패', noti: 'offset 43' }, tones: { order: 'ok', product: 'error', noti: 'ok' },
      note: 'Product 는 1초, 5초, 30초를 기다리며 <strong>세 번 더 시도</strong>했지만 모두 실패했습니다. 그동안 Product 의 offset 은 42 에 머물러 있습니다.' },
    { state: { r: 3, dlq: 1, row: 0 },
      subs: { order: 'offset 43', product: 'offset 43', noti: 'offset 43' }, tones: { order: 'ok', product: 'temp', noti: 'ok' },
      note: '<code>DeadLetterPublishingRecoverer</code> 가 메시지를 <code>payment.completed.dlq</code> 로 보냈습니다. Product 는 이 메시지를 치워 두고 <strong>offset 을 43 으로</strong> 옮깁니다.' },
    { state: { r: 3, dlq: 1, row: 0 },
      subs: { order: 'offset 44', product: 'offset 44', noti: 'offset 44' }, tones: { order: 'ok', product: 'ok', noti: 'ok' },
      note: '다음 메시지(offset 43)는 Product 도 처리했습니다. 실패한 메시지를 옮겨 두었기 때문에 <strong>뒤의 메시지가 막히지 않습니다</strong>.' },
    { state: { r: 3, dlq: 1, row: 1 },
      subs: { order: 'offset 44', product: 'offset 44', noti: 'offset 44' }, tones: { order: 'ok', product: 'ok', noti: 'ok' },
      note: '.dlq 레코드의 헤더에 남은 실패 group 이 Product 라서, Product 가 자기 원장에 <strong>#1</strong> 로 남깁니다. 하지만 결제는 끝났는데 재고 예약은 확정되지 않은 주문이 그대로 남아 있고, 이 메시지를 다시 보내는 기능은 없었습니다.' },
  ];

  document.querySelectorAll<HTMLElement>('[data-blog-demo="dlq-flow-overview"]').forEach((demo) => {
    if (demo.dataset.ready) return;
    demo.dataset.ready = 'true';
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const note = demo.querySelector<HTMLElement>('[data-note]')!;
    let layout = LAYOUTS.wide;
    let current = -1;

    const tracks = Array.from({ length: 5 }, () => svg('path', { class: 'dfo-track' }, root));
    const topic = createNode(root, { label: '토픽', hue: 'var(--scene-hue-gray)', sub: 'payment.completed' });
    const nodes: Record<Key, NodeView> = {
      order: createNode(root, { label: 'Order', hue: 'var(--scene-hue-blue)', sub: 'offset 42' }),
      product: createNode(root, { label: 'Product', hue: 'var(--scene-hue-amber)', sub: 'offset 42' }),
      noti: createNode(root, { label: 'Notification', hue: 'var(--scene-hue-violet)', sub: 'offset 42' }),
    };
    Object.values(nodes).forEach((n) => n.group.classList.add('is-sans-sub'));
    const dlq = createNode(root, { label: 'DLQ 토픽', hue: 'var(--scene-hue-gray)', sub: 'payment.completed.dlq' });
    const dlqCount = svg('text', { class: 'scene-label is-sans dfo-count', 'text-anchor': 'middle' }, root);
    dlqCount.textContent = '메시지 1건';
    const dots = layout.dots.map((_, i) => {
      const g = svg('g', { class: 'dfo-dot' }, root);
      const c = svg('circle', { r: 7 }, g);
      const t = svg('text', { class: 'scene-label is-sans dfo-dot-label', 'text-anchor': 'middle' }, g);
      t.textContent = ['1초', '5초', '30초'][i];
      return { g, c, t };
    });
    const ledger = svg('g', { class: 'dfo-ledger' }, root);
    const ledgerCard = svg('rect', { class: 'dfo-ledger-card', rx: 12 }, ledger);
    const ledgerTitle = svg('text', { class: 'scene-caption' }, ledger);
    ledgerTitle.textContent = 'Product 원장';
    const row = svg('g', { class: 'dfo-row' }, ledger);
    const rowRect = svg('rect', { class: 'dfo-row-rect', rx: 7 }, row);
    const rowText = svg('text', { class: 'scene-label is-sans dfo-row-text' }, row);
    rowText.textContent = '#1 group: Product';
    const rowStatus = svg('text', { class: 'dfo-row-status', 'text-anchor': 'end' }, row);
    rowStatus.textContent = 'OPEN';
    const emptyText = svg('text', { class: 'scene-label is-sans dfo-empty', 'text-anchor': 'middle' }, ledger);
    emptyText.textContent = '아직 행 없음';
    const layer = createPacketLayer(root);

    const scene = createScene<State>({ ...SPECS[0].state }, (s) => {
      const l = layout;
      topic.setBox(l.topic);
      (Object.keys(nodes) as Key[]).forEach((k) => nodes[k].setBox(l[k]));
      dlq.setBox(l.dlq);
      (['order', 'product', 'noti'] as Key[]).forEach((k, i) => {
        const [a, b] = l.topicOut(l[k]);
        setAttrs(tracks[i], { d: `M ${a.x} ${a.y} L ${b.x} ${b.y}` });
      });
      setAttrs(tracks[3], { d: `M ${l.productToDlq[0].x} ${l.productToDlq[0].y} L ${l.productToDlq[1].x} ${l.productToDlq[1].y}` });
      setAttrs(tracks[4], { d: `M ${l.dlqToLedger[0].x} ${l.dlqToLedger[0].y} L ${l.dlqToLedger[1].x} ${l.dlqToLedger[1].y}` });
      dots.forEach((d, i) => {
        const p = l.dots[i];
        setAttrs(d.c, { cx: p.x, cy: p.y + 10 });
        setAttrs(d.t, { x: p.x, y: p.y + 32 });
        const filled = s.r >= i + 1 - 0.01;
        d.g.classList.toggle('is-failed', filled);
      });
      setAttrs(dlqCount, { x: l.dlq.x, y: l.dlq.y - l.dlq.h / 2 - 8, opacity: s.dlq });
      const b = l.ledger;
      setAttrs(ledgerCard, { x: b.x - b.w / 2, y: b.y - b.h / 2, width: b.w, height: b.h });
      setAttrs(ledgerTitle, { x: b.x - b.w / 2 + 14, y: b.y - b.h / 2 + 20 });
      setAttrs(rowRect, { x: b.x - b.w / 2 + 10, y: b.y - 2, width: b.w - 20, height: 26 });
      setAttrs(rowText, { x: b.x - b.w / 2 + 20, y: b.y + 15 });
      setAttrs(rowStatus, { x: b.x + b.w / 2 - 20, y: b.y + 15 });
      setAttrs(emptyText, { x: b.x, y: b.y + 15 });
      row.style.opacity = String(s.row);
      emptyText.style.opacity = String(1 - s.row);
    });

    const say = (html: string) => { note.innerHTML = html; replayClass(note, 'is-entering'); };
    const setNode = (k: Key, sub: string, tone: Spec['tones'][Key]) => {
      const n = nodes[k];
      if (n.group.querySelector('.scene-node-sub')?.textContent !== sub) {
        n.setSub(sub);
        const subEl = n.group.querySelector('.scene-node-sub');
        if (subEl) replayClass(subEl, 'is-bump');
      }
      n.group.classList.toggle('is-error', tone === 'error');
      n.group.classList.toggle('is-done', tone === 'ok');
      n.group.classList.toggle('is-temp', tone === 'temp');
    };
    const apply = (sp: Spec) => {
      (Object.keys(nodes) as Key[]).forEach((k) => setNode(k, sp.subs[k], sp.tones[k]));
      say(sp.note);
    };
    const fanOut = async (alive: () => boolean, label: string, productFails: boolean) => {
      const runs = (['order', 'product', 'noti'] as Key[]).map(async (k, i) => {
        await scene.pause(i * 120);
        if (!alive()) return;
        const [a, b] = layout.topicOut(layout[k]);
        const p = layer.spawn({ label, at: a });
        if (!(await p.travel([b], 640)) || !alive()) return;
        if (k === 'product' && productFails) {
          p.relabel('실패', 'danger');
          replayClass(nodes.product.group, 'is-shaking');
        } else {
          p.relabel('처리', 'flow');
        }
        void p.fade(600);
      });
      await Promise.all(runs);
      return alive();
    };

    const enter = async (index: number, instant: boolean) => {
      const prev = current;
      current = index;
      const alive = scene.begin();
      layer.clear();
      const sp = SPECS[index];
      const sequential = !instant && !scene.reduced && (index === prev + 1 || (index === 0 && prev === SPECS.length - 1));
      if (!sequential) {
        apply(sp);
        bumpText(rowStatus, 'OPEN');
        if (instant) scene.set({ ...sp.state });
        else void scene.go({ ...sp.state }, duration.draw);
        return;
      }
      if (index === 0) {
        scene.set({ r: 0, dlq: 0, row: 0 });
        (Object.keys(nodes) as Key[]).forEach((k) => setNode(k, 'offset 42', ''));
        say('결제 완료 메시지(offset 42)가 토픽에 들어왔습니다.');
        if (!(await fanOut(alive, 'offset 42', true))) return;
        apply(sp);
        return;
      }
      if (index === 1) {
        say('Product 가 다시 시도합니다.');
        for (let i = 1; i <= 3; i += 1) {
          setNode('product', `재시도 ${i}번째`, 'temp');
          const [a, b] = layout.topicOut(layout.product);
          const p = layer.spawn({ label: '재시도', tone: 'temp', at: { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 } });
          if (!(await p.travel([b], 360)) || !alive()) return;
          p.relabel('실패', 'danger');
          replayClass(nodes.product.group, 'is-shaking');
          void p.fade(400);
          await scene.go({ ...sp.state, r: i }, duration.snap);
          if (!alive()) return;
          await scene.pause(duration.beat);
          if (!alive()) return;
        }
        apply(sp);
        return;
      }
      if (index === 2) {
        const [a, b] = layout.productToDlq;
        const p = layer.spawn({ label: '실패한 메시지', tone: 'danger', at: a });
        if (!(await p.travel([b], 560)) || !alive()) return;
        void p.land(false);
        await scene.go({ ...sp.state }, duration.snap);
        if (!alive()) return;
        replayClass(dlq.group, 'is-ok');
        apply(sp);
        return;
      }
      if (index === 3) {
        if (!(await fanOut(alive, 'offset 43', false))) return;
        apply(sp);
        return;
      }
      const [a, b] = layout.dlqToLedger;
      const p = layer.spawn({ label: '적재', at: a });
      if (!(await p.travel([b], 520)) || !alive()) return;
      void p.fade(400);
      await scene.go({ ...sp.state }, duration.draw);
      if (!alive()) return;
      replayClass(row, 'is-landed');
      apply(sp);
    };

    createStepPlayer(demo, {
      dwell: (i) => (i === 1 ? duration.dwell + 3200 : i === SPECS.length - 1 ? duration.dwellLast + 1200 : duration.dwell + 1000),
      onStep: (i, instant) => { void enter(i, instant); },
    });

    watchNarrow(stage, (narrow) => {
      layout = LAYOUTS[narrow ? 'narrow' : 'wide'];
      setAttrs(root, { viewBox: `0 0 ${layout.view[0]} ${layout.view[1]}` });
      layer.clear();
      scene.redraw();
    });
  });
</script>

<style is:global>
  .db-demo[data-blog-demo="dlq-flow-overview"] .scene-note { min-height: 4.2em; }
  [data-blog-demo="dlq-flow-overview"] .dfo-track { fill: none; stroke: color-mix(in srgb, var(--scene-dep) 40%, transparent); stroke-width: 1.5; stroke-dasharray: 2 6; }
  [data-blog-demo="dlq-flow-overview"] .dfo-dot circle { fill: var(--surface); stroke: var(--scene-temp); stroke-width: 1.6; stroke-dasharray: 3 2; transition: fill 240ms ease, stroke 240ms ease; }
  [data-blog-demo="dlq-flow-overview"] .dfo-dot.is-failed circle { fill: var(--scene-danger); stroke: var(--scene-danger); stroke-dasharray: none; }
  [data-blog-demo="dlq-flow-overview"] .dfo-dot-label { fill: var(--slate); font-size: 10px; font-weight: 700; }
  [data-blog-demo="dlq-flow-overview"] .dfo-ledger-card { fill: var(--surface); stroke: color-mix(in srgb, var(--scene-hue-amber) 45%, var(--hairline)); stroke-width: 1.5; }
  [data-blog-demo="dlq-flow-overview"] .dfo-row-rect { fill: var(--canvas); stroke: var(--scene-temp); stroke-width: 1.4; }
  [data-blog-demo="dlq-flow-overview"] .dfo-row { transform-box: fill-box; transform-origin: center; }
  [data-blog-demo="dlq-flow-overview"] .dfo-row.is-landed { animation: scene-pop 520ms ease-out; }
  [data-blog-demo="dlq-flow-overview"] .dfo-row-text { fill: var(--ink); font-weight: 700; }
  [data-blog-demo="dlq-flow-overview"] .dfo-row-status { fill: var(--scene-temp); font-family: var(--font-mono); font-size: 11.5px; font-weight: 800; }
  [data-blog-demo="dlq-flow-overview"] .dfo-count { fill: var(--scene-danger); font-weight: 800; }
  [data-blog-demo="dlq-flow-overview"] .dfo-empty { fill: var(--muted); font-weight: 700; }
  [data-blog-demo="dlq-flow-overview"] .scene-node-sub.is-bump { animation: scene-pop 420ms ease-out; transform-box: fill-box; transform-origin: center; }
</style>
