  [data-blog-demo="same-result-two-checks"] .scene-chip[data-fault="none"][aria-pressed="true"] { border-color: var(--scene-flow); color: var(--scene-flow-ink); background: var(--scene-flow-soft); }
  [data-blog-demo="same-result-two-checks"] .scene-chip[data-fault]:not([data-fault="none"])[aria-pressed="true"] { border-color: var(--scene-danger); color: var(--scene-danger); background: var(--scene-danger-soft); }
  [data-blog-demo="same-result-two-checks"] .srtc-line { stroke: var(--scene-dep); opacity: 0.6; }
