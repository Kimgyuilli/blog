---
import InteractiveDemoFrame from '@/components/blog/shared/InteractiveDemoFrame.astro';
import SceneTimeline from '@/components/blog/shared/SceneTimeline.astro';
import '@/styles/scene.css';

const steps = [
  { name: '시작', detail: 'B 만 있음' },
  { name: 'describe', detail: 'A, C 는 없음' },
  { name: '다른 서비스 구독', detail: 'C 자동 생성' },
  { name: 'createTopics', detail: 'C 는 이미 있음' },
  { name: '증설', detail: 'B 1개에서 3개' },
  { name: 'removeAll', detail: 'A, C 비교 제외' },
  { name: 'config SET', detail: 'B 만 4키' },
];
---

<InteractiveDemoFrame demoId="topic-race-branches" ariaLabel="KafkaAdmin 한 번의 적용에서 토픽 세 개가 서로 다른 경로를 타는 타임라인" title="한 번의 적용에서 C 는 어느 단계에서 빠질까요?" description="payment 의 KafkaAdmin 이 토픽 A, B, C 를 한 번에 적용합니다. B 는 product 컨슈머가 먼저 자동 생성해 두었고, C 는 describe 가 끝난 직후 같은 방식으로 생깁니다. 단계를 따라가며 C 가 어디서 빠지는지 예측해 보고, 토픽을 앱보다 먼저 만들어 둔 경우와 비교해 보세요.">
  <div class="scene-chips" role="group" aria-label="토픽 준비 방식">
    <span class="scene-chips-label">토픽 준비</span>
    <button type="button" class="scene-chip is-plain" data-pre="0" aria-pressed="true">앱이 기동하며 만듦</button>
    <button type="button" class="scene-chip is-plain" data-pre="1" aria-pressed="false">앱보다 먼저 토픽 생성</button>
  </div>
  <SceneTimeline ariaLabel="KafkaAdmin 적용 단계" steps={steps} />
  <div class="scene-stage" data-stage>
    <svg data-graphic role="img" aria-label="왼쪽에 payment 의 KafkaAdmin 이 실행하는 여섯 단계(describe, checkPartitions, createTopics, 증설, removeAll, config SET)가 있고, 실행 중인 줄에 띠가 놓입니다. 아래에는 생성 목록과 config 비교 대상 목록이 있습니다. 오른쪽 브로커에는 토픽 A, B, C 의 파티션과 직접 설정된 키 수가 보이고, 위쪽의 product 컨슈머가 구독하면 브로커가 토픽을 자동 생성합니다."></svg>
  </div>
  <ol class="scene-console" data-console aria-live="polite"></ol>
  <p class="scene-note" data-note role="status"></p>
  <p class="db-demo-disclaimer">토픽 A, B, C 는 예시 이름이고, 선언은 셋 다 파티션 3개에 config 7키입니다. C 의 자동 생성이 describe 와 createTopics 사이에 일어나도록 고정해 그렸고, 그 사이 시간은 재지 않았습니다. 코드 단계는 spring-kafka 3.3.14 바이트코드에서 복원한 요지를 따랐고, 재시도와 timeout 분기, 실제 요청 시간은 그리지 않았습니다. 자동 생성 토픽의 파티션 1개는 Kafka 3.8.1 의 기본값입니다. 로그 줄은 KafkaAdmin 의 문구를 토픽 이름만 바꿔 옮겼고, 로그 수준 INFO 에서 보이는 줄과 보이지 않는 줄을 나눠 표시했습니다. 앱보다 먼저 만든 경우는 파티션 수만 맞춰 만들고 config 는 KafkaAdmin 이 넣는 구성입니다.</p>
</InteractiveDemoFrame>

<script>
  import { bowAt, bumpText, clamp01, createScene, duration, hopLift, setAttrs, svg, watchNarrow, type Point } from '@/scripts/blog/scene/core';
  import { createBoundary, createChip, createCodeList, createExecMarker, createNode, landRing, type Rect } from '@/scripts/blog/scene/parts';
  import { createPacketLayer, type Packet } from '@/scripts/blog/scene/packets';
  import { createConsole } from '@/scripts/blog/scene/console';
  import { createStepPlayer } from '@/scripts/blog/scene/step-player';

  // 독자가 볼 변화: describe 에서 "없음"을 받은 C 는 생성 목록에 들어가고, createTopics 는 이미 생긴 C 에 막혀 튕긴다.
  // 그 뒤 증설과 config SET 은 B 에만 가고, removeAll 이 C 를 비교 대상에서 지운다. C 는 파티션 1개, 키 0개로 남는다.
  // 토픽을 앱보다 먼저 만들면 생성 목록이 비고, 세 토픽 모두 config SET 만 받는다.
  type T = 'A' | 'B' | 'C';
  const TOPICS: T[] = ['A', 'B', 'C'];
  const HUES: Record<T, string> = { A: 'var(--scene-hue-blue)', B: 'var(--scene-hue-amber)', C: 'var(--scene-hue-pink)' };
  const LINES = [
    { text: 'describeTopics(A, B, C)', mono: true },
    { text: 'checkPartitions: 없으면 생성 목록에' },
    { text: 'createTopics(topicsToAdd)', mono: true },
    { text: 'createMissingPartitions: 증설' },
    { text: 'toCheck.removeAll(topicsToAdd)', mono: true },
    { text: 'config 비교 후 다른 키만 SET' },
  ];
  /** 단계마다 실행 띠가 놓이는 줄. -1 이면 아직 시작 전이다. */
  const EXEC = [-1, 1, 1, 2, 3, 4, 5];

  type Topic = { p: number[]; keys: number; add: number; strike: number };
  type State = { exec: number; band: number; topics: Record<T, Topic> };

  const topicAt = (step: number, pre: boolean, t: T): Topic => {
    if (pre) {
      return { p: [1, 1, 1], keys: step >= 6 ? 4 : 0, add: 0, strike: 0 };
    }
    const exists = t === 'B' || (t === 'C' && step >= 2) || (t === 'A' && step >= 3);
    const full = (t === 'A' && step >= 3) || (t === 'B' && step >= 4);
    const keys = t === 'A' && step >= 3 ? 7 : t === 'B' && step >= 6 ? 4 : 0;
    const add = t !== 'B' && step >= 1 ? 1 : 0;
    const strike = t !== 'B' && step >= 5 ? 1 : 0;
    return { p: [exists ? 1 : 0, full ? 1 : 0, full ? 1 : 0], keys, add, strike };
  };
  const stateAt = (step: number, pre: boolean): State => ({
    exec: Math.max(0, EXEC[step]),
    band: step === 0 ? 0 : 1,
    topics: { A: topicAt(step, pre, 'A'), B: topicAt(step, pre, 'B'), C: topicAt(step, pre, 'C') },
  });

  const SUBS: Record<'normal' | 'pre', Record<T, string[]>> = {
    normal: {
      A: ['아직 없음', '아직 없음', '아직 없음', 'KafkaAdmin 이 생성', 'KafkaAdmin 이 생성', 'KafkaAdmin 이 생성', 'KafkaAdmin 이 생성'],
      B: ['product 가 먼저 자동 생성', 'product 가 먼저 자동 생성', 'product 가 먼저 자동 생성', 'product 가 먼저 자동 생성', '파티션 3개로 늘어남', '파티션 3개로 늘어남', '다른 4키만 고쳐짐'],
      C: ['아직 없음', 'describe 결과 없음', 'describe 뒤에 자동 생성', '생성 실패, DEBUG 만', '증설 목록에도 없음', 'config 비교에서 빠짐', '자동 생성 그대로 남음'],
    },
    pre: {
      A: ['배포 전에 생성', '배포 전에 생성', '배포 전에 생성', '배포 전에 생성', '배포 전에 생성', '배포 전에 생성', '다른 4키만 고쳐짐'],
      B: ['배포 전에 생성', '배포 전에 생성', '배포 전에 생성', '배포 전에 생성', '배포 전에 생성', '배포 전에 생성', '다른 4키만 고쳐짐'],
      C: ['배포 전에 생성', '배포 전에 생성', '구독해도 그대로', '배포 전에 생성', '배포 전에 생성', '배포 전에 생성', '다른 4키만 고쳐짐'],
    },
  };
  const DETAILS: Record<'normal' | 'pre', string[]> = {
    normal: ['B 만 있음', 'A, C 는 없음', 'C 자동 생성', 'C 는 이미 있음', 'B 1개에서 3개', 'A, C 비교 제외', 'B 만 4키'],
    pre: ['셋 다 3파티션', '셋 다 있음', '이미 있음', '부르지 않음', '같은 수', '뺄 것 없음', '셋 다 4키'],
  };

  const NOTES: Record<'normal' | 'pre', string[]> = {
    normal: [
      '빈 브로커에서 서비스들이 함께 뜨는 중입니다. product 컨슈머가 먼저 구독한 B 만 브로커 자동 생성으로 있고, 파티션 1개에 직접 설정된 키는 없습니다.',
      'describe 결과 B 는 있고 A, C 는 없습니다. 없는 토픽은 <strong>생성 목록</strong>(topicsToAdd)에 들어갑니다.',
      'describe 가 끝난 직후 product 컨슈머가 C 를 구독합니다. 브로커가 C 를 <strong>자동 생성</strong>합니다. 파티션 1개, config 는 브로커 기본값입니다.',
      'createTopics 로 A 는 config 7키와 파티션 3개로 생깁니다. C 는 이미 있어 <strong>TopicExistsException</strong> 으로 튕기고, KafkaAdmin 은 이것을 DEBUG 로만 남긴 채 다음 단계로 갑니다.',
      '증설은 describe 에 성공한 토픽만 봅니다. B 는 1개에서 3개로 늘고 INFO 로그가 남습니다. C 는 describe 에 실패했으니 이 목록에 없습니다.',
      'config 비교 대상에서 생성 목록에 있던 토픽을 뺍니다. A 는 만들 때 config 를 실었지만, <strong>C 는 아무 config 도 받지 못한 채</strong> 빠집니다.',
      'B 는 선언과 다른 4키만 SET 받습니다. 결과는 A 7키, B 4키, C 0키입니다. C 는 오류 없이 파티션 1개와 브로커 기본값으로 남았고, INFO 로그에는 C 에 대한 줄이 하나도 없습니다.',
    ],
    pre: [
      '앱보다 먼저 A, B, C 를 선언한 파티션 수 3개로 만들어 두었습니다. config 는 아직 브로커 기본값입니다.',
      'describe 결과 셋 다 있습니다. 생성 목록은 <strong>비어 있습니다</strong>.',
      'product 컨슈머가 C 를 구독해도 C 는 이미 있어 자동 생성이 일어나지 않습니다.',
      '생성 목록이 비어 createTopics 를 부르지 않습니다. 경합할 대상이 없습니다.',
      '파티션 수가 선언과 같아 증설도 없습니다. 이미 구독 중인 컨슈머가 새 파티션을 늦게 발견할 일도 없습니다.',
      '생성 목록이 비어 있으니 config 비교 대상에서 빠지는 토픽이 없습니다.',
      '세 토픽 모두 기존 토픽 경로로 다른 4키를 SET 받습니다. config 는 여전히 KafkaAdmin 이 넣고, 생성 주체만 하나로 줄었습니다.',
    ],
  };

  type Row = { card: Rect; name: Point; parts: Point; keys: Point };
  type Layout = {
    view: [number, number]; product: Rect; code: Rect; zone: Rect; rows: Record<T, Row>;
    addLabel: Point; checkLabel: Point; addSlot: (i: number) => Point; checkSlot: (i: number) => Point;
    codeOut: (line: number) => Point; productRoute: (to: Row) => Point[];
  };
  const row = (x: number, w: number, y: number): Row => ({
    card: { x, y: y - 34, w, h: 68 }, name: { x: x + 16, y: y - 12 }, parts: { x: x + w - 96, y: y - 15 }, keys: { x: x + 16, y: y + 24 },
  });
  const LAYOUTS: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 366], product: { x: 420, y: 26, w: 168, h: 44 }, code: { x: 12, y: 52, w: 266, h: 216 },
      zone: { x: 292, y: 52, w: 258, h: 306 },
      rows: { A: row(300, 242, 124), B: row(300, 242, 206), C: row(300, 242, 288) },
      addLabel: { x: 16, y: 300 }, checkLabel: { x: 16, y: 340 },
      addSlot: (i) => ({ x: 160 + i * 50, y: 296 }), checkSlot: (i) => ({ x: 160 + i * 50, y: 336 }),
      codeOut: (line) => ({ x: 282, y: 98 + line * 28 }),
      productRoute: (to) => [{ x: 504, y: 30 }, { x: 554, y: 30 }, { x: 554, y: to.card.y + 20 }, { x: to.card.x + to.card.w - 30, y: to.card.y + 20 }],
    },
    narrow: {
      view: [360, 662], product: { x: 180, y: 25, w: 180, h: 44 }, code: { x: 8, y: 50, w: 344, h: 216 },
      zone: { x: 8, y: 362, w: 344, h: 294 },
      rows: { A: row(16, 328, 430), B: row(16, 328, 510), C: row(16, 328, 590) },
      addLabel: { x: 12, y: 300 }, checkLabel: { x: 12, y: 340 },
      addSlot: (i) => ({ x: 194 + i * 52, y: 296 }), checkSlot: (i) => ({ x: 194 + i * 52, y: 336 }),
      codeOut: () => ({ x: 180, y: 270 }),
      productRoute: (to) => [{ x: 270, y: 30 }, { x: 354, y: 30 }, { x: 354, y: to.card.y + 20 }, { x: to.card.x + to.card.w - 30, y: to.card.y + 20 }],
    },
  };

  document.querySelectorAll<HTMLElement>('[data-blog-demo="topic-race-branches"]').forEach((demo) => {
    if (demo.dataset.ready) return;
    demo.dataset.ready = 'true';
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const note = demo.querySelector<HTMLElement>('[data-note]')!;
    const consoleView = createConsole(demo.querySelector<HTMLOListElement>('[data-console]')!, 'payment 서비스 로그 (로그 수준 INFO)');
    const preButtons = [...demo.querySelectorAll<HTMLButtonElement>('[data-pre]')];
    const stepDetails = [...demo.querySelectorAll<HTMLElement>('[data-step] small')];
    let layout = LAYOUTS.wide;
    let pre = false;
    let current = 0;

    const zone = createBoundary(root, '브로커 (자동 생성 켜짐)', 'boundary');
    const code = createCodeList(root, { caption: 'payment 의 KafkaAdmin', hue: 'var(--scene-hue-violet)', lines: LINES });
    const exec = createExecMarker(root);
    // 실행 띠는 코드 목록의 틀 위, 글자 아래에 둔다.
    code.group.insertBefore(exec.group, code.group.firstChild!.nextSibling);
    const product = createNode(root, { label: 'product 컨슈머', hue: 'var(--scene-hue-cyan)' });
    product.group.classList.add('is-sans-sub');
    const addLabel = svg('text', { class: 'scene-label is-sans scene-label-dep' }, root);
    addLabel.textContent = '생성 목록';
    const checkLabel = svg('text', { class: 'scene-label is-sans scene-label-dep' }, root);
    checkLabel.textContent = 'config 비교 대상';
    const addTray = svg('rect', { class: 'trb-tray', rx: 8 }, root);
    const checkTray = svg('rect', { class: 'trb-tray', rx: 8 }, root);

    type RowView = { card: SVGRectElement; name: SVGTextElement; sub: SVGTextElement; keys: SVGTextElement; slots: SVGGElement[] };
    const rowViews = {} as Record<T, RowView>;
    TOPICS.forEach((t) => {
      const g = svg('g', { class: 'trb-row' }, root);
      g.style.setProperty('--node-hue', HUES[t]);
      const card = svg('rect', { class: 'trb-card', rx: 10 }, g);
      const name = svg('text', { class: 'trb-name' }, g);
      name.textContent = `토픽 ${t}`;
      const sub = svg('text', { class: 'trb-sub' }, g);
      const keys = svg('text', { class: 'trb-keys' }, g);
      const slots = [0, 1, 2].map((i) => {
        const slot = svg('g', { class: 'trb-slot' }, g);
        svg('rect', { class: 'trb-slot-box', rx: 4, width: 26, height: 20, x: -13, y: -10 }, slot);
        const label = svg('text', { class: 'trb-slot-text', y: 3.8 }, slot);
        label.textContent = `p${i}`;
        return slot;
      });
      rowViews[t] = { card, name, sub, keys, slots };
    });
    const addChips = TOPICS.map((t) => createChip(root, { label: t, hue: HUES[t], width: 38 }));
    const checkChips = TOPICS.map((t) => createChip(root, { label: t, hue: HUES[t], width: 38 }));
    const strikes = TOPICS.map(() => svg('line', { class: 'scene-strike' }, root));
    const packets = createPacketLayer(root);

    const scene = createScene<State>(stateAt(0, false), (s) => {
      const l = layout;
      zone.place(l.zone);
      code.place(l.code, { top: 46, rowH: 28 });
      code.setActive(s.band > 0.5 ? Math.round(s.exec) : -1);
      const box = code.row(0);
      const y = code.row(0).y - 3 + s.exec * 28;
      exec.place({ ...box, y }, [{ x: box.x - box.w / 2 - 2, y }], clamp01(s.band));
      product.setBox({ x: l.product.x, y: l.product.y, w: l.product.w, h: l.product.h });
      setAttrs(addLabel, { x: l.addLabel.x, y: l.addLabel.y + 4 });
      setAttrs(checkLabel, { x: l.checkLabel.x, y: l.checkLabel.y + 4 });
      const first = l.addSlot(0);
      setAttrs(addTray, { x: first.x - 26, y: first.y - 15, width: 152, height: 30 });
      const firstCheck = l.checkSlot(0);
      setAttrs(checkTray, { x: firstCheck.x - 26, y: firstCheck.y - 15, width: 152, height: 30 });
      TOPICS.forEach((t, i) => {
        const topic = s.topics[t];
        const r = l.rows[t];
        const view = rowViews[t];
        setAttrs(view.card, { x: r.card.x, y: r.card.y, width: r.card.w, height: r.card.h });
        setAttrs(view.name, { x: r.name.x, y: r.name.y });
        setAttrs(view.sub, { x: r.name.x, y: r.name.y + 19 });
        setAttrs(view.keys, { x: r.keys.x, y: r.keys.y });
        const exists = topic.p[0];
        view.card.style.opacity = String(0.35 + 0.65 * exists);
        view.name.style.opacity = String(0.45 + 0.55 * exists);
        bumpText(view.keys, exists > 0.5 ? `직접 설정된 키 ${Math.round(topic.keys)}` : '토픽 없음');
        view.slots.forEach((slot, k) => {
          const on = clamp01(topic.p[k]);
          setAttrs(slot, { transform: `translate(${r.parts.x + k * 32} ${r.parts.y}) scale(${0.7 + 0.3 * on})` });
          slot.classList.toggle('is-on', on > 0.5);
        });
        // 생성 목록 칩: describe 줄에서 날아와 자리를 잡는다.
        const from = { x: l.code.x + 150, y: code.row(1).y };
        const to = l.addSlot(i);
        const a = clamp01(topic.add);
        addChips[i].place(a > 0 ? bowAt(from, to, a, hopLift(a, 30)) : to, a);
        checkChips[i].place(l.checkSlot(i), 1 - 0.55 * topic.strike);
        const c = l.checkSlot(i);
        setAttrs(strikes[i], { x1: c.x - 20, y1: c.y, x2: c.x - 20 + 40 * topic.strike, y2: c.y, opacity: topic.strike > 0.01 ? 1 : 0 });
      });
    });

    const setRowText = (step: number, flagC: boolean) => {
      const mode = pre ? 'pre' : 'normal';
      TOPICS.forEach((t) => {
        rowViews[t].sub.textContent = SUBS[mode][t][step];
        rowViews[t].card.parentElement!.classList.toggle('is-error', flagC && t === 'C');
        rowViews[t].card.parentElement!.classList.toggle('is-done', step === 6 && (pre || t !== 'C'));
      });
      product.setSub(step >= 2 ? (pre ? 'C 구독, 이미 있음' : 'C 구독') : 'B 구독');
    };
    const logsFor = (step: number) => {
      consoleView.reset();
      if (pre) {
        if (step >= 3) consoleView.log('생성 목록이 비어 createTopics 를 부르지 않음', 'step');
        return;
      }
      if (step >= 3) {
        consoleView.log('DEBUG Failed to create topics (TopicExistsException): INFO 수준에서는 출력되지 않음', 'step');
        const last = demo.querySelector<HTMLElement>('[data-console] li:last-child');
        last?.setAttribute('data-level', 'debug');
      }
      if (step >= 4) consoleView.log("INFO Topic 'B' exists but has a different partition count: 1 not 3, increasing if the broker supports it", 'step');
    };
    const finish = (step: number) => {
      setRowText(step, !pre && step >= 3);
      logsFor(step);
      note.innerHTML = NOTES[pre ? 'pre' : 'normal'][step];
      note.classList.toggle('is-alert', !pre && (step === 3 || step === 5 || step === 6));
    };

    const rowIn = (t: T): Point => {
      const r = layout.rows[t];
      return { x: r.card.x + 70, y: r.card.y + 34 };
    };
    const send = async (label: string, from: Point, to: Point, tone: 'dep' | 'flow' | 'danger' | 'temp' = 'dep'): Promise<Packet | undefined> => {
      const p = packets.spawn({ label, tone, at: from });
      const mid = layout === LAYOUTS.wide ? { x: (from.x + to.x) / 2 + 6, y: to.y } : { x: from.x, y: to.y - 40 };
      const ok = await p.travel([from, { x: mid.x, y: from.y }, mid, to], duration.move);
      if (!ok) return undefined;
      return p;
    };

    /** 한 단계 앞으로 갈 때만 패킷을 흘린다. 그 밖의 이동은 상태만 보간한다. */
    const animate = async (step: number) => {
      const alive = scene.begin();
      packets.clear();
      const target = stateAt(step, pre);
      const prev = stateAt(step - 1, pre);
      const out = layout.codeOut(EXEC[step] < 0 ? 0 : EXEC[step]);
      if (step === 1) {
        await scene.go({ ...prev, exec: 0, band: 1 }, duration.snap);
        if (!alive()) return;
        const trips = TOPICS.map(async (t, i) => {
          await scene.pause(i * 90);
          const p = await send('describe', layout.codeOut(0), rowIn(t));
          if (!p || !alive()) return false;
          const there = pre || t === 'B';
          p.relabel(there ? (pre ? '있음, 3개' : '있음, 1개') : '없음', there ? 'flow' : 'temp');
          await scene.pause(duration.beat);
          if (!alive()) return false;
          const back = await p.travel([layout.codeOut(0)], duration.move * 0.8);
          if (back) p.remove();
          return back;
        });
        if ((await Promise.all(trips)).some((ok) => !ok) || !alive()) return;
        await scene.go(target, duration.fly);
      } else if (step === 2) {
        const r = layout.rows.C;
        const p = packets.spawn({ label: 'metadata 요청', tone: 'dep', at: layout.productRoute(r)[0] });
        if (!(await p.travel(layout.productRoute(r), duration.draw)) || !alive()) return;
        if (pre) {
          p.relabel('이미 있음', 'flow');
          await scene.pause(duration.beat);
          if (!alive()) return;
          await p.fade();
          await scene.go(target, duration.snap);
        } else {
          p.relabel('자동 생성', 'temp');
          await p.land(false);
          if (!alive()) return;
          await scene.go(target, duration.draw);
          landRing(root, { x: r.parts.x, y: r.parts.y, w: 30, h: 24 });
        }
      } else if (step === 3) {
        await scene.go({ ...prev, exec: 2 }, duration.move);
        if (!alive()) return;
        if (!pre) {
          const toA = (async () => {
            const p = await send('생성, 7키', out, rowIn('A'), 'flow');
            if (!p || !alive()) return false;
            await p.land(false);
            return true;
          })();
          const toC = (async () => {
            await scene.pause(160);
            const p = packets.spawn({ label: '생성', tone: 'dep', at: out });
            const end = rowIn('C');
            const mid = layout === LAYOUTS.wide ? { x: (out.x + end.x) / 2 + 6, y: end.y } : { x: out.x, y: end.y - 40 };
            if (!(await p.travel([out, { x: mid.x, y: out.y }, mid], duration.move)) || !alive()) return false;
            const ok = await p.bounce(end, 34);
            if (!ok || !alive()) return false;
            p.relabel('TopicExistsException', 'danger');
            rowViews.C.card.parentElement!.classList.add('is-error');
            await scene.pause(duration.read * 0.5);
            if (!alive()) return false;
            await p.fade(520);
            return true;
          })();
          if ((await Promise.all([toA, toC])).some((ok) => !ok) || !alive()) return;
        }
        await scene.go(target, duration.draw);
      } else if (step === 4) {
        await scene.go({ ...prev, exec: 3 }, duration.move);
        if (!alive()) return;
        if (!pre) {
          const p = await send('증설 3개', out, rowIn('B'), 'flow');
          if (!p || !alive()) return;
          await p.land(false);
        }
        await scene.go(target, duration.draw);
      } else if (step === 5) {
        await scene.go({ ...prev, exec: 4 }, duration.move);
        if (!alive()) return;
        await scene.go(target, duration.cut);
      } else if (step === 6) {
        await scene.go({ ...prev, exec: 5 }, duration.move);
        if (!alive()) return;
        const targets: T[] = pre ? TOPICS : ['B'];
        const sends = targets.map(async (t, i) => {
          await scene.pause(i * 110);
          const p = await send('4키 SET', out, rowIn(t), 'flow');
          if (!p || !alive()) return false;
          await p.land(false);
          return true;
        });
        if ((await Promise.all(sends)).some((ok) => !ok) || !alive()) return;
        await scene.go(target, duration.draw);
        if (!pre) rowViews.C.card.parentElement!.classList.add('is-shaking');
      } else {
        await scene.go(target, duration.move);
      }
      if (!alive()) return;
      finish(step);
    };

    const show = (step: number, instant: boolean) => {
      const prevStep = current;
      current = step;
      packets.clear();
      if (!instant && !scene.reduced && step === prevStep + 1) {
        // 단계 사이의 설명을 먼저 바꿔 두고, 결과 문구는 움직임이 끝난 뒤 채운다.
        setRowText(prevStep, !pre && prevStep >= 3);
        note.innerHTML = NOTES[pre ? 'pre' : 'normal'][step];
        note.classList.remove('is-alert');
        void animate(step);
        return;
      }
      scene.begin();
      if (instant || scene.reduced) scene.set(stateAt(step, pre));
      else void scene.go(stateAt(step, pre), duration.move);
      finish(step);
    };

    const setPre = (next: boolean) => {
      pre = next;
      preButtons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.pre === '1') === pre)));
      const details = DETAILS[pre ? 'pre' : 'normal'];
      stepDetails.forEach((el, i) => { el.textContent = details[i]; });
      show(current, false);
    };
    preButtons.forEach((b) => b.addEventListener('click', () => setPre(b.dataset.pre === '1')));

    watchNarrow(stage, (narrow) => {
      layout = LAYOUTS[narrow ? 'narrow' : 'wide'];
      setAttrs(root, { viewBox: `0 0 ${layout.view[0]} ${layout.view[1]}` });
      packets.clear();
      scene.begin();
      scene.set(stateAt(current, pre));
      finish(current);
    });

    createStepPlayer(demo, {
      dwell: (i) => (i === 6 ? duration.dwellLast + 1200 : duration.dwell + 1400),
      onStep: (i, instant) => show(i, instant),
    });
  });
</script>

