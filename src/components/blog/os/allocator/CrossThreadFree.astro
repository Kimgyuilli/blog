---
import InteractiveDemoFrame from '@/components/blog/shared/InteractiveDemoFrame.astro';
import DemoControls from '@/components/blog/shared/DemoControls.astro';
import '@/styles/scene.css';
---

<InteractiveDemoFrame demoId="cross-thread-free" ariaLabel="mimalloc page 의 목록 세 개로 다른 스레드가 해제한 블록이 언제 다시 쓰이는지 보는 실험" title="다른 스레드가 해제한 블록은 언제 다시 쓰일까요?" description="Thread A 가 소유한 page 에 목록이 세 개 있습니다. 버튼을 눌러 할당하고 해제하면서 블록이 어느 목록으로 가는지 따라가 보세요.">
  <DemoControls ariaLabel="할당과 해제">
    <button type="button" data-action="alloc">A 가 할당</button>
    <button type="button" data-action="free-a">A 가 해제</button>
    <button type="button" data-action="free-b">B 가 해제</button>
    <button type="button" data-action="reset">처음으로</button>
  </DemoControls>

  <div class="scene-stage" data-stage>
    <svg data-graphic role="img" aria-label="왼쪽에 Thread A 가 사용 중인 블록, 가운데에 A 가 소유한 page 의 free, local_free, thread_free 목록, 오른쪽에 Thread B 가 받은 블록이 있습니다. 블록은 할당하고 해제할 때마다 목록 사이를 옮겨 다닙니다."></svg>
  </div>

  <div class="ctf-readouts" aria-label="이번 실행의 횟수">
    <span>CAS <b data-cas>0번</b></span>
    <span>느린 경로 <b data-slow>0번</b></span>
  </div>
  <ul class="ctf-legend">
    <li><i class="is-used"></i>사용 중인 블록</li>
    <li><i class="is-free"></i>빈 블록 (목록에 있음)</li>
  </ul>
  <p class="scene-note" data-note role="status"></p>
  <p class="db-demo-disclaimer">
    mimalloc 의 page 하나만 그린 단순화 모형입니다. B 가 해제하는 블록은 A 가 할당해 B 에게 넘겨준 블록이라고 가정했습니다. 블록이 모두 쓰일 때 다른 page 를 찾거나 새 page 를 받는 경로, page 가 가득 찼을 때 다른 스레드의 해제가 heap 의 delayed free 목록으로 가는 경로, 메모리 순서와 노드 수명 같은 동기화 세부는 그리지 않았습니다.
  </p>
</InteractiveDemoFrame>

<script>
  import { bumpText, createScene, duration, hopLift, nextHop, setAttrs, svg, watchNarrow, type Point } from '@/scripts/blog/scene/core';
  import { createBoundary, createNode, landRing, type Rect } from '@/scripts/blog/scene/parts';
  import { createPacketLayer } from '@/scripts/blog/scene/packets';

  type Place = 'free' | 'local' | 'thread' | 'a' | 'b';
  const BLOCKS = 5;
  const HUE_A = 'var(--scene-hue-cyan)';
  const HUE_B = 'var(--scene-hue-amber)';
  const LANES: { key: Place; name: string; sub: string }[] = [
    { key: 'free', name: 'free', sub: 'A 가 할당할 때 씀' },
    { key: 'local', name: 'local_free', sub: 'A 가 해제한 블록' },
    { key: 'thread', name: 'thread_free', sub: '다른 스레드가 해제' },
  ];

  type BlockState = { x: number; y: number; used: number; hop: number };
  type State = { blocks: BlockState[] };
  type Layout = {
    view: [number, number];
    a: Point;
    b: Point;
    nodeW: number;
    zoneA: Rect;
    zoneB: Rect;
    page: Rect;
    aSlot: (k: number) => Point;
    bSlot: Point;
    laneY: number[];
    laneX: number;
    slotX: (k: number) => number;
    lift: number;
  };
  const layouts: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 272], a: { x: 66, y: 34 }, b: { x: 494, y: 34 }, nodeW: 112,
      zoneA: { x: 10, y: 70, w: 112, h: 192 }, zoneB: { x: 438, y: 70, w: 112, h: 192 }, page: { x: 134, y: 70, w: 292, h: 192 },
      aSlot: (k) => ({ x: 66, y: 116 + k * 30 }), bSlot: { x: 494, y: 150 },
      laneY: [124, 176, 228], laneX: 148, slotX: (k) => 276 + k * 33, lift: 40,
    },
    narrow: {
      view: [360, 318], a: { x: 90, y: 30 }, b: { x: 270, y: 30 }, nodeW: 120,
      zoneA: { x: 6, y: 58, w: 204, h: 60 }, zoneB: { x: 218, y: 58, w: 136, h: 60 }, page: { x: 6, y: 128, w: 348, h: 182 },
      aSlot: (k) => ({ x: 28 + k * 36, y: 98 }), bSlot: { x: 286, y: 98 },
      laneY: [182, 230, 278], laneX: 18, slotX: (k) => 158 + k * 34, lift: 34,
    },
  };

  document.querySelectorAll<HTMLElement>('[data-blog-demo="cross-thread-free"]').forEach((demo) => {
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const note = demo.querySelector<HTMLElement>('[data-note]')!;
    const casOut = demo.querySelector<HTMLElement>('[data-cas]')!;
    const slowOut = demo.querySelector<HTMLElement>('[data-slow]')!;
    const buttons = {
      alloc: demo.querySelector<HTMLButtonElement>('[data-action="alloc"]')!,
      freeA: demo.querySelector<HTMLButtonElement>('[data-action="free-a"]')!,
      freeB: demo.querySelector<HTMLButtonElement>('[data-action="free-b"]')!,
    };
    let layout = layouts.wide;

    // ── 논리 모형 ──
    let lists: Record<Place, number[]> = { free: [], local: [], thread: [], a: [], b: [] };
    const hops = Array.from({ length: BLOCKS }, () => 0);
    let cas = 0;
    let slow = 0;
    /** B 가 해제한 블록이 A 의 할당에 다시 쓰였는지. 처음 한 번만 짚어 줍니다. */
    let remoteBlocks = new Set<number>();
    const reset = () => {
      lists = { free: [0, 1], local: [], thread: [], a: [2, 3, 4], b: [] };
      cas = 0;
      slow = 0;
      remoteBlocks = new Set();
    };
    reset();

    const where = (id: number): { place: Place; index: number } => {
      for (const place of Object.keys(lists) as Place[]) {
        const index = lists[place].indexOf(id);
        if (index >= 0) return { place, index };
      }
      return { place: 'free', index: 0 };
    };
    const posOf = (id: number): Point => {
      const { place, index } = where(id);
      if (place === 'a') return layout.aSlot(index);
      if (place === 'b') return layout.bSlot;
      const lane = LANES.findIndex((l) => l.key === place);
      return { x: layout.slotX(index), y: layout.laneY[lane] };
    };
    const isUsed = (id: number) => ['a', 'b'].includes(where(id).place);
    const target = (): State => ({
      blocks: Array.from({ length: BLOCKS }, (_, id) => ({ ...posOf(id), used: isUsed(id) ? 1 : 0, hop: hops[id] })),
    });

    // ── 그림 ──
    const zoneA = createBoundary(root, 'A 가 사용 중');
    const zoneB = createBoundary(root, 'B 가 받은 블록');
    const page = createBoundary(root, 'page (Thread A 소유)');
    const threadA = createNode(root, { label: 'Thread A', hue: HUE_A });
    const threadB = createNode(root, { label: 'Thread B', hue: HUE_B });
    const laneViews = LANES.map((lane) => {
      const name = svg('text', { class: 'scene-ctf-lane' }, root);
      name.textContent = lane.name;
      const sub = svg('text', { class: 'scene-label is-sans scene-label-dep' }, root);
      sub.textContent = lane.sub;
      const track = svg('line', { class: 'scene-ctf-track' }, root);
      return { name, sub, track };
    });
    const blockViews = Array.from({ length: BLOCKS }, (_, id) => {
      const group = svg('g', { class: 'scene-alloc-block scene-arena-chunk' }, root);
      group.style.setProperty('--node-hue', HUE_A);
      const free = svg('rect', { class: 'scene-alloc-free', rx: 5, x: -14, y: -11, width: 28, height: 22 }, group);
      const fill = svg('rect', { class: 'scene-alloc-used', rx: 5, x: -14, y: -11, width: 28, height: 22 }, group);
      const text = svg('text', { class: 'scene-arena-chunk-text', y: 3.8 }, group);
      text.textContent = `b${id + 1}`;
      return { group, free, fill };
    });
    const packets = createPacketLayer(root);

    const placeStatic = () => {
      zoneA.place(layout.zoneA, { x: layout.zoneA.x + 12, y: layout.zoneA.y + 18, anchor: 'start' });
      zoneB.place(layout.zoneB, { x: layout.zoneB.x + 12, y: layout.zoneB.y + 18, anchor: 'start' });
      page.place(layout.page, { x: layout.page.x + 14, y: layout.page.y + 22, anchor: 'start' });
      threadA.setBox({ ...layout.a, w: layout.nodeW, h: 38 });
      threadB.setBox({ ...layout.b, w: layout.nodeW, h: 38 });
      laneViews.forEach(({ name, sub, track }, i) => {
        const y = layout.laneY[i];
        setAttrs(name, { x: layout.laneX, y: y - 1 });
        setAttrs(sub, { x: layout.laneX, y: y + 14 });
        setAttrs(track, { x1: layout.slotX(0) - 20, x2: layout.slotX(4) + 20, y1: y, y2: y });
      });
    };

    const scene = createScene<State>(target(), (s) => {
      s.blocks.forEach((b, id) => {
        setAttrs(blockViews[id].group, { transform: `translate(${b.x.toFixed(2)} ${(b.y - hopLift(b.hop, layout.lift)).toFixed(2)})` });
        blockViews[id].fill.setAttribute('opacity', String(b.used));
      });
    });

    const say = (html: string, alert = false) => {
      note.classList.toggle('is-alert', alert);
      note.innerHTML = html;
    };
    const syncCounts = () => {
      bumpText(casOut, `${cas}번`);
      bumpText(slowOut, `${slow}번`);
    };
    const hint = (next?: keyof typeof buttons) => {
      Object.entries(buttons).forEach(([key, button]) => {
        if (key === next) button.setAttribute('data-state', 'next');
        else button.removeAttribute('data-state');
      });
    };
    const interrupt = () => {
      const alive = scene.begin();
      packets.clear();
      return alive;
    };
    /** 블록을 다른 목록으로 옮기고 착지 링을 그립니다. */
    const move = async (ids: number[], alive: () => boolean, ms = duration.fly) => {
      ids.forEach((id) => { hops[id] = nextHop(hops[id]); });
      if (!(await scene.go(target(), ms)) || !alive()) return false;
      ids.forEach((id) => landRing(root, { ...posOf(id), w: 34, h: 28 }));
      return true;
    };
    const flashTag = (label: string, at: Point) => {
      const tag = packets.spawn({ label, tone: 'flow', at });
      void tag.land(false);
    };
    const name = (id: number) => `b${id + 1}`;

    const alloc = async () => {
      const alive = interrupt();
      if (!lists.free.length) {
        if (!lists.local.length && !lists.thread.length) {
          say('free, local_free, thread_free 가 모두 비었습니다. 실제 mimalloc 은 여기서 다른 page 를 찾거나 새 page 를 받습니다.', true);
          hint('freeB');
          return;
        }
        slow += 1;
        syncCounts();
        // mimalloc 은 thread_free 목록을 local_free 앞에 붙인 뒤 free 로 옮깁니다.
        const moving = [...lists.thread, ...lists.local];
        const fromThread = lists.thread.length;
        say(`free 가 비어 <strong>느린 경로</strong>로 내려갑니다. local_free 와 thread_free 의 블록을 한꺼번에 free 로 옮깁니다.${fromThread ? ' thread_free 는 원자적 교환 한 번으로 목록 전체를 가져옵니다.' : ''}`);
        if (fromThread) flashTag('원자적 교환', { x: layout.slotX(0), y: layout.laneY[2] - 22 });
        lists.free = moving;
        lists.local = [];
        lists.thread = [];
        if (!(await move(moving, alive, duration.fly))) return;
        await scene.pause(duration.beat);
        if (!alive()) return;
      }
      const id = lists.free.shift()!;
      lists.a.push(id);
      if (!(await move([id], alive))) return;
      if (remoteBlocks.has(id)) {
        remoteBlocks.delete(id);
        say(`B 가 해제했던 ${name(id)} 가 이제야 A 의 할당에 쓰였습니다. free 가 빈 뒤 느린 경로에서 한꺼번에 옮겨 왔기 때문입니다.`);
        hint();
        return;
      }
      const waiting = lists.thread.length;
      say(`A 가 free 맨 앞의 ${name(id)} 를 가져갔습니다. 소유 스레드만 고치는 목록이라 원자적 연산이 필요 없습니다.${waiting ? ` thread_free 의 블록 ${waiting}개는 아직 그대로입니다.` : ''}`);
      hint(lists.free.length || lists.local.length || lists.thread.length ? 'alloc' : 'freeB');
    };

    const freeA = async () => {
      const alive = interrupt();
      if (!lists.a.length) {
        say('A 가 사용 중인 블록이 없습니다. 먼저 할당해 보세요.');
        hint('alloc');
        return;
      }
      const id = lists.a.pop()!;
      lists.local.push(id);
      say(`A 가 자기 page 의 ${name(id)} 를 해제해 local_free 에 넣었습니다. 소유 스레드의 해제라 원자적 연산이 필요 없습니다.`);
      if (!(await move([id], alive))) return;
      hint('alloc');
    };

    const freeB = async () => {
      const alive = interrupt();
      if (!lists.a.length) {
        say('B 에게 넘겨줄 블록이 없습니다. A 가 먼저 할당해야 합니다.');
        hint('alloc');
        return;
      }
      const id = lists.a.shift()!;
      lists.b = [id];
      say(`A 가 ${name(id)} 를 B 에게 넘겼습니다. B 가 이 블록을 해제합니다.`);
      if (!(await move([id], alive))) return;
      await scene.pause(duration.beat);
      if (!alive()) return;
      lists.b = [];
      lists.thread.push(id);
      remoteBlocks.add(id);
      if (!(await move([id], alive))) return;
      cas += 1;
      syncCounts();
      flashTag('CAS', { ...posOf(id), y: posOf(id).y - 24 });
      say(`B 는 A 의 free 를 직접 고칠 수 없어서 ${name(id)} 를 <strong>thread_free 에 CAS 로</strong> 넣었습니다. A 의 다음 할당은 이 블록을 쓸까요?`);
      hint('alloc');
    };

    const restart = () => {
      interrupt();
      const before = Array.from({ length: BLOCKS }, (_, id) => where(id).place);
      reset();
      before.forEach((place, id) => { if (where(id).place !== place) hops[id] = nextHop(hops[id]); });
      syncCounts();
      say('A 의 page 에서 free 에 빈 블록 두 개가 있고, A 가 블록 세 개를 쓰고 있습니다. B 가 블록 하나를 해제하면 A 의 다음 할당은 그 블록을 쓸까요?');
      hint('freeB');
      void scene.go(target(), duration.move);
    };

    // 블록이 두 목록을 거쳐 가는 동작이 있어서, 끝날 때까지 다음 버튼을 받지 않습니다.
    let busy = false;
    const lock = (action: () => Promise<void>) => async () => {
      if (busy) return;
      busy = true;
      Object.values(buttons).forEach((b) => b.setAttribute('aria-disabled', 'true'));
      try { await action(); } finally {
        busy = false;
        Object.values(buttons).forEach((b) => b.removeAttribute('aria-disabled'));
      }
    };
    buttons.alloc.addEventListener('click', lock(alloc));
    buttons.freeA.addEventListener('click', lock(freeA));
    buttons.freeB.addEventListener('click', lock(freeB));
    demo.querySelector('[data-action="reset"]')!.addEventListener('click', restart);

    const applyLayout = () => {
      setAttrs(root, { viewBox: `0 0 ${layout.view[0]} ${layout.view[1]}` });
      interrupt();
      placeStatic();
      scene.set(target());
    };
    watchNarrow(stage, (narrow) => { layout = layouts[narrow ? 'narrow' : 'wide']; applyLayout(); });
    applyLayout();
    restart();
  });
</script>

<style>
  .ctf-readouts { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 12px 2px 0; color: var(--slate); font-size: 0.8rem; }
  .ctf-readouts span { display: inline-flex; align-items: baseline; gap: 6px; }
  .ctf-readouts b { display: inline-block; color: var(--ink); font-variant-numeric: tabular-nums; font-size: 1rem; }
  .ctf-readouts b:global(.is-bump) { animation: scene-pop 420ms ease-out; }
  .ctf-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 8px 2px 0; padding: 0; color: var(--slate); font-size: 0.76rem; list-style: none; }
  .ctf-legend li { display: inline-flex; align-items: center; gap: 7px; margin: 0; }
  .ctf-legend i { display: inline-block; width: 20px; height: 12px; border-radius: 3px; }
  .ctf-legend i.is-used { background: color-mix(in srgb, var(--scene-hue-cyan) 58%, var(--surface)); border: 1px solid var(--scene-hue-cyan); }
  .ctf-legend i.is-free { border: 1.5px dashed var(--scene-temp); background: color-mix(in srgb, var(--scene-temp) 10%, transparent); }

  @media (prefers-reduced-motion: reduce) {
    .ctf-readouts b:global(.is-bump) { animation: none; }
  }
</style>
