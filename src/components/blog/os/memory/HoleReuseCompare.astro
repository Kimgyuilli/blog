---
import InteractiveDemoFrame from '@/components/blog/shared/InteractiveDemoFrame.astro';
import DemoControls from '@/components/blog/shared/DemoControls.astro';
import '@/styles/scene.css';
---

<InteractiveDemoFrame demoId="hole-reuse-compare" ariaLabel="같은 빈 공간에 같은 요청을 보낼 때 glibc 방식과 jemalloc 방식의 재사용 비교" title="빈 공간 6KB에 요청 6KB가 들어갈까요?" description="두 할당자에 같은 블록 8개를 할당한 뒤 같은 블록 4개를 해제한 상태입니다. 양쪽 모두 빈 공간이 6KB 있습니다. 1KB, 1KB, 2KB, 2KB 요청을 보내 보세요.">
  <DemoControls ariaLabel="요청 보내기">
    <button type="button" data-run>요청 네 개 보내기</button>
    <button type="button" data-reset>처음으로</button>
  </DemoControls>
  <div class="scene-stage" data-stage>
    <svg data-graphic role="img" aria-label="왼쪽 glibc 방식은 1KB와 2KB 블록이 한 페이지에 섞여 있고, 오른쪽 jemalloc 방식은 1KB slab과 2KB slab이 따로 있습니다. 같은 요청을 보내면 glibc 방식은 1KB 요청이 2KB free chunk를 차지해 마지막 2KB 요청이 들어갈 자리가 없어 새 페이지를 받고, jemalloc 방식은 요청마다 같은 크기의 빈 region을 다시 써서 새 페이지가 필요 없습니다."></svg>
  </div>
  <div class="reuse-readouts" aria-label="RSS">
    <span><i class="is-one"></i>1KB 블록</span>
    <span><i class="is-two"></i>2KB 블록</span>
    <span>glibc 방식 RSS <b data-rss="g">12KB</b></span>
    <span>jemalloc 방식 RSS <b data-rss="j">12KB</b></span>
  </div>
  <p class="scene-note" data-note role="status"></p>
  <p class="db-demo-disclaimer">페이지 4KB, 블록 1KB와 2KB로 단순화한 모형입니다. 두 쪽 모두 같은 순서로 2KB, 1KB, 2KB, 1KB, 2KB, 1KB, 2KB, 1KB 블록을 할당한 뒤 첫 번째와 세 번째 2KB, 두 번째와 세 번째 1KB를 해제했습니다. glibc 방식은 낮은 주소부터 처음 맞는 free chunk에 넣고, jemalloc 방식은 같은 size class의 slab에서 낮은 주소부터 넣습니다. 실제 jemalloc의 size class는 1KB와 2KB 사이에도 여러 개 있을 만큼 촘촘하고, 실제 할당자는 bin과 캐시 등 훨씬 복잡합니다.</p>
</InteractiveDemoFrame>

<script>
  import { bumpText, createScene, duration, setAttrs, svg, watchNarrow, type Point } from '@/scripts/blog/scene/core';
  import { createBoundary, landRing, type Rect } from '@/scripts/blog/scene/parts';
  import { arcPoints, createPacketLayer, type Packet } from '@/scripts/blog/scene/packets';

  const PAGES = 4;
  const CELLS = 4;
  const PAGE_KB = 4;
  /** 처음 할당하는 블록과, 그중 해제하는 블록 번호. */
  const SETUP: (1 | 2)[] = [2, 1, 2, 1, 2, 1, 2, 1];
  const FREED = [0, 3, 4, 5];
  const REQUESTS: (1 | 2)[] = [1, 1, 2, 2];
  const HUE: Record<1 | 2, string> = { 1: 'var(--scene-hue-blue)', 2: 'var(--scene-hue-violet)' };

  type Side = 'g' | 'j';
  type Model = { kind: (0 | 1 | 2)[]; owner: (number | null)[][]; size: Map<number, 1 | 2>; resident: boolean[] };
  type State = Record<Side, { on: number[]; cells: number[][] }>;

  const emptyModel = (): Model => ({
    kind: [0, 0, 0, 0],
    owner: Array.from({ length: PAGES }, () => Array.from({ length: CELLS }, () => null)),
    size: new Map(),
    resident: [false, false, false, false],
  });

  /** glibc 방식: 낮은 주소부터 같은 페이지 안의 연속된 빈 공간을 찾고, 없으면 heap 맨 위에 페이지를 붙입니다. */
  function fitGlibc(m: Model, size: 1 | 2) {
    for (let p = 0; p < PAGES; p += 1) {
      if (!m.resident[p]) continue;
      for (let c = 0; c + size <= CELLS; c += 1) if (m.owner[p].slice(c, c + size).every((x) => x === null)) return { page: p, cell: c, fresh: false };
    }
    const top = m.resident.lastIndexOf(true) + 1;
    return top < PAGES ? { page: top, cell: 0, fresh: true } : undefined;
  }
  /** jemalloc 방식: 같은 size class의 slab에서 낮은 주소부터 빈 region을 찾고, 없으면 새 slab을 만듭니다. */
  function fitJemalloc(m: Model, size: 1 | 2) {
    for (let p = 0; p < PAGES; p += 1) {
      if (!m.resident[p] || m.kind[p] !== size) continue;
      for (let c = 0; c < CELLS; c += size) if (m.owner[p][c] === null) return { page: p, cell: c, fresh: false };
    }
    const slot = m.resident.indexOf(false);
    return slot >= 0 ? { page: slot, cell: 0, fresh: true } : undefined;
  }
  const fit = (side: Side, m: Model, size: 1 | 2) => (side === 'g' ? fitGlibc(m, size) : fitJemalloc(m, size));
  /** 새 페이지를 받아 옵니다. glibc는 size class 구분이 없고, jemalloc은 요청 크기의 slab이 됩니다. */
  function openPage(m: Model, page: number, size: 1 | 2, side: Side) {
    m.resident[page] = true;
    m.kind[page] = side === 'g' ? 1 : size;
  }
  function fill(m: Model, id: number, size: 1 | 2, page: number, cell: number) {
    m.size.set(id, size);
    for (let c = cell; c < cell + size; c += 1) m.owner[page][c] = id;
  }
  /** glibc는 이웃한 free chunk가 합쳐져 하나가 됩니다. 이 위치에서 시작하는 free chunk의 길이를 셉니다. */
  function freeRun(m: Model, page: number, cell: number) {
    let n = 0;
    while (cell + n < CELLS && m.owner[page][cell + n] === null) n += 1;
    return n;
  }

  const layouts = {
    wide: {
      view: [560, 214] as [number, number],
      panels: { g: { x: 8, y: 30, w: 268, h: 172 }, j: { x: 284, y: 30, w: 268, h: 172 } } as Record<Side, Rect>,
      pageW: 118, pageH: 56,
      home: (panel: Rect, p: number): Point => ({ x: panel.x + 72 + (p % 2) * 126, y: panel.y + 54 + Math.floor(p / 2) * 70 }),
    },
    narrow: {
      view: [360, 404] as [number, number],
      panels: { g: { x: 6, y: 30, w: 348, h: 172 }, j: { x: 6, y: 226, w: 348, h: 172 } } as Record<Side, Rect>,
      pageW: 156, pageH: 56,
      home: (panel: Rect, p: number): Point => ({ x: panel.x + 90 + (p % 2) * 168, y: panel.y + 54 + Math.floor(p / 2) * 70 }),
    },
  };
  type Layout = (typeof layouts)['wide'];

  document.querySelectorAll<HTMLElement>('[data-blog-demo="hole-reuse-compare"]').forEach((demo) => {
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const note = demo.querySelector<HTMLElement>('[data-note]')!;
    const runButton = demo.querySelector<HTMLButtonElement>('[data-run]')!;
    const rssOut: Record<Side, HTMLElement> = { g: demo.querySelector('[data-rss="g"]')!, j: demo.querySelector('[data-rss="j"]')! };
    let layout: Layout = layouts.wide;
    let models: Record<Side, Model> = { g: emptyModel(), j: emptyModel() };
    let nextId = 0;
    const tags: Record<Side, string[]> = { g: ['', '', '', ''], j: ['', '', '', ''] };

    const setup = () => {
      models = { g: emptyModel(), j: emptyModel() };
      (['g', 'j'] as Side[]).forEach((side) => {
        const m = models[side];
        SETUP.forEach((size, id) => {
          const spot = fit(side, m, size)!;
          if (spot.fresh) openPage(m, spot.page, size, side);
          fill(m, id, size, spot.page, spot.cell);
        });
        FREED.forEach((id) => m.owner.forEach((row) => row.forEach((o, c) => { if (o === id) row[c] = null; })));
        tags[side] = ['', '', '', ''];
      });
      nextId = SETUP.length;
    };
    setup();
    const rssKb = (side: Side) => models[side].resident.filter(Boolean).length * PAGE_KB;
    const target = (): State => {
      const panel = (side: Side) => ({
        on: models[side].resident.map((r) => (r ? 1 : 0)),
        cells: models[side].owner.map((row) => row.map((o) => (o === null ? 0 : 1))),
      });
      return { g: panel('g'), j: panel('j') };
    };

    // ── 그림 ──
    const panels = (['g', 'j'] as Side[]).map((side) => {
      const box = createBoundary(root, side === 'g' ? 'glibc 방식' : 'jemalloc 방식');
      const slots = Array.from({ length: PAGES }, () => svg('rect', { rx: 9, fill: 'none', stroke: 'var(--hairline)', 'stroke-dasharray': '2 6' }, root));
      const pages = Array.from({ length: PAGES }, (_, p) => {
        const group = svg('g', { class: 'scene-alloc-page' }, root);
        const card = svg('rect', { class: 'scene-alloc-card', rx: 9 }, group);
        const label = svg('text', { class: 'scene-label scene-label-dep' }, group);
        const tag = svg('text', { class: 'scene-label is-sans', 'text-anchor': 'end' }, group);
        const cells = Array.from({ length: CELLS }, () => {
          const g = svg('g', { class: 'scene-alloc-block' }, group);
          g.style.cursor = 'default';
          const free = svg('rect', { class: 'scene-alloc-free', rx: 4 }, g);
          const fill = svg('rect', { class: 'scene-alloc-used', rx: 4 }, g);
          return { g, free, fill };
        });
        return { group, card, label, tag, cells, p };
      });
      return { side, box, slots, pages, packets: createPacketLayer(root) };
    });

    const cellBox = (c: number, size: number) => {
      const { pageW: w, pageH: h } = layout;
      const unit = (w - 16 - 3 * 3) / CELLS;
      return { x: -w / 2 + 8 + c * (unit + 3), y: -h / 2 + 20, width: size * unit + (size - 1) * 3, height: h - 30 };
    };
    const cellCenter = (side: Side, p: number, c: number, size: number): Point => {
      const home = layout.home(layout.panels[side], p);
      const b = cellBox(c, size);
      return { x: home.x + b.x + b.width / 2, y: home.y + b.y + b.height / 2 };
    };

    /** 블록과 빈 공간의 모양(크기에 따른 폭과 색)은 논리 모형이 바뀔 때 맞춥니다. */
    const sync = () => {
      panels.forEach(({ side, box, slots, pages }) => {
        const m = models[side];
        const rect = layout.panels[side];
        box.place(rect, { x: rect.x + 12, y: rect.y - 8, anchor: 'start' });
        const { pageW: w, pageH: h } = layout;
        slots.forEach((slot, p) => {
          const at = layout.home(rect, p);
          setAttrs(slot, { x: at.x - w / 2, y: at.y - h / 2, width: w, height: h });
        });
        pages.forEach((view) => {
          const p = view.p;
          const at = layout.home(rect, p);
          setAttrs(view.group, { transform: `translate(${at.x} ${at.y})` });
          setAttrs(view.card, { x: -w / 2, y: -h / 2, width: w, height: h });
          setAttrs(view.label, { x: -w / 2 + 8, y: -h / 2 + 13 });
          setAttrs(view.tag, { x: w / 2 - 8, y: -h / 2 + 13 });
          view.label.textContent = side === 'j' && m.kind[p] ? `p${p + 1} ${m.kind[p]}KB slab` : `p${p + 1}`;
          view.tag.textContent = tags[side][p];
          view.tag.style.fill = tags[side][p].includes('새') ? 'var(--scene-danger)' : 'var(--scene-temp)';
          // 블록은 크기만큼, 빈 공간은 glibc면 합쳐진 free chunk의 길이, jemalloc이면 slab의 region 크기로 그립니다.
          view.cells.forEach((cell) => { cell.g.style.display = 'none'; });
          let c = 0;
          while (c < CELLS) {
            const owner = m.owner[p][c];
            const isFree = owner === null;
            const size = !isFree ? m.size.get(owner)! : side === 'g' ? freeRun(m, p, c) : m.kind[p] === 2 ? 2 : 1;
            const cell = view.cells[c];
            cell.g.style.display = '';
            const b = cellBox(c, size);
            setAttrs(cell.free, b);
            setAttrs(cell.fill, b);
            cell.fill.style.setProperty('--node-hue', HUE[(isFree ? 1 : size) as 1 | 2]);
            c += size;
          }
        });
      });
    };

    const scene = createScene<State>(target(), (s) => {
      panels.forEach(({ side, pages }) => {
        pages.forEach((view) => {
          view.group.style.opacity = String(s[side].on[view.p]);
          view.cells.forEach((cell, c) => setAttrs(cell.fill, { opacity: s[side].cells[view.p][c] }));
        });
      });
    });

    const showRss = (bump: boolean) => (['g', 'j'] as Side[]).forEach((side) => {
      const text = `${rssKb(side)}KB`;
      if (bump) bumpText(rssOut[side], text);
      else rssOut[side].textContent = text;
    });
    const say = (html: string, alert = false) => {
      note.classList.toggle('is-alert', alert);
      note.innerHTML = html;
    };
    const clearMisfit = () => panels.forEach(({ pages }) => pages.forEach((view) => view.cells.forEach((cell) => cell.g.classList.remove('is-misfit'))));

    const reset = () => {
      scene.begin();
      panels.forEach(({ packets }) => packets.clear());
      clearMisfit();
      setup();
      sync();
      scene.set(target());
      showRss(false);
      runButton.disabled = false;
      say('두 할당자 모두 직전 작업에서 6KB를 해제했습니다. 빈 공간은 양쪽 모두 <strong>2KB 두 개와 1KB 두 개</strong>입니다. 1KB, 1KB, 2KB, 2KB 요청 6KB를 보내면 새 페이지가 필요할까요?');
    };

    const notes = [
      '첫 1KB 요청: glibc 방식은 낮은 주소의 처음 맞는 free chunk에 넣어 <strong>2KB chunk를 쪼개 씁니다.</strong> jemalloc 방식은 1KB slab의 빈 region에 넣습니다.',
      '두 번째 1KB 요청: glibc 방식은 쪼갠 2KB chunk의 나머지를 씁니다. 원래 있던 1KB free chunk 두 개는 그대로 남습니다. jemalloc 방식은 1KB region을 하나 더 채웁니다.',
      '첫 2KB 요청: 양쪽 모두 남은 2KB 빈 공간에 들어갑니다.',
    ];

    /** 한 요청을 한쪽 할당자에 보냅니다. 들어갈 자리가 없으면 남은 조각에 부딪힌 뒤 새 페이지로 갑니다. */
    const send = async (side: Side, size: 1 | 2, id: number, alive: () => boolean) => {
      const panel = panels.find((x) => x.side === side)!;
      const m = models[side];
      const rect = layout.panels[side];
      const packet: Packet = panel.packets.spawn({ label: `${size}KB`, at: { x: rect.x + rect.w - 40, y: rect.y - 8 } });
      const spot = fit(side, m, size)!;
      if (spot.fresh) {
        const holes: { p: number; c: number }[] = [];
        m.owner.forEach((row, p) => { if (m.resident[p]) row.forEach((o, c) => { if (o === null) holes.push({ p, c }); }); });
        if (holes.length) {
          if (!(await packet.bounce(cellCenter(side, holes[0].p, holes[0].c, 1), 28)) || !alive()) return false;
          holes.forEach(({ p, c }) => panel.pages[p].cells[c].g.classList.add('is-misfit'));
          await scene.pause(duration.beat);
          if (!alive()) return false;
        }
        openPage(m, spot.page, size, side);
        tags[side][spot.page] = '새 페이지';
        sync();
        if (!(await scene.go(target(), duration.draw)) || !alive()) return false;
        landRing(root, { ...layout.home(rect, spot.page), w: layout.pageW + 6, h: layout.pageH + 6 });
        showRss(true);
        packet.relabel(`${size}KB`, 'dep');
      } else if (side === 'g' && freeRun(m, spot.page, spot.cell) > size) {
        tags.g[spot.page] = '2KB chunk를 쪼갬';
      }
      if (!(await packet.travel(arcPoints(packet.at, cellCenter(side, spot.page, spot.cell, size), 24), duration.fly)) || !alive()) return false;
      fill(m, id, size, spot.page, spot.cell);
      void packet.fade(duration.reflow);
      return true;
    };

    const run = async () => {
      const alive = scene.begin();
      runButton.disabled = true;
      for (let i = 0; i < REQUESTS.length; i += 1) {
        const id = nextId++;
        say(notes[i] ?? '두 번째 2KB 요청을 보냅니다…');
        const results = await Promise.all((['g', 'j'] as Side[]).map((side) => send(side, REQUESTS[i], id, alive)));
        if (!alive() || results.includes(false)) return;
        sync();
        if (!(await scene.go(target(), duration.reflow)) || !alive()) return;
        if (i < REQUESTS.length - 1) {
          await scene.pause(duration.read);
          if (!alive()) return;
        }
      }
      clearMisfit();
      sync();
      say(`해제한 6KB와 새 요청 6KB는 같은 양입니다. glibc 방식은 1KB 요청이 2KB free chunk를 차지해 1KB 조각 두 개만 남았고, 마지막 2KB가 들어가지 못해 새 페이지를 받아 <strong>RSS가 ${rssKb('g')}KB</strong>가 됐습니다. jemalloc 방식은 요청마다 같은 크기의 빈 region을 다시 써서 <strong>RSS가 ${rssKb('j')}KB 그대로</strong>입니다.`, true);
    };

    runButton.addEventListener('click', () => { void run(); });
    demo.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click', reset);

    const applyLayout = () => {
      setAttrs(root, { viewBox: `0 0 ${layout.view[0]} ${layout.view[1]}` });
      sync();
      scene.redraw();
    };
    watchNarrow(stage, (isNarrow) => {
      layout = layouts[isNarrow ? 'narrow' : 'wide'];
      applyLayout();
    });
    reset();
    applyLayout();
  });
</script>

<style>
  .reuse-readouts { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 12px 2px 0; color: var(--slate); font-size: 0.8rem; }
  .reuse-readouts span { display: inline-flex; align-items: baseline; gap: 6px; }
  .reuse-readouts i { display: inline-block; width: 12px; height: 10px; border-radius: 3px; align-self: center; }
  .reuse-readouts i.is-one { background: color-mix(in srgb, var(--scene-hue-blue) 58%, var(--surface)); border: 1px solid var(--scene-hue-blue); }
  .reuse-readouts i.is-two { background: color-mix(in srgb, var(--scene-hue-violet) 58%, var(--surface)); border: 1px solid var(--scene-hue-violet); }
  .reuse-readouts b { display: inline-block; color: var(--ink); font-variant-numeric: tabular-nums; font-size: 1rem; }
  .reuse-readouts b:global(.is-bump) { animation: scene-pop 420ms ease-out; }

  @media (prefers-reduced-motion: reduce) {
    .reuse-readouts b:global(.is-bump) { animation: none; }
  }
</style>
