---
import '@/styles/scene.css';
import '@/styles/database-demos.css';

type Kind = 'page-mapping' | 'shared-host';
type Props = { kind: Kind };
const { kind } = Astro.props;

const COPY: Record<Kind, { label: string; caption: string }> = {
  'page-mapping': {
    label: '가상 메모리의 VPN 0, 1, 2 가 물리 메모리의 PFN 3, 5, 6 으로 연결됩니다. PFN 4 는 다른 프로세스가 쓰는 프레임입니다.',
    caption: '연속된 가상 페이지가 물리 메모리에서는 떨어진 프레임에 놓입니다. 프레임 번호는 설명을 위해 정한 값입니다.',
  },
  'shared-host': {
    label: '한 Linux 호스트에서 Spring Boot, PostgreSQL, Worker 컨테이너가 RAM 을 한도만큼 나눠 쓰고, 디스크 하나를 함께 씁니다. Worker 의 swap I/O 와 PostgreSQL 의 데이터 I/O 가 같은 디스크로 갑니다.',
    caption: '컨테이너별 한도는 RAM 과 swap 의 양을 나눕니다. 디스크는 나뉘지 않아서 한 컨테이너의 swap I/O 가 다른 컨테이너의 I/O 와 겹칩니다.',
  },
};
const copy = COPY[kind];
---

<figure class="db-demo swap-figure" data-blog-demo="swap-figure" data-kind={kind} aria-label={copy.label}>
  <div class="scene-stage" data-stage>
    <svg data-graphic role="img" aria-label={copy.label}></svg>
  </div>
  <figcaption class="db-demo-disclaimer">{copy.caption}</figcaption>
</figure>

<script>
  import { angleOf, setAttrs, svg, watchNarrow, type Point } from '@/scripts/blog/scene/core';
  import { createArrow, createNode } from '@/scripts/blog/scene/parts';

  type Kind = 'page-mapping' | 'shared-host';
  type Tone = 'dep' | 'temp';
  type Anchor = 'start' | 'middle' | 'end';

  // 가상 페이지는 InnoDB 글의 PagingFigure 와 같은 색, 컨테이너는 서로 다른 색을 씁니다.
  const HUE = {
    page: 'var(--scene-hue-violet)',
    other: 'var(--scene-hue-gray)',
    spring: 'var(--scene-hue-blue)',
    postgres: 'var(--scene-hue-cyan)',
    worker: 'var(--scene-hue-pink)',
  };
  const TONE_COLOR: Record<Tone, string> = {
    dep: 'color-mix(in srgb, var(--scene-dep) 70%, var(--hairline))',
    temp: 'var(--scene-temp)',
  };

  /** 그리기 도구. 넓은 배치와 좁은 배치를 바꿀 때마다 svg 를 비우고 다시 그립니다. */
  const tools = (root: SVGSVGElement) => {
    const t = {
      text(x: number, y: number, value: string, cls = 'scene-label is-sans scene-label-dep', anchor: Anchor = 'start') {
        const el = svg('text', { class: cls, x, y, 'text-anchor': anchor }, root);
        el.textContent = value;
        return el;
      },
      /** 색이 찬 칸. `hue`가 칸의 주인이고, 글자는 칸 가운데에 놓입니다. */
      cell(x: number, y: number, w: number, h: number, hue: string, label = '', sans = false) {
        const rect = svg('rect', { class: 'scene-alloc-used', x, y, width: w, height: h, rx: 5 }, root);
        rect.style.setProperty('--node-hue', hue);
        if (label) t.text(x + w / 2, y + h / 2 + 3.8, label, sans ? 'scene-pg-cell-text is-sans' : 'scene-pg-cell-text', 'middle');
        return rect;
      },
      box(x: number, y: number, w: number, h: number, cls = 'scene-alloc-card', rx = 10) {
        return svg('rect', { class: cls, x, y, width: w, height: h, rx }, root);
      },
      /** 꺾인 선 끝에 화살촉을 붙입니다. */
      arrow(points: Point[], tone: Tone = 'dep', dashed = false) {
        const cls = ['scene-pg-line', tone === 'dep' ? '' : `is-${tone}`, dashed ? 'is-dashed' : ''].filter(Boolean).join(' ');
        const tip = points[points.length - 1];
        const angle = angleOf(points[points.length - 2], tip);
        const rad = (angle * Math.PI) / 180;
        const end = { x: tip.x - Math.cos(rad) * 6, y: tip.y - Math.sin(rad) * 6 };
        svg('polyline', { class: cls, points: [...points.slice(0, -1), end].map((p) => `${p.x},${p.y}`).join(' ') }, root);
        createArrow(root, TONE_COLOR[tone])(tip, angle);
      },
      node(label: string, hue: string, x: number, y: number, w: number, h: number, sub = '') {
        const view = createNode(root, { label, hue, sub });
        view.group.classList.add('is-sans-sub');
        view.setBox({ x, y, w, h });
        return view;
      },
    };
    return t;
  };

  const view = (root: SVGSVGElement, w: number, h: number) => setAttrs(root, { viewBox: `0 0 ${w} ${h}` });

  // ── 가상 페이지와 물리 프레임의 매핑 ──
  function drawMapping(root: SVGSVGElement, narrow: boolean) {
    const t = tools(root);
    const W = narrow ? 360 : 560;
    const H = 236;
    view(root, W, H);
    const left = narrow ? { x: 12, w: 100 } : { x: 56, w: 140 };
    const right = narrow ? { x: 216, w: 132 } : { x: 364, w: 140 };
    const cellH = 32;
    const vpnY = (i: number) => 64 + i * 46;
    const pfnY = (k: number) => 46 + k * 40;
    t.text(left.x, 30, '가상 메모리', 'scene-caption');
    t.text(right.x, 30, '물리 메모리', 'scene-caption');
    [0, 1, 2].forEach((i) => t.cell(left.x, vpnY(i), left.w, cellH, HUE.page, `VPN ${i}`));
    // PFN 3 부터 6 까지 네 칸. PFN 4 는 다른 프로세스가 씁니다.
    const owner = [0, -1, 1, 2];
    owner.forEach((page, k) => {
      const label = `PFN ${k + 3}`;
      if (page < 0) {
        t.cell(right.x, pfnY(k), right.w, cellH, HUE.other, `${label}  다른 프로세스`, true);
      } else {
        t.cell(right.x, pfnY(k), right.w, cellH, HUE.page, label);
      }
    });
    owner.forEach((page, k) => {
      if (page < 0) return;
      const from = { x: left.x + left.w + 6, y: vpnY(page) + cellH / 2 };
      const to = { x: right.x - 4, y: pfnY(k) + cellH / 2 };
      t.arrow([from, to]);
    });
    t.text(W / 2, H - 10, narrow ? '페이지 테이블이 VPN 을 PFN 으로 바꿈' : '페이지 테이블이 가상 페이지 번호(VPN)를 물리 프레임 번호(PFN)로 바꿉니다', 'scene-label is-sans scene-label-dep', 'middle');
  }

  // ── 한 호스트를 함께 쓰는 컨테이너 ──
  function drawSharedHost(root: SVGSVGElement, narrow: boolean) {
    const t = tools(root);
    const W = narrow ? 360 : 560;
    const H = narrow ? 330 : 318;
    view(root, W, H);
    const pad = narrow ? 8 : 12;
    const inner = narrow ? { x0: 20, x1: 340 } : { x0: 40, x1: 520 };
    t.box(pad, 28, W - pad * 2, H - 36, 'swap-fig-host', 14);
    t.text(pad + 12, 20, 'Linux 호스트', 'scene-caption');

    // 컨테이너 세 개
    const span = (inner.x1 - inner.x0) / 3;
    const cx = [0, 1, 2].map((i) => inner.x0 + span * i + span / 2);
    const nodeW = narrow ? 100 : 148;
    const services: [string, string, string][] = [
      ['Spring Boot', 'Container A', HUE.spring],
      ['PostgreSQL', 'Container B', HUE.postgres],
      ['Worker', 'Container C', HUE.worker],
    ];
    const nodeY = 74;
    services.forEach(([name, sub, hue], i) => {
      const node = t.node(name, hue, cx[i], nodeY, nodeW, 48, sub);
      // 좁은 배치의 카드는 폭이 100이라 색 막대를 빼고 이름이 들어갈 자리를 둡니다.
      if (narrow) node.group.classList.add('swap-fig-plain');
    });

    // RAM: 컨테이너마다 한도만큼 나눠 씁니다.
    const ramY = 140;
    const ramH = 34;
    t.text(inner.x0, ramY - 8, 'RAM', 'scene-label is-sans swap-fig-strong');
    services.forEach(([, , hue], i) => {
      const x = inner.x0 + span * i + 2;
      t.cell(x, ramY, span - 4, ramH, hue, narrow ? `${'ABC'[i]} 한도` : `Container ${'ABC'[i]} 한도`, true);
      t.arrow([{ x: cx[i], y: nodeY + 24 + 2 }, { x: cx[i], y: ramY - 2 }]);
    });

    // 디스크 하나에 PostgreSQL 데이터 파일과 swap 이 함께 있습니다.
    const diskY = narrow ? 238 : 228;
    const diskH = 40;
    const split = inner.x0 + span * 1.5;
    t.text(inner.x0, diskY - 8, '디스크 하나', 'scene-label is-sans swap-fig-strong');
    t.box(inner.x0, diskY, inner.x1 - inner.x0, diskH, 'scene-alloc-card', 8);
    t.text((inner.x0 + split) / 2, diskY + diskH / 2 + 4, narrow ? 'DB 데이터' : 'PostgreSQL 데이터 파일', 'scene-pg-cell-text is-sans', 'middle');
    svg('rect', { class: 'scene-alloc-free', x: split + 4, y: diskY + 4, width: inner.x1 - split - 8, height: diskH - 8, rx: 5 }, root);
    t.text((split + inner.x1) / 2, diskY + diskH / 2 + 4, 'swap', 'scene-pg-cell-text is-sans', 'middle');
    svg('line', { x1: split, y1: diskY + 6, x2: split, y2: diskY + diskH - 6, stroke: 'var(--hairline)', 'stroke-width': 1.2 }, root);

    // PostgreSQL 의 데이터 I/O 와 Worker 의 swap I/O 가 같은 디스크로 갑니다.
    const ioTop = ramY + ramH + 4;
    const dbTo = { x: (inner.x0 + split) / 2, y: diskY - 4 };
    const swapTo = { x: cx[2], y: diskY - 4 };
    t.arrow([{ x: cx[1], y: ioTop }, dbTo]);
    t.arrow([{ x: cx[2], y: ioTop }, swapTo], 'temp', true);
    const midY = (ioTop + diskY) / 2 + 4;
    t.text((cx[1] + dbTo.x) / 2 + 10, midY + 10, '데이터 I/O', 'scene-label is-sans scene-label-dep');
    t.text(cx[2] + 8, midY, 'swap I/O', 'scene-label is-sans swap-fig-temp');
    t.text(W / 2, diskY + diskH + 22, '두 I/O 가 같은 디스크를 씁니다', 'scene-label is-sans scene-label-dep', 'middle');
  }

  const DRAW: Record<Kind, (root: SVGSVGElement, narrow: boolean) => void> = {
    'page-mapping': drawMapping,
    'shared-host': drawSharedHost,
  };

  document.querySelectorAll<HTMLElement>('[data-blog-demo="swap-figure"]').forEach((figure) => {
    if (figure.dataset.ready) return;
    figure.dataset.ready = 'true';
    const stage = figure.querySelector<HTMLElement>('[data-stage]')!;
    const root = figure.querySelector<SVGSVGElement>('[data-graphic]')!;
    const draw = DRAW[figure.dataset.kind as Kind];
    watchNarrow(stage, (narrow) => {
      root.replaceChildren();
      draw(root, narrow);
    });
  });
</script>

<style>
  :global(.swap-fig-host) { fill: none; stroke: var(--hairline); stroke-width: 1.4; stroke-dasharray: 6 4; }
  :global(.swap-fig-strong) { fill: var(--ink); }
  :global(.swap-fig-plain .scene-node-accent) { display: none; }
  :global(.swap-fig-temp) { fill: var(--scene-temp); }
</style>
