---
import InteractiveDemoFrame from '@/components/blog/shared/InteractiveDemoFrame.astro';
import DemoControls from '@/components/blog/shared/DemoControls.astro';
import '@/styles/scene.css';
---

<InteractiveDemoFrame demoId="allocator-page-return" ariaLabel="블록을 해제해도 RSS가 줄어드는 조건을 직접 확인하는 실험" title="해제한 만큼 RSS가 줄어들까요?" description="4KB 페이지 네 개에 1KB 블록 16개가 모두 사용 중입니다. 블록을 눌러 해제하거나 8KB 해제 버튼을 고른 뒤, 2KB 요청과 malloc_trim 호출을 눌러 보세요.">
  <DemoControls ariaLabel="8KB를 해제하는 방법">
    <button type="button" data-preset="scatter">흩어서 8KB 해제</button>
    <button type="button" data-preset="group">몰아서 8KB 해제</button>
    <button type="button" data-preset="reset">처음으로</button>
  </DemoControls>

  <div class="scene-stage" data-stage>
    <svg data-graphic role="img" aria-label="프로세스 안에 4KB 페이지가 있고, 페이지마다 1KB 블록 네 개가 있습니다. 해제한 블록은 점선으로 바뀌고, 통째로 빈 페이지만 아래 운영체제 영역으로 반환됩니다."></svg>
  </div>

  <div class="alloc-actions">
    <DemoControls ariaLabel="할당자에게 시킬 일">
      <button type="button" data-action="request">2KB 요청</button>
      <button type="button" data-action="trim">malloc_trim 호출</button>
    </DemoControls>
  </div>

  <div class="alloc-readouts" aria-label="모형의 메모리 수치">
    <span><i class="is-used"></i>사용 중 <b data-used>16KB</b></span>
    <span><i class="is-held"></i>해제했지만 할당자가 들고 있음 <b data-held>0KB</b></span>
    <span>RSS <b data-rss>16KB</b></span>
  </div>
  <p class="scene-note" data-note role="status"></p>
  <p class="db-demo-disclaimer">
    페이지 4KB, 블록 1KB로 단순화한 모형입니다. 페이지 번호가 클수록 높은 주소에 있다고 보고, 가장 높은 페이지를 heap 맨 위로 둡니다. glibc처럼 heap 맨 위의 빈 페이지만 자동으로 반환하고, 요청은 같은 페이지 안의 연속된 빈 블록에 들어간다고 가정했습니다.
    실제 할당자는 arena와 캐시를 두는 등 훨씬 복잡합니다. 실제 측정값이 아닙니다.
  </p>
</InteractiveDemoFrame>

<script>
  import { bowAt, bumpText, createScene, duration, hopLift, nextHop, setAttrs, svg, watchNarrow, type Point } from '@/scripts/blog/scene/core';
  import { createBoundary, landRing, type Rect } from '@/scripts/blog/scene/parts';
  import { arcPoints, createPacketLayer } from '@/scripts/blog/scene/packets';

  const PAGES = 6;
  const BLOCKS = 4;
  const START_PAGES = 4;
  const PAGE_KB = 4;
  const HUE = 'var(--scene-hue-blue)';

  type PageState = { on: number; out: number; hop: number };
  type State = { pages: PageState[]; blocks: number[][] };
  type Layout = {
    view: [number, number];
    pageW: number;
    pageH: number;
    home: (k: number) => Point;
    os: (k: number) => Point;
    osScale: number;
    proc: Rect;
    procCaption: Point;
    zone: Rect;
    zoneCaption: Point;
    spawn: Point;
    narrow: boolean;
  };
  const layouts: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 362], pageW: 236, pageH: 58,
      home: (k) => ({ x: k % 2 ? 406 : 146, y: 93 + Math.floor(k / 2) * 70 }),
      os: (k) => ({ x: 60 + k * 88, y: 330 }), osScale: 0.35,
      proc: { x: 12, y: 52, w: 536, h: 222 }, procCaption: { x: 14, y: 40 },
      zone: { x: 12, y: 286, w: 536, h: 66 }, zoneCaption: { x: 28, y: 306 },
      spawn: { x: 500, y: 34 }, narrow: false,
    },
    narrow: {
      view: [360, 362], pageW: 162, pageH: 58,
      home: (k) => ({ x: k % 2 ? 267 : 93, y: 93 + Math.floor(k / 2) * 70 }),
      os: (k) => ({ x: 36 + k * 57, y: 330 }), osScale: 0.3,
      proc: { x: 6, y: 52, w: 348, h: 222 }, procCaption: { x: 8, y: 40 },
      zone: { x: 6, y: 286, w: 348, h: 66 }, zoneCaption: { x: 18, y: 306 },
      spawn: { x: 314, y: 34 }, narrow: true,
    },
  };

  document.querySelectorAll<HTMLElement>('[data-blog-demo="allocator-page-return"]').forEach((demo) => {
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const note = demo.querySelector<HTMLElement>('[data-note]')!;
    const usedOut = demo.querySelector<HTMLElement>('[data-used]')!;
    const heldOut = demo.querySelector<HTMLElement>('[data-held]')!;
    const rssOut = demo.querySelector<HTMLElement>('[data-rss]')!;
    const trimButton = demo.querySelector<HTMLButtonElement>('[data-action="trim"]')!;
    let layout = layouts.wide;

    // ── 논리 모형 ──
    let used: boolean[][] = [];
    let resident: boolean[] = [];
    let returned: boolean[] = [];
    const hops = Array.from({ length: PAGES }, () => 0);
    const reset = () => {
      used = Array.from({ length: PAGES }, (_, k) => Array.from({ length: BLOCKS }, () => k < START_PAGES));
      resident = Array.from({ length: PAGES }, (_, k) => k < START_PAGES);
      returned.forEach((was, k) => { if (was) hops[k] = nextHop(hops[k]); });
      returned = Array.from({ length: PAGES }, () => false);
    };
    reset();
    const live = (k: number) => resident[k] && !returned[k];
    const count = (pick: (k: number, j: number) => boolean) => {
      let n = 0;
      for (let k = 0; k < PAGES; k += 1) for (let j = 0; j < BLOCKS; j += 1) if (pick(k, j)) n += 1;
      return n;
    };
    const usedKb = () => count((k, j) => live(k) && used[k][j]);
    const heldKb = () => count((k, j) => live(k) && !used[k][j]);
    const rssKb = () => resident.filter((on, k) => on && !returned[k]).length * PAGE_KB;
    const isEmpty = (k: number) => live(k) && used[k].every((u) => !u);
    const emptyPages = () => [...Array(PAGES).keys()].filter(isEmpty);
    const livePages = () => [...Array(PAGES).keys()].filter(live);
    /** glibc 방식이 자동으로 반환하는 페이지: heap 맨 위부터 아래로 이어지는 빈 페이지. */
    const topEmptyPages = () => {
      const result: number[] = [];
      const pages = livePages();
      for (let i = pages.length - 1; i >= 0 && isEmpty(pages[i]); i -= 1) result.push(pages[i]);
      return result;
    };
    const topPage = () => livePages().at(-1);
    const name = (k: number) => `page ${k + 1}`;
    const names = (list: number[]) => [...list].sort((a, b) => a - b).map(name).join(', ');
    const target = (): State => ({
      pages: Array.from({ length: PAGES }, (_, k) => ({ on: resident[k] || returned[k] ? 1 : 0, out: returned[k] ? 1 : 0, hop: hops[k] })),
      blocks: used.map((row) => row.map((u) => (u ? 1 : 0))),
    });

    // ── 그림 ──
    const proc = createBoundary(root, '프로세스 (RSS에 잡히는 페이지)');
    const zone = createBoundary(root, '운영체제에 반환된 페이지', 'zone');
    // 새 페이지가 들어올 자리. 처음에는 비어 있습니다.
    const slots = Array.from({ length: PAGES - START_PAGES }, () => svg('rect', { rx: 10, fill: 'none', stroke: 'var(--hairline)', 'stroke-dasharray': '2 6' }, root));
    const pageViews = Array.from({ length: PAGES }, (_, k) => {
      const group = svg('g', { class: 'scene-alloc-page' }, root);
      group.style.setProperty('--node-hue', HUE);
      const card = svg('rect', { class: 'scene-alloc-card', rx: 10 }, group);
      const label = svg('text', { class: 'scene-label scene-label-dep' }, group);
      const sub = svg('text', { class: 'scene-alloc-sub scene-label is-sans', 'text-anchor': 'end' }, group);
      const blocks = Array.from({ length: BLOCKS }, (_, j) => {
        const g = svg('g', { class: 'scene-alloc-block', role: 'button', tabindex: -1 }, group);
        const free = svg('rect', { class: 'scene-alloc-free', rx: 5 }, g);
        const fill = svg('rect', { class: 'scene-alloc-used', rx: 5 }, g);
        g.addEventListener('click', () => toggle(k, j));
        g.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          toggle(k, j);
        });
        return { g, free, fill };
      });
      return { group, card, label, sub, blocks };
    });
    const packets = createPacketLayer(root);

    const unitWidth = () => (layout.pageW - 20 - 3 * 4) / BLOCKS;
    const blockLocal = (j: number): Point => {
      const bw = unitWidth();
      return { x: -layout.pageW / 2 + 10 + j * (bw + 4) + bw / 2, y: -layout.pageH / 2 + 21 + (layout.pageH - 29) / 2 };
    };
    const blockAt = (k: number, j: number): Point => {
      const home = layout.home(k);
      const local = blockLocal(j);
      return { x: home.x + local.x, y: home.y + local.y };
    };

    const sizePage = (k: number) => {
      const { pageW: w, pageH: h } = layout;
      const bw = unitWidth();
      const view = pageViews[k];
      setAttrs(view.card, { x: -w / 2, y: -h / 2, width: w, height: h });
      setAttrs(view.label, { x: -w / 2 + 10, y: -h / 2 + 14 });
      setAttrs(view.sub, { x: w / 2 - 10, y: -h / 2 + 14 });
      view.blocks.forEach(({ free, fill }, j) => {
        const box = { x: -w / 2 + 10 + j * (bw + 4), y: -h / 2 + 21, width: bw, height: h - 29 };
        setAttrs(free, box);
        setAttrs(fill, box);
      });
    };
    const sizePages = () => {
      const { pageW: w, pageH: h } = layout;
      slots.forEach((slot, i) => {
        const at = layout.home(START_PAGES + i);
        setAttrs(slot, { x: at.x - w / 2, y: at.y - h / 2, width: w, height: h });
      });
      pageViews.forEach((_, k) => sizePage(k));
    };

    const scene = createScene<State>(target(), (s) => {
      s.pages.forEach((p, k) => {
        const view = pageViews[k];
        const at = bowAt(layout.home(k), layout.os(k), p.out, hopLift(p.hop, 46));
        const scale = 1 + (layout.osScale - 1) * p.out;
        setAttrs(view.group, { transform: `translate(${at.x.toFixed(2)} ${at.y.toFixed(2)}) scale(${scale.toFixed(3)})` });
        view.group.style.opacity = String(p.on);
        view.group.style.pointerEvents = p.on > 0.5 ? '' : 'none';
        view.label.style.opacity = String(1 - p.out);
        view.sub.style.opacity = String(1 - p.out);
        view.blocks.forEach(({ fill }, j) => fill.setAttribute('opacity', String(s.blocks[k][j])));
      });
    });

    // 페이지 상태 클래스와 접근성 라벨은 논리 모형이 바뀔 때만 맞춥니다.
    const syncPages = () => {
      const empties = new Set(emptyPages());
      pageViews.forEach((view, k) => {
        view.group.classList.toggle('is-returned', returned[k]);
        view.group.classList.toggle('is-reclaimable', empties.has(k));
        view.sub.textContent = empties.has(k) ? '통째로 빔' : '';
        view.blocks.forEach(({ g }, j) => {
          setAttrs(g, { tabindex: live(k) ? 0 : -1, 'aria-label': `${name(k)} 블록 ${j + 1}, ${used[k][j] ? '사용 중' : '해제됨'}` });
        });
      });
      // heap 맨 위 페이지에 표시를 붙입니다.
      const top = topPage();
      pageViews.forEach((view, k) => {
        const short = layout.narrow;
        if (k === top) view.label.textContent = short ? `p${k + 1} 맨 위` : `${name(k)} (heap 맨 위)`;
        else view.label.textContent = short ? `p${k + 1}` : name(k);
      });
    };
    const syncReadouts = (bumpRss = false) => {
      bumpText(usedOut, `${usedKb()}KB`);
      bumpText(heldOut, `${heldKb()}KB`);
      if (bumpRss) bumpText(rssOut, `${rssKb()}KB`);
      else rssOut.textContent = `${rssKb()}KB`;
    };
    const say = (html: string, alert = false) => {
      note.classList.toggle('is-alert', alert);
      note.innerHTML = html;
    };
    const clearMisfit = () => pageViews.forEach((view) => view.blocks.forEach(({ g }) => g.classList.remove('is-misfit')));
    const interrupt = () => {
      const alive = scene.begin();
      packets.clear();
      clearMisfit();
      return alive;
    };

    /** 페이지를 운영체제 영역으로 날려 보냅니다. */
    const returnPages = async (list: number[], alive: () => boolean) => {
      list.forEach((k) => { returned[k] = true; hops[k] = nextHop(hops[k]); });
      syncPages();
      if (!(await scene.go(target(), duration.fly)) || !alive()) return false;
      list.forEach((k) => {
        const at = layout.os(k);
        landRing(root, { x: at.x, y: at.y, w: layout.pageW * layout.osScale + 6, h: layout.pageH * layout.osScale + 6 });
      });
      syncReadouts(true);
      return true;
    };

    /** 해제한 뒤 할당자가 스스로 하는 일. glibc처럼 heap 맨 위의 빈 페이지만 반환합니다. */
    const settleAfterFree = async (alive: () => boolean, intro = '') => {
      const before = rssKb();
      const held = heldKb();
      const empties = emptyPages();
      if (!held) return initialNote();
      if (!empties.length) {
        return say(`${intro}해제한 <strong>${held}KB</strong>는 할당자가 들고 있습니다. 페이지마다 사용 중인 블록이 남아 있어서 통째로 빈 페이지가 없고, <strong>RSS는 ${rssKb()}KB 그대로</strong>입니다.`);
      }
      const top = topEmptyPages();
      if (!top.length) {
        return say(`${intro}${names(empties)}가 통째로 비었습니다. 하지만 <strong>heap 맨 위(${name(topPage()!)})가 사용 중</strong>이라 자동으로 반환되지 않고, RSS는 ${rssKb()}KB 그대로입니다. <strong>malloc_trim 호출</strong>을 눌러 보세요.`);
      }
      await scene.pause(duration.beat);
      if (!alive() || !(await returnPages(top, alive))) return;
      const rest = emptyPages();
      say(`heap 맨 위에 있던 빈 ${names(top)}는 자동으로 반환되어 RSS가 <strong>${before}KB에서 ${rssKb()}KB로</strong> 줄었습니다.${rest.length ? ` 중간의 ${names(rest)}는 그대로 남습니다.` : ''}`);
    };

    const toggle = (k: number, j: number) => {
      if (!live(k)) return;
      const alive = interrupt();
      used[k][j] = !used[k][j];
      syncPages();
      syncReadouts();
      void scene.go(target(), 320).then((ok) => { if (ok && alive()) void settleAfterFree(alive); });
    };

    const initialNote = () => say(`사용 중인 블록이 ${usedKb()}KB, RSS는 ${rssKb()}KB입니다. 블록을 눌러 해제해 보세요. 해제한 만큼 RSS도 줄어들까요?`);

    const preset = async (kind: string) => {
      const alive = interrupt();
      reset();
      if (kind === 'scatter') used.forEach((row, k) => { if (k < START_PAGES) { row[1] = false; row[3] = false; } });
      if (kind === 'group') [0, 1].forEach((k) => used[k].fill(false));
      sizePages();
      syncPages();
      syncReadouts(true);
      if (kind === 'reset') {
        initialNote();
        void scene.go(target(), duration.move);
        return;
      }
      if (!(await scene.go(target(), duration.move)) || !alive()) return;
      if (kind === 'scatter') {
        say('8KB를 해제했습니다. 하지만 페이지마다 사용 중인 블록이 남아 있어 <strong>통째로 빈 페이지가 없습니다.</strong> RSS는 16KB 그대로입니다. 2KB 요청과 malloc_trim 호출을 눌러 보세요.');
        return;
      }
      await settleAfterFree(alive, kind === 'group' ? '같은 8KB를 몰아서 해제했습니다. ' : '');
    };

    const trim = async () => {
      const alive = interrupt();
      const empties = emptyPages();
      if (!empties.length) {
        say(`malloc_trim을 호출해도 통째로 빈 페이지가 없어 돌려줄 페이지가 없습니다. 해제한 ${heldKb()}KB는 <strong>RSS에 그대로 남습니다.</strong>`, true);
        return;
      }
      const before = rssKb();
      say(`malloc_trim이 중간에 있는 빈 페이지까지 찾아 운영체제에 돌려주는 중입니다…`);
      if (!(await returnPages(empties, alive))) return;
      say(`malloc_trim이 ${names(empties)}를 반환했습니다. RSS가 <strong>${before}KB에서 ${rssKb()}KB로</strong> 줄었습니다. 이 함수는 누군가 호출해야 동작합니다.`);
    };

    const findFit = () => {
      for (let k = 0; k < PAGES; k += 1) {
        if (!live(k)) continue;
        for (let j = 0; j < BLOCKS - 1; j += 1) if (!used[k][j] && !used[k][j + 1]) return { k, j };
      }
      return undefined;
    };

    const request = async () => {
      const alive = interrupt();
      const packet = packets.spawn({ label: '2KB', at: layout.spawn });
      const fit = findFit();
      const pairAt = (k: number, j: number): Point => {
        const a = blockAt(k, j);
        const b = blockAt(k, j + 1);
        return { x: (a.x + b.x) / 2, y: a.y };
      };
      const settle = async (k: number, j: number) => {
        if (!(await packet.travel(arcPoints(packet.at, pairAt(k, j), 26), duration.fly)) || !alive()) return false;
        used[k][j] = true;
        used[k][j + 1] = true;
        syncPages();
        void packet.fade(duration.reflow);
        return (await scene.go(target(), duration.reflow)) && alive();
      };

      if (fit) {
        if (!(await settle(fit.k, fit.j))) return;
        syncReadouts();
        say(`${name(fit.k)}의 연속된 빈 블록 두 개에 2KB 요청이 들어갔습니다. 이미 받아 둔 페이지를 다시 쓰므로 <strong>RSS는 ${rssKb()}KB 그대로</strong>입니다.`);
        return;
      }

      const held = heldKb();
      const fragments: { k: number; j: number }[] = [];
      for (let k = 0; k < PAGES; k += 1) if (live(k)) used[k].forEach((u, j) => { if (!u) fragments.push({ k, j }); });
      if (fragments.length) {
        say('2KB가 들어갈 연속된 빈 블록을 찾는 중입니다…');
        const first = fragments[0];
        if (!(await packet.bounce(blockAt(first.k, first.j), 30)) || !alive()) return;
        fragments.forEach(({ k, j }) => pageViews[k].blocks[j].g.classList.add('is-misfit'));
        await scene.pause(duration.beat);
        if (!alive()) return;
      }
      const slot = [...Array(PAGES).keys()].find((k) => !resident[k] && !returned[k]);
      if (slot === undefined) {
        say('모형에 준비한 페이지 자리를 다 썼습니다. <strong>처음으로</strong>를 눌러 다시 시작하세요.', true);
        void packet.fade();
        return;
      }
      const before = rssKb();
      resident[slot] = true;
      syncPages();
      if (!(await scene.go(target(), duration.draw)) || !alive()) return;
      const home = layout.home(slot);
      landRing(root, { ...home, w: layout.pageW + 6, h: layout.pageH + 6 });
      syncReadouts(true);
      packet.relabel('2KB', 'dep');
      if (!(await settle(slot, 0))) return;
      clearMisfit();
      syncReadouts();
      say(held
        ? `빈 블록이 ${held}KB 있지만 모두 1KB 조각이라 2KB가 들어갈 자리가 없습니다. 할당자가 운영체제에서 새 페이지를 받아 와서 <strong>RSS가 ${before}KB에서 ${rssKb()}KB로 늘었습니다.</strong>`
        : `빈 블록이 없어서 할당자가 운영체제에서 새 페이지를 받아 왔습니다. RSS가 ${before}KB에서 ${rssKb()}KB로 늘었습니다.`, Boolean(held));
    };


    demo.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.addEventListener('click', () => { void preset(button.dataset.preset!); }));
    trimButton.addEventListener('click', () => { void trim(); });
    demo.querySelector('[data-action="request"]')!.addEventListener('click', () => { void request(); });

    const applyLayout = () => {
      setAttrs(root, { viewBox: `0 0 ${layout.view[0]} ${layout.view[1]}` });
      proc.place(layout.proc, { ...layout.procCaption, anchor: 'start' });
      zone.place(layout.zone, { ...layout.zoneCaption, anchor: 'start' });
      sizePages();
      interrupt();
      syncPages();
      scene.set(target());
    };
    watchNarrow(stage, (narrow) => { layout = layouts[narrow ? 'narrow' : 'wide']; applyLayout(); });
    syncPages();
    syncReadouts();
    initialNote();
    applyLayout();
  });
</script>

