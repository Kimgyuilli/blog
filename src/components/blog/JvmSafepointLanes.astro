---
import InteractiveDemoFrame from './InteractiveDemoFrame.astro';
import SceneTimeline from './SceneTimeline.astro';
import '../../styles/scene.css';

const steps = [
  { name: 'A preempt', detail: 'OS가 내림' },
  { name: 'safepoint 요청', detail: '확인 2 / 3' },
  { name: 'A CPU 재배정', detail: '아직 2 / 3' },
  { name: 'A polling', detail: '3 / 3 · 작업' },
  { name: 'VM 작업', detail: 'C 복귀 대기' },
  { name: '종료 후', detail: 'CPU는 OS가' },
];
---

<InteractiveDemoFrame demoId="jvm-safepoint-lanes" ariaLabel="OS가 preempt한 thread A가 있을 때 HotSpot의 safepoint가 어떻게 성립하고 끝나는지 시간축으로 보여주는 장면" title="이미 멈춰 있는 A는 safepoint에 도달한 걸까요?" description="Java thread 셋과 VM thread의 시간축입니다. 막대는 CPU에서 실행한 구간, 비어 있는 구간은 CPU를 받지 못한 구간입니다. 위의 확인 수가 언제 차는지 보세요.">
  <SceneTimeline ariaLabel="safepoint 단계" steps={steps} />
  <div class="scene-stage" data-stage>
    <svg data-graphic role="img" aria-label="세 Java thread A, B, C와 VM thread의 실행 구간이 시간축에 쌓입니다. A는 OS에 의해 preempt되어 CPU를 받지 못하는 중에 safepoint가 요청됩니다. native 코드에 있는 C는 멈추지 않고도 바로 확인되고, B는 polling 지점에서 safepoint 대기에 들어가지만, A는 CPU를 다시 받아 polling 지점을 지날 때까지 확인되지 않아 VM thread가 기다립니다. 세 thread가 모두 확인되면 VM 작업이 수행되고, 그동안 native에서 돌아오려던 C도 대기합니다. safepoint가 끝난 뒤 각 thread는 OS가 CPU를 배정하는 대로 실행을 이어갑니다."></svg>
  </div>
  <p class="scene-note" data-note role="status"></p>
  <p class="db-demo-disclaimer">본문 11절의 경로를 단순화한 개념 모형입니다. 막대의 길이와 순서는 설명을 위한 가정이며 실제 시간이나 CPU 수를 나타내지 않습니다. HotSpot 내부의 thread 상태 이름과 확인 절차의 세부, VM 작업에 참여하는 GC worker는 그리지 않았습니다.</p>
</InteractiveDemoFrame>

<script>
  import { bumpText, createScene, ease, lerp, setAttrs, svg, watchNarrow } from '../../scripts/blog/scene/core';
  import { createBadge } from '../../scripts/blog/scene/parts';
  import { createStepPlayer } from '../../scripts/blog/scene/step-player';

  // 독자가 볼 변화: safepoint 요청 시점에 A는 이미 CPU에서 내려가 있지만 확인 수는 2/3에서 멈추고 VM thread가 기다린다.
  // A가 CPU를 다시 받아 polling 지점을 지나야 3/3이 되고 VM 작업이 시작된다. native의 C는 멈추지 않고도 확인된다.
  type Lane = 'A' | 'B' | 'C' | 'VM';
  type Kind = 'java' | 'native' | 'park' | 'sync' | 'op';
  type Segment = { lane: Lane; kind: Kind; start: number; end: number; label?: string };
  type Layout = {
    view: [number, number];
    labelX: number; checkX: number; x0: number; x1: number;
    lanes: Record<Lane, number>; laneH: number;
    badge: { x: number; y: number }; eventY: number; bottom: number;
    labels: Record<Lane, string>;
    legend: { x: number; y: number }[];
  };

  const LAYOUTS: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 292],
      labelX: 14, checkX: 104, x0: 114, x1: 546,
      lanes: { A: 92, B: 132, C: 172, VM: 222 }, laneH: 26,
      badge: { x: 14, y: 24 }, eventY: 60, bottom: 240,
      labels: { A: 'A · JIT code', B: 'B · Java', C: 'C · native', VM: 'VM thread' },
      legend: [{ x: 14, y: 272 }, { x: 156, y: 272 }, { x: 290, y: 272 }, { x: 418, y: 272 }],
    },
    narrow: {
      view: [360, 314],
      labelX: 8, checkX: 84, x0: 94, x1: 350,
      lanes: { A: 92, B: 132, C: 172, VM: 222 }, laneH: 26,
      badge: { x: 8, y: 24 }, eventY: 60, bottom: 240,
      labels: { A: 'A · JIT', B: 'B · Java', C: 'C · native', VM: 'VM thread' },
      legend: [{ x: 8, y: 270 }, { x: 186, y: 270 }, { x: 8, y: 294 }, { x: 186, y: 294 }],
    },
  };
  const LANES: Lane[] = ['A', 'B', 'C', 'VM'];
  const HUE: Record<Lane, string> = { A: 'var(--scene-hue-blue)', B: 'var(--scene-hue-violet)', C: 'var(--scene-hue-pink)', VM: 'var(--scene-hue-cyan)' };
  const REQUEST = 0.22;
  const END = 0.68;
  const SAFE: Record<Exclude<Lane, 'VM'>, number> = { C: 0.22, B: 0.27, A: 0.46 };
  const POLLS: { lane: Lane; t: number }[] = [{ lane: 'B', t: 0.27 }, { lane: 'A', t: 0.46 }];
  const SEGMENTS: Segment[] = [
    { lane: 'A', kind: 'java', start: 0, end: 0.12 },
    { lane: 'A', kind: 'java', start: 0.36, end: 0.46 },
    { lane: 'A', kind: 'park', start: 0.46, end: END, label: 'safepoint 대기' },
    { lane: 'A', kind: 'java', start: 0.76, end: 1 },
    { lane: 'B', kind: 'java', start: 0, end: 0.27 },
    { lane: 'B', kind: 'park', start: 0.27, end: END, label: 'safepoint 대기' },
    { lane: 'B', kind: 'java', start: 0.7, end: 1 },
    { lane: 'C', kind: 'native', start: 0, end: 0.6, label: 'native 코드 실행' },
    { lane: 'C', kind: 'park', start: 0.6, end: END, label: '복귀 대기' },
    { lane: 'C', kind: 'java', start: 0.74, end: 1 },
    { lane: 'VM', kind: 'sync', start: REQUEST, end: 0.46, label: 'A 확인 대기' },
    { lane: 'VM', kind: 'op', start: 0.46, end: END, label: 'VM 작업' },
  ];
  /** CPU를 받지 못한 구간에 붙는 설명. */
  const GAPS: { lane: Lane; start: number; end: number; label: string }[] = [
    { lane: 'A', start: 0.12, end: 0.36, label: 'preempt · 대기' },
    { lane: 'A', start: END, end: 0.76, label: 'CPU 대기' },
  ];
  const STEP_END = [0.18, 0.31, 0.42, 0.52, 0.66, 0.94];
  const NOTES = [
    'A가 JIT compiled code를 실행하다 <strong>OS에 의해 preempt</strong>되었습니다. 그동안 B는 다른 CPU에서 Java 코드를, C는 native 코드를 계속 실행합니다.',
    'HotSpot에 safepoint가 필요한 작업이 요청됐습니다. native에 있는 <strong>C는 멈추지 않고도</strong> 바로 확인되고, B는 polling 지점에서 대기에 들어갑니다. 그런데 이미 CPU에서 내려가 있는 <strong>A는 확인되지 않아</strong> 2 / 3에서 멈춥니다.',
    'VM thread는 계속 기다립니다. OS가 A에게 CPU를 다시 배정하자, A는 <strong>중단했던 Java 실행을 이어갑니다</strong>. CPU를 받지 못한 시간은 safepoint 참여로 세지 않습니다.',
    'A가 polling 지점에서 요청을 확인하고 safepoint 대기에 들어갔습니다. 확인이 <strong>3 / 3</strong>이 되자 VM 작업이 시작됩니다.',
    'VM 작업이 진행되는 동안 A와 B의 Java 실행은 대기합니다. native 코드를 마치고 Java로 돌아오려던 <strong>C도 복귀 경로에서 대기</strong>합니다.',
    'safepoint가 끝났습니다. JVM 쪽의 대기 조건은 풀렸지만 <strong>모두가 동시에 CPU를 받지는 않습니다</strong>. 각 thread는 OS가 CPU를 배정하는 대로 실행을 이어갑니다.',
  ];

  document.querySelectorAll<HTMLElement>('[data-blog-demo="jvm-safepoint-lanes"]').forEach((demo) => {
    if (demo.dataset.ready) return;
    demo.dataset.ready = 'true';
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const note = demo.querySelector<HTMLElement>('[data-note]')!;
    let layout = LAYOUTS.wide;

    const window_ = svg('rect', { class: 'jvm-sp-window', rx: 6 }, root);
    const windowLabel = svg('text', { class: 'scene-label is-sans jvm-sp-window-label', 'text-anchor': 'middle' }, root);
    windowLabel.textContent = 'safepoint 성립';
    const laneViews = LANES.map((lane) => {
      const track = svg('rect', { class: 'scene-lane-track', rx: 6 }, root);
      const label = svg('text', { class: 'scene-label is-sans jvm-sp-name' }, root);
      label.style.fill = HUE[lane];
      const check = svg('text', { class: 'scene-label is-sans jvm-sp-check', 'text-anchor': 'end' }, root);
      return { lane, track, label, check };
    });
    const bars = svg('g', {}, root);
    const events = ['request', 'end'].map((name) => {
      const line = svg('line', { class: name === 'request' ? 'scene-tick-line' : 'jvm-sp-end-line' }, root);
      const text = svg('text', { class: `scene-label is-sans ${name === 'request' ? 'scene-label-danger' : 'scene-label-flow'}`, 'text-anchor': 'middle' }, root);
      text.textContent = name === 'request' ? 'safepoint 요청' : 'safepoint 종료';
      return { name, line, text };
    });
    const cursor = svg('line', { class: 'jvm-sp-cursor' }, root);
    const badge = createBadge(root, 'safepoint 확인', 170);
    const legend = [
      { kind: 'java', text: 'CPU에서 Java 실행' },
      { kind: 'native', text: 'native 코드 실행' },
      { kind: 'park', text: 'safepoint 대기' },
      { kind: 'gap', text: '빈칸 = CPU 대기' },
    ].map((item) => {
      const g = svg('g', {}, root);
      const swatch = svg('rect', { rx: 3, width: 20, height: 12, y: -9, class: item.kind === 'gap' ? 'scene-lane-track' : `scene-lane-bar jvm-sp-${item.kind}` }, g);
      swatch.style.setProperty('--node-hue', 'var(--scene-hue-gray)');
      const text = svg('text', { class: 'scene-caption', x: 26, y: 1 }, g);
      text.textContent = item.text;
      return g;
    });

    const xAt = (t: number) => lerp(layout.x0, layout.x1, t);
    const counter = (now: number) => {
      if (now < REQUEST - 1e-4) return '—';
      if (now >= END) return '종료';
      const done = Object.values(SAFE).filter((t) => t <= now + 1e-4).length;
      return `${done} / 3`;
    };

    const scene = createScene({ now: 0 }, ({ now }) => {
      const l = layout;
      bars.replaceChildren();
      const half = l.laneH / 2;
      SEGMENTS.forEach((seg) => {
        const end = Math.min(seg.end, now);
        if (end <= seg.start) return;
        const y = l.lanes[seg.lane];
        const x = xAt(seg.start);
        const w = xAt(end) - x;
        const bar = svg('rect', { class: `scene-lane-bar jvm-sp-${seg.kind}`, rx: 5, x, y: y - half + 2, width: Math.max(0, w), height: l.laneH - 4 }, bars);
        bar.style.setProperty('--node-hue', HUE[seg.lane]);
        if (seg.label && w > seg.label.length * 6.4 + 12) {
          const text = svg('text', { class: `jvm-sp-bar-text is-${seg.kind}`, x: x + 7, y: y + 4 }, bars);
          text.textContent = seg.label;
        }
      });
      GAPS.forEach((gap) => {
        const end = Math.min(gap.end, now);
        const w = xAt(end) - xAt(gap.start);
        if (w <= 0) return;
        const y = l.lanes[gap.lane];
        svg('line', { class: 'jvm-sp-gap', x1: xAt(gap.start) + 3, x2: xAt(end) - 3, y1: y, y2: y }, bars);
        if (w > gap.label.length * 6.2 + 12) {
          const text = svg('text', { class: 'jvm-sp-gap-text', x: xAt(gap.start) + 7, y: y - 5 }, bars);
          text.textContent = gap.label;
        }
      });
      POLLS.forEach((poll) => {
        if (now < poll.t) return;
        const x = xAt(poll.t);
        const y = l.lanes[poll.lane] - half - 1;
        svg('path', { class: 'jvm-sp-poll', d: `M ${x} ${y - 5} L ${x + 5} ${y} L ${x} ${y + 5} L ${x - 5} ${y} Z` }, bars);
        const text = svg('text', { class: 'scene-label is-sans jvm-sp-poll-text', x: x + 8, y: y + 3 }, bars);
        text.textContent = 'poll';
      });
      // 확인 표시: 요청 뒤부터 끝날 때까지, 확인된 thread는 ✓, 아직이면 …
      laneViews.forEach(({ lane, check }) => {
        if (lane === 'VM' || now < REQUEST || now >= END) { check.textContent = ''; return; }
        const safe = SAFE[lane] <= now + 1e-4;
        check.textContent = safe ? '✓' : '…';
        check.classList.toggle('is-pending', !safe);
      });
      laneViews[3].label.classList.toggle('is-waiting-label', now > REQUEST && now < SAFE.A);
      bumpText(badge.value, counter(now));
      const full = now >= SAFE.A && now < END;
      badge.group.style.setProperty('--node-hue', now < REQUEST || now >= END ? 'var(--scene-hue-gray)' : full ? 'var(--scene-flow)' : 'var(--scene-temp)');
      // 요청·종료 선과 safepoint 성립 구간
      events.forEach(({ name, line, text }) => {
        const t = name === 'request' ? REQUEST : END;
        const on = now >= t ? 1 : 0;
        setAttrs(line, { x1: xAt(t), x2: xAt(t), y1: l.eventY + 6, y2: l.bottom, opacity: on });
        setAttrs(text, { x: xAt(t), y: l.eventY, opacity: on });
      });
      const wEnd = Math.min(now, END);
      const wOn = now > SAFE.A;
      setAttrs(window_, { x: xAt(SAFE.A), y: l.lanes.A - half - 8, width: wOn ? xAt(wEnd) - xAt(SAFE.A) : 0, height: l.lanes.C - l.lanes.A + l.laneH + 16, opacity: wOn ? 1 : 0 });
      setAttrs(windowLabel, { x: (xAt(SAFE.A) + xAt(END)) / 2, y: (l.lanes.C + l.lanes.VM) / 2 + 4, opacity: wOn ? 1 : 0 });
      setAttrs(cursor, { x1: xAt(now), x2: xAt(now), y1: l.lanes.A - half - 6, y2: l.bottom, opacity: now > 0.001 && now < 0.999 ? 1 : 0 });
    });

    const say = (index: number) => {
      note.innerHTML = NOTES[index];
      note.classList.remove('is-entering');
      void note.offsetWidth;
      note.classList.add('is-entering');
    };
    let shown = 0;
    const show = (index: number, instant: boolean) => {
      const previous = shown;
      shown = index;
      say(index);
      const target = { now: STEP_END[index] };
      if (instant) { scene.set(target); return; }
      if (index === previous + 1) {
        // 앞 단계 끝에서 출발해 시간이 흐르듯 막대가 자랍니다.
        scene.set({ now: STEP_END[previous] });
        void scene.go(target, Math.max(900, (STEP_END[index] - STEP_END[previous]) * 9000), ease.linear);
        return;
      }
      if (index === 0) { scene.set({ now: 0 }); void scene.go(target, 1600, ease.linear); return; }
      void scene.go(target, 700);
    };

    const applyLayout = () => {
      const l = layout;
      setAttrs(root, { viewBox: `0 0 ${l.view[0]} ${l.view[1]}` });
      laneViews.forEach(({ lane, track, label, check }) => {
        const y = l.lanes[lane];
        setAttrs(track, { x: l.x0 - 4, y: y - l.laneH / 2, width: l.x1 - l.x0 + 8, height: l.laneH });
        setAttrs(label, { x: l.labelX, y: y + 4 });
        label.textContent = l.labels[lane];
        setAttrs(check, { x: l.checkX, y: y + 4 });
      });
      badge.place(l.badge);
      legend.forEach((g, i) => setAttrs(g, { transform: `translate(${l.legend[i].x} ${l.legend[i].y})` }));
      scene.redraw();
    };
    watchNarrow(stage, (narrow) => { layout = LAYOUTS[narrow ? 'narrow' : 'wide']; applyLayout(); });

    createStepPlayer(demo, {
      dwell: (index) => [3600, 6200, 5200, 5200, 5200, 6400][index],
      onStep: show,
    });
  });
</script>

<style is:global>
  .db-demo[data-blog-demo="jvm-safepoint-lanes"] .scene-note { min-height: 5.4em; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-native { fill: color-mix(in srgb, var(--node-hue) 22%, transparent); stroke-dasharray: 5 3; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-park,
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-sync { fill: var(--scene-temp-soft); stroke: var(--scene-temp); stroke-dasharray: 4 3; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-op { fill: color-mix(in srgb, var(--node-hue) 62%, transparent); }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-bar-text { fill: var(--ink); font-size: 10.5px; font-weight: 700; pointer-events: none; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-bar-text.is-park,
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-bar-text.is-sync { fill: var(--scene-temp); }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-gap { stroke: var(--scene-hue-gray); stroke-width: 1.4; stroke-dasharray: 2 4; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-gap-text { fill: var(--slate); font-size: 10px; font-weight: 700; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-poll { fill: var(--ink); }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-poll-text { fill: var(--ink); font-size: 10px; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-name { font-weight: 800; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-check { fill: var(--scene-flow-ink); font-size: 13px; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-check.is-pending { fill: var(--scene-temp); }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-end-line { stroke: var(--scene-flow); stroke-width: 1.5; stroke-dasharray: 2 4; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-window { fill: color-mix(in srgb, var(--scene-flow) 8%, transparent); stroke: color-mix(in srgb, var(--scene-flow) 45%, transparent); stroke-width: 1; stroke-dasharray: 3 3; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-window-label { fill: var(--scene-flow-ink); font-size: 10.5px; }
  [data-blog-demo="jvm-safepoint-lanes"] .jvm-sp-cursor { stroke: var(--scene-hue-cyan); stroke-width: 1.6; }
</style>
