---
import '../../styles/database-demos.css';

type Props = {
  demoId: string;
  ariaLabel: string;
  title: string;
  description: string;
};

const { demoId, ariaLabel, title, description } = Astro.props;
---

<section class="db-demo" data-blog-demo={demoId} aria-label={ariaLabel}>
  <div class="db-demo-heading">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <slot />
</section>
