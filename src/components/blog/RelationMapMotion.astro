---
import AutoMotionFigure from './AutoMotionFigure.astro';
---

<AutoMotionFigure className="db-relation-motion" ariaLabel="주문 행의 외래 키가 고객 행을 참조하는 그림" title="숫자가 같으면 같은 고객을 가리킵니다" caption="주문 101과 102는 고객 1을 함께 참조합니다. 고객 이름은 고객 행 한 곳에 저장할 수 있습니다.">
  <div class="db-relation-head" aria-hidden="true">
    <span>orders.customer_id</span><span>참조</span><span>customers.customer_id</span>
  </div>
  <div class="db-relation-pair" style="--motion-order: 0">
    <span class="db-relation-record">주문 101 <b>1</b></span>
    <span class="db-relation-path" aria-hidden="true"><span></span></span>
    <span class="db-relation-record">고객 <b>1</b> 김민아</span>
  </div>
  <div class="db-relation-pair" style="--motion-order: 1">
    <span class="db-relation-record">주문 102 <b>1</b></span>
    <span class="db-relation-path" aria-hidden="true"><span></span></span>
    <span class="db-relation-record">고객 <b>1</b> 김민아</span>
  </div>
  <div class="db-relation-pair" style="--motion-order: 2">
    <span class="db-relation-record">주문 103 <b>2</b></span>
    <span class="db-relation-path" aria-hidden="true"><span></span></span>
    <span class="db-relation-record">고객 <b>2</b> 이준</span>
  </div>
</AutoMotionFigure>
