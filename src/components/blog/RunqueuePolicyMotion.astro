---
import InteractiveDemoFrame from './InteractiveDemoFrame.astro';
import DemoControls from './DemoControls.astro';
import '../../styles/scene.css';
---

<InteractiveDemoFrame demoId="runqueue-policy-motion" ariaLabel="스레드 정책에 따라 소속 클래스 큐가 바뀌고, 다음 실행 대상은 DL, RT, FAIR 순으로 고르는 개념도" title="정책을 바꾸면 T는 어디로 가고, CPU0은 누구부터 볼까요?" description="carrier OS 스레드 T의 정책을 바꿔 보고, CPU0이 다음 실행 대상을 고르게 해 보세요.">
  <DemoControls ariaLabel="OS 스레드 T의 스케줄링 정책과 선택">
    <button type="button" data-policy="fair" aria-pressed="true">SCHED_OTHER</button>
    <button type="button" data-policy="rt" aria-pressed="false">SCHED_FIFO</button>
    <button type="button" data-policy="dl" aria-pressed="false">SCHED_DEADLINE</button>
    <button type="button" data-pick>▶ 다음 실행 대상 고르기</button>
  </DemoControls>
  <div class="scene-stage" data-stage>
    <svg data-graphic role="img" aria-label="CPU0의 rq 안에 dl_rq, rt_rq, cfs_rq가 있습니다. OS 스레드 T는 정책에 해당하는 큐 한 곳에만 있고, T에 실린 VT A는 따로 큐에 들어가지 않습니다. 다음 실행 대상을 고를 때는 DL, RT, FAIR 순서로 실행 가능한 스레드가 있는 클래스를 찾습니다."></svg>
  </div>
  <p class="scene-note" data-note role="status"></p>
  <p class="db-demo-disclaimer">R1·F1·F2는 예시로 둔 다른 OS 스레드입니다. 정책 변경은 개념 실험이며, 실제 RT·DL 설정에는 권한과 정책별 매개변수·허용 조건이 필요합니다. 다른 스케줄링 클래스와 cgroup 계층 큐는 생략했습니다.</p>
</InteractiveDemoFrame>

<script>
  import { bowAt, createScene, duration, hopLift, setAttrs, svg, watchNarrow, type Point } from '../../scripts/blog/scene/core';
  import { createBoundary, createCurve, createNode, landRing, type NodeView } from '../../scripts/blog/scene/parts';

  type Policy = 'dl' | 'rt' | 'fair';
  const ORDER: Policy[] = ['dl', 'rt', 'fair'];
  const LANES: Record<Policy, { title: string; rule: string; cls: string; policy: string; others: string[] }> = {
    dl: { title: 'dl_rq · DL', rule: '마감시간 규칙', cls: 'DL', policy: 'SCHED_DEADLINE', others: [] },
    rt: { title: 'rt_rq · RT', rule: '우선순위 · FIFO/RR', cls: 'RT', policy: 'SCHED_FIFO', others: ['R1'] },
    fair: { title: 'cfs_rq · FAIR', rule: 'EEVDF', cls: 'FAIR', policy: 'SCHED_OTHER', others: ['F1', 'F2'] },
  };

  type State = { tMove: number; tHop: number; scan: number; scanOn: number; pick: number; dim: number[]; mark: number[] };
  type Layout = {
    view: [number, number];
    box: { x: number; y: number; w: number; h: number };
    lane: { x: number; w: number; h: number; centers: number[] };
    slot: { x: number; step: number; w: number };
    cpu: Point & { w: number; h: number };
    curve: (laneY: number) => [Point, Point, Point];
    pickLabel: Point & { anchor: 'start' | 'middle' | 'end' };
  };
  const layouts: Record<'wide' | 'narrow', Layout> = {
    wide: {
      view: [560, 330],
      box: { x: 8, y: 8, w: 392, h: 314 },
      lane: { x: 20, w: 368, h: 76, centers: [104, 190, 276] },
      slot: { x: 196, step: 64, w: 56 },
      cpu: { x: 486, y: 190, w: 112, h: 64 },
      curve: (y) => [{ x: 392, y }, { x: 410, y: (y + 190) / 2 }, { x: 426, y: 190 }],
      pickLabel: { x: 486, y: 244, anchor: 'middle' },
    },
    narrow: {
      view: [360, 452],
      box: { x: 8, y: 8, w: 344, h: 314 },
      lane: { x: 16, w: 304, h: 76, centers: [104, 190, 276] },
      slot: { x: 160, step: 52, w: 46 },
      cpu: { x: 160, y: 398, w: 140, h: 60 },
      curve: (y) => [{ x: 322, y }, { x: 352, y: 380 }, { x: 234, y: 398 }],
      pickLabel: { x: 160, y: 444, anchor: 'middle' },
    },
  };

  document.querySelectorAll<HTMLElement>('[data-blog-demo="runqueue-policy-motion"]').forEach((demo) => {
    const stage = demo.querySelector<HTMLElement>('[data-stage]')!;
    const root = demo.querySelector<SVGSVGElement>('[data-graphic]')!;
    const note = demo.querySelector<HTMLElement>('[data-note]')!;
    const policyButtons = [...demo.querySelectorAll<HTMLButtonElement>('[data-policy]')];
    const pickButton = demo.querySelector<HTMLButtonElement>('[data-pick]')!;
    let layout = layouts.wide;
    let policy: Policy = 'fair';
    let from: Point = { x: 0, y: 0 };
    let to: Point = { x: 0, y: 0 };

    const box = createBoundary(root, 'CPU0의 rq · 다음 대상은 DL → RT → FAIR 순으로 확인');
    const lanes = ORDER.map((key) => {
      const rect = svg('rect', { class: 'scene-boundary', rx: 12 }, root);
      const title = svg('text', { class: 'scene-caption' }, root);
      const rule = svg('text', { class: 'scene-label scene-label-dep' }, root);
      const empty = svg('text', { class: 'scene-label' }, root);
      const mark = svg('text', { class: 'scene-label', 'text-anchor': 'end' }, root);
      title.textContent = LANES[key].title;
      rule.textContent = LANES[key].rule;
      empty.textContent = '실행 가능한 스레드 없음';
      empty.style.fill = 'var(--muted)';
      const others = LANES[key].others.map((label) => createNode(root, { label, hue: 'var(--scene-hue-gray)' }));
      return { key, rect, title, rule, empty, mark, others };
    });
    const scanner = svg('rect', { rx: 14, fill: 'none', stroke: 'var(--scene-flow)', 'stroke-width': 2.5 }, root);
    const cpu = createNode(root, { label: 'CPU0', hue: 'var(--scene-hue-gray)' });
    const pickCurve = createCurve(root, '');
    const pickLabel = svg('text', { class: 'scene-label scene-label-flow' }, root);
    const thread = createNode(root, { label: 'T', hue: 'var(--scene-hue-cyan)' });
    const rider = svg('g', {}, root);
    const riderCard = svg('rect', { rx: 5, height: 17, fill: 'var(--surface)', stroke: 'var(--scene-hue-blue)', 'stroke-width': 1.5 }, rider);
    const riderText = svg('text', { class: 'scene-label', 'text-anchor': 'middle', y: 12 }, rider);
    riderText.textContent = 'VT A';
    riderText.style.fill = 'var(--scene-hue-blue)';
    const rings = svg('g', {}, root);

    const laneY = (key: Policy) => layout.lane.centers[ORDER.indexOf(key)];
    const slotOf = (key: Policy): Point => ({ x: layout.slot.x + LANES[key].others.length * layout.slot.step, y: laneY(key) });
    const tAt = (s: State) => bowAt(from, to, s.tMove, hopLift(s.tHop, 30));
    const idle = (): State => ({ tMove: 1, tHop: 0, scan: 0, scanOn: 0, pick: 0, dim: [0, 0, 0], mark: [0, 0, 0] });

    const scene = createScene<State>(idle(), (s) => {
      const { lane, slot } = layout;
      lanes.forEach(({ key, rect, title, rule, empty, mark, others }, index) => {
        const y = lane.centers[index];
        const fade = String(1 - 0.55 * s.dim[index]);
        setAttrs(rect, { x: lane.x, y: y - lane.h / 2, width: lane.w, height: lane.h });
        rect.style.opacity = fade;
        setAttrs(title, { x: lane.x + 14, y: y - 4 });
        setAttrs(rule, { x: lane.x + 14, y: y + 15 });
        title.style.opacity = fade;
        rule.style.opacity = fade;
        const hasThread = others.length > 0 || policy === key;
        setAttrs(empty, { x: slot.x - slot.w / 2, y: y + 4 });
        empty.style.opacity = hasThread ? '0' : fade;
        others.forEach((node, i) => node.setBox({ x: slot.x + i * slot.step, y, w: slot.w, h: 40 }));
        setAttrs(mark, { x: lane.x + lane.w - 10, y: y + lane.h / 2 - 7, opacity: s.mark[index] });
      });
      const scanY = lane.centers[0] + (lane.centers[2] - lane.centers[0]) * (s.scan / 2);
      setAttrs(scanner, { x: lane.x - 4, y: scanY - lane.h / 2 - 4, width: lane.w + 8, height: lane.h + 8, opacity: s.scanOn });
      const t = tAt(s);
      thread.setBox({ ...t, w: slot.w, h: 40 });
      setAttrs(riderCard, { x: -23, width: 46 });
      setAttrs(rider, { transform: `translate(${t.x.toFixed(2)} ${(t.y - 32).toFixed(2)})` });
      cpu.setBox(layout.cpu);
      const [a, c, b] = layout.curve(scanY);
      pickCurve.draw(a, c, b, Math.max(0.001, s.pick), { ...b, anchor: 'start' });
      setAttrs(pickLabel, { x: layout.pickLabel.x, y: layout.pickLabel.y, 'text-anchor': layout.pickLabel.anchor, opacity: Math.min(1, s.pick * 2 - 1) });
    });

    const say = (html: string, alert = false) => {
      note.innerHTML = html;
      note.classList.toggle('is-alert', alert);
    };
    const markText = (index: number, value: string, tone: 'flow' | 'muted') => {
      const { mark } = lanes[index];
      mark.textContent = value;
      mark.style.fill = tone === 'flow' ? 'var(--scene-flow-ink)' : 'var(--slate)';
    };

    const choose = async (next: Policy) => {
      const alive = scene.begin();
      const moved = next !== policy;
      from = tAt(scene.state);
      policy = next;
      to = slotOf(next);
      policyButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.policy === next)));
      cpu.setSub('');
      say(moved
        ? `T를 <strong>${LANES[next].policy}</strong>로 바꾸자 T가 <strong>${LANES[next].title.split(' ')[0]}</strong>로 옮겨졌습니다. 세 큐에 복제되지 않고 한 곳에만 있습니다. VT A는 T에 실린 채 함께 옮겨졌을 뿐, 따로 큐에 들어가지 않습니다.`
        : `T는 이미 ${LANES[next].policy}입니다. 이제 <strong>다음 실행 대상 고르기</strong>를 눌러 보세요.`);
      scene.set({ ...scene.state, tMove: 0, tHop: 0 });
      // 지난 선택의 흔적은 제자리에서 흐려지게 둡니다(scan은 그대로).
      if (!(await scene.go({ ...idle(), scan: scene.state.scan, tMove: 1, tHop: 1 }, moved ? duration.fly : 0)) || !alive() || !moved) return;
      landRing(rings, { ...to, w: layout.slot.w, h: 40 });
    };

    const pick = async () => {
      const alive = scene.begin();
      cpu.setSub('');
      say('CPU0이 <strong>DL → RT → FAIR</strong> 순서로 실행 가능한 스레드가 있는 클래스를 찾습니다…');
      const s = scene.state;
      let state: State = { ...s, tMove: 1, tHop: Math.round(s.tHop), scan: 0, scanOn: 0, pick: 0, dim: [0, 0, 0], mark: [0, 0, 0] };
      scene.set(state);
      state = { ...state, scanOn: 1 };
      for (let index = 0; index < ORDER.length; index += 1) {
        const key = ORDER[index];
        state = { ...state, scan: index };
        if (!(await scene.go(state, index === 0 ? duration.snap : duration.move)) || !alive()) return;
        await scene.pause(duration.beat);
        if (!alive()) return;
        const empty = LANES[key].others.length === 0 && policy !== key;
        markText(index, empty ? '비어 있음 → 다음' : '✓ 이 클래스에서 선택', empty ? 'muted' : 'flow');
        state = { ...state, mark: state.mark.map((v, i) => (i === index ? 1 : v)), dim: state.dim.map((v, i) => (i === index && empty ? 1 : v)) };
        if (!(await scene.go(state, duration.snap)) || !alive()) return;
        if (empty) continue;

        const cls = LANES[key].cls;
        pickLabel.textContent = `${cls} 규칙으로 선택`;
        if (!(await scene.go({ ...state, pick: 1 }, duration.draw)) || !alive()) return;
        cpu.setSub(`${cls} 차례`);
        cpu.flash('is-ok');
        landRing(rings, { ...layout.cpu });
        if (key === 'dl') say('DL 큐에 T가 있으므로 RT·FAIR를 보기 전에 <strong>DL 클래스</strong>에서 고릅니다. 지금 실행 가능한 DL 스레드는 T 하나뿐입니다.');
        else if (key === 'rt' && policy === 'rt') say('DL이 비어 있어 <strong>RT 클래스</strong>에서 고릅니다. R1과 T가 같은 RT 클래스에 있으므로, 둘 중 누구를 실행할지는 RT의 우선순위·FIFO/RR 규칙이 정합니다.');
        else say('DL이 비어 있어 RT를 보니 R1이 있습니다. CPU0은 <strong>RT 클래스</strong>에서 고르고, FAIR에 있는 T는 이번 선택에서 RT보다 뒤입니다. EEVDF는 FAIR 안에서만 쓰이는 규칙입니다.', policy === 'fair');
        return;
      }
    };

    policyButtons.forEach((button) => button.addEventListener('click', () => { void choose(button.dataset.policy as Policy); }));
    pickButton.addEventListener('click', () => { void pick(); });

    watchNarrow(stage, (narrow) => {
      layout = layouts[narrow ? 'narrow' : 'wide'];
      setAttrs(root, { viewBox: `0 0 ${layout.view[0]} ${layout.view[1]}` });
      box.caption.textContent = narrow ? 'CPU0의 rq · DL → RT → FAIR 순' : 'CPU0의 rq · 다음 대상은 DL → RT → FAIR 순으로 확인';
      box.place(layout.box, { x: layout.box.x + 14, y: layout.box.y + 26 });
      from = to = slotOf(policy);
      scene.redraw();
    });
    say('OS 스레드 T는 지금 <strong>SCHED_OTHER</strong>라서 FAIR 클래스의 cfs_rq에 있고, 위에는 VT A가 실려 있습니다. 고르기를 누르기 전에 CPU0이 어느 큐에서 고를지 예상해 보세요.');
  });
</script>
