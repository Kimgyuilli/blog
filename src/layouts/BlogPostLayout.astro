---
import BaseLayout from './BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import {
  formatDate,
  getCategoryMeta,
  getCategoryUrl,
  getPublishedPosts,
  getRelatedPosts,
} from '@/utils/blog';
import type { BlogPost } from '@/utils/blog';

type Props = {
  post: BlogPost;
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
};

const { post, headings } = Astro.props;
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const category = getCategoryMeta(post.data.category);
const allPosts = await getPublishedPosts();
const relatedPosts = getRelatedPosts(post, allPosts, 3);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image}>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar"></div>
  </div>
  <article class="article-doc">
    <div class="article-main">
      <header class="article-header">
        <div class="meta">
          <a class="category-badge" href={getCategoryUrl(category.slug)}>{category.label}</a>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span>태그 {post.data.tags.length}개</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <ul class="tag-list" aria-label="태그">
          {
            post.data.tags.map((tag) => (
              <li>
                <a class="tag" href={`/blog/tag/${tag}/`}>
                  #{tag}
                </a>
              </li>
            ))
          }
        </ul>
      </header>
      <div class="article-body">
        <slot />
      </div>
      {
        relatedPosts.length > 0 && (
          <section class="related-posts" aria-label="다음 읽을거리">
            <h2 class="related-posts-title">다음 읽을거리</h2>
            <ul class="related-posts-list">
              {relatedPosts.map((related) => (
                <PostCard post={related} headingLevel={3} variant="list" showTags={false} />
              ))}
            </ul>
          </section>
        )
      }
    </div>
    <aside class="toc" aria-label="목차">
      <p class="toc-title">목차</p>
      {
        tocItems.length > 0 ? (
          <ol>
            {tocItems.map((heading) => (
              <li class={`toc-depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="toc-empty">소제목이 있는 글에서 목차가 표시됩니다.</p>
        )
      }
    </aside>
  </article>
  <div class="lightbox" role="dialog" aria-modal="true" aria-label="이미지 확대" hidden>
    <button class="lightbox-close" type="button" aria-label="닫기">×</button>
    <img class="lightbox-image" alt="" />
  </div>
</BaseLayout>
