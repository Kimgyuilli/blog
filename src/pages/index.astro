---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPublishedPosts } from '@/utils/blog';

const posts = await getPublishedPosts();
const featured = posts.slice(0, 6);
const rest = posts.slice(6);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Developer Blog</p>
    <h1>읽기 쉽고 오래 남는 개발 기록</h1>
    <p class="lead">
      문제 해결 과정, 배포 경험, 코드 설계 판단을 Markdown으로 정리하는 빠른 정적 블로그입니다.
    </p>
  </section>

  {
    featured.length > 0 && (
      <section class="home-section">
        <h2 class="section-title">최근 글</h2>
        <ul class="post-grid">
          {featured.map((post) => (
            <PostCard post={post} headingLevel={3} variant="grid" />
          ))}
        </ul>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="home-section">
        <h2 class="section-title">전체 글</h2>
        <ul class="post-list">
          {rest.map((post) => (
            <PostCard post={post} headingLevel={3} />
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
