---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPostUrl, getPublishedPosts } from '@/utils/blog';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Developer Blog</p>
    <h1>읽기 쉽고 오래 남는 개발 기록</h1>
    <p class="lead">
      문제 해결 과정, 배포 경험, 코드 설계 판단을 Markdown으로 정리하는 빠른 정적 블로그입니다.
    </p>
  </section>

  <section class="section-heading">
    <h2>최근 글</h2>
    <a href="/blog/">전체 보기</a>
  </section>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-card">
          <div class="meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </div>
          <h3>
            <a href={getPostUrl(post)}>{post.data.title}</a>
          </h3>
          <p>{post.data.description}</p>
          <ul class="tag-list" aria-label={`${post.data.title} 태그`}>
            {post.data.tags.map((tag) => (
              <li>
                <a class="tag" href={`/blog/tag/${tag}/`}>
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</BaseLayout>
