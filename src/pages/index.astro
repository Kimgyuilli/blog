---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPublishedPosts } from '@/utils/blog';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Developer Blog</p>
    <h1>읽기 쉽고 오래 남는 개발 기록</h1>
    <p class="lead">
      문제 해결 과정, 배포 경험, 코드 설계 판단을 Markdown으로 정리하는 빠른 정적 블로그입니다.
    </p>
  </section>

  <section class="section-heading">
    <h2>최근 글</h2>
    <a href="/blog/">전체 보기</a>
  </section>

  <ul class="post-list">
    {
      posts.map((post) => (
        <PostCard post={post} headingLevel={3} />
      ))
    }
  </ul>
</BaseLayout>
