---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPostUrl, getPublishedPosts } from '@/utils/blog';

const posts = await getPublishedPosts();
const suggestions = posts
  .filter((post) => !post.data.pinned)
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지를 찾을 수 없습니다.">
  <section class="hero not-found-hero">
    <p class="eyebrow">404</p>
    <h1>이 글은 어딘가로 떠났습니다</h1>
    <p class="lead">
      주소가 바뀌었거나, 아직 적히지 않은 글일지도 모릅니다. 대신 이런 글은 어떠세요?
    </p>
    <p class="not-found-actions">
      <a href="/">홈으로 돌아가기</a>
      <span aria-hidden="true">·</span>
      <a href="/categories/">분류 보기</a>
    </p>
  </section>

  {
    suggestions.length > 0 && (
      <section class="home-section">
        <h2 class="section-title">읽어볼 만한 글</h2>
        <ul class="not-found-list">
          {suggestions.map((post) => (
            <li>
              <a href={getPostUrl(post)}>
                <span class="title">{post.data.title}</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </a>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
