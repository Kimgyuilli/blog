---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllTags, getPublishedPosts } from '@/utils/blog';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="태그" description="개발 노트의 글 태그 목록입니다.">
  <section class="hero">
    <p class="eyebrow">Tags</p>
    <h1>태그</h1>
    <p class="lead">주제별로 글을 찾아볼 수 있습니다.</p>
  </section>

  <ul class="tag-list" aria-label="전체 태그">
    {
      tags.map((tag) => (
        <li>
          <a class="tag" href={`/blog/tag/${tag}/`}>
            #{tag}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
