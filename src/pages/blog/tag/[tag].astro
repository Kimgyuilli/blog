---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getAllTags, getPostsByTag, getPublishedPosts } from '@/utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return getAllTags(posts).map((tag) => ({
    params: { tag },
    props: { posts: getPostsByTag(posts, tag), tag },
  }));
}

const { posts, tag } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`#${tag} 태그가 달린 글 목록입니다.`}>
  <section class="hero">
    <p class="eyebrow">Tag</p>
    <h1>#{tag}</h1>
    <p class="lead">{posts.length}개의 글이 있습니다.</p>
  </section>

  <ul class="post-list">
    {
      posts.map((post) => (
        <PostCard post={post} showTags={false} />
      ))
    }
  </ul>
</BaseLayout>
