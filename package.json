{
  "name": "astro-developer-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "rm -rf node_modules/.astro && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "deploy": "npm run build && wrangler deploy",
    "migrate:tistory": "node scripts/migrate-tistory.mjs",
    "sync:post-images": "node scripts/sync-post-images.mjs",
    "sync:portfolio": "node scripts/sync-portfolio.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "check:skills": "node scripts/sync-skills.mjs --check",
    "lint:post": "node scripts/lint-post.mjs",
    "publish:post": "node scripts/publish-post.mjs",
    "guard:rewrite": "node scripts/rewrite-guard.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.3",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.6",
    "motion": "^13.4.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "cheerio": "^1.2.0",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.93.1"
  },
  "overrides": {
    "vite": "^7"
  }
}
